// I HATE SHIT POPFILE FORMATTING - Kai

#base       robot_standard.pop
#base       robot_giant.pop

WaveSchedule
{
	StartingCurrency 800
	RespawnWaveTime 2
	CanBotsAttackWhileInSpawnRoom No

	FlagEscortCountOffset -2

	WaveStartCountdown 5
	TextPrintTime 0
	UseOriginalAnimsForUnintendedClassWeapons 1
	SniperAllowHeadshots 1

	//// PRECACHES ////

	// Precached Sounds //

	// Music

	PrecacheSound "impasse/the_asparagus_beyond_the_obscure.wav"
	PrecacheSound "impasse/t-error_on_the_dance_floor.wav"

	//// LUA SCRIPTS ////

	LuaScriptFile "scripts/impasse_mechanic.lua"
	LuaScriptFile "scripts/snurperweapons.lua"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// PLAYER WEAPONS ////
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`music_system_ment`)
						PrecacheSound(`#impasse/the_asparagus_beyond_the_obscure.wav`)
						PrecacheSound(`#impasse/t-error_on_the_dance_floor.wav`)

						MusicSystemMent.ResetAll()
						MusicSystemMent.HookByName(`bignet`)
						
						IncludeScript(`tankextensions_main`)
					  "
			}
		}
	}

	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"

	//// EXTRA TANK PATHS ////

	//// EXTRA SPAWN POINTS ////
	
	//// ROBOT TEMPLATES ////

	Templates
	{
		//// MINIBOSSES ////
		T_TFBot_Spy_SVChiefMarksmann
		{
			Name "SV-Chief [MARKSMANN]"
			Class Spy
			ClassIcon spy_ambassador_deadly
			Skill Hard
			Health 10000
			Scale 1.2
			Attributes UseBossHealthBar
			Attributes HoldFireUntilFullReload
			WeaponRestrictions PrimaryOnly
			Action FetchFlag

			UseHumanAnimations 1
			AlwaysGlow 1
			NoBombUpgrades 1
			AimTrackingInterval 0.05
			AimAt Head

			Item "The Ambassador"
			Item "Night Vision Gawkers"
			Item "Tuxedo Royale"
			Item "Dustbowl Devil"

			CharacterAttributes
			{
				"move speed penalty" 0.75
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.3
				"cannot be sapped" 1
				"cannot disguise" 1
			}
			
			WeaponResist
			{
				"TF_WEAPON_KNIFE" 0.025
			}

			ItemAttributes
			{
				ItemName "The Ambassador"
				
				"fire rate bonus" 0.75
			}
		}

		T_TFBot_Giant_Soldier_Commander
		{
			Name "CAPTAIN [REDACTED]"
			Class Soldier
			ClassIcon soldier_commander
			Health 20000
			Skill Hard
			Attributes MiniBoss
			Attributes UseBossHealthBar
			Attributes HoldFireUntilFullReload
			WeaponRestrictions PrimaryOnly

			UseHumanAnimations 1

			SpawnTemplate "CommanderPT"

			Item "The Team Captain"
			Item "Fancy Dress Uniform"

			CharacterAttributes
			{
				"move speed penalty" 0.5
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.4
				"override footstep sound set" 3
			}
		}

		//// MINIGIANTS ////

		T_TFBot_Heavy_Armored
		{
			Name "Armored Heavy"
			Class Heavy
			ClassIcon heavy_armored
			Health 900
			Scale 1.5
		}

		//// COMMONS ////
		T_TFBot_Scout_Fast
		{
			Name "Not-so-Super Scout"
			Class Scout
			ClassIcon scout_fast
			Skill Easy
			Health 100
			WeaponRestrictions MeleeOnly

			Item "The Holy Mackerel"

			Item "The Bolt Boy"
		}

		T_TFBot_Scout_Milk
		{
			Name "Mad Milk Scout"
			Class Scout
			ClassIcon scout_milk
			Skill Expert
			Attributes AlwaysFireWeapon
			WeaponRestrictions SecondaryOnly

			Item "Mad Milk"

			ItemAttributes
			{
				ItemName "Mad Milk"

				"fire rate bonus" 0.8
				"effect bar recharge rate increased" 0.001
			}
		}
	}

	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_main
		BeginAtWave 1
		RunForThisManyWaves 6
		InitialCooldown 5
		CooldownTime 40

		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	//// WAVES ////

	Wave
	{
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_start_relay`, `Trigger`)
					MusicSystemMent.SetMusicTrack(`#impasse/the_asparagus_beyond_the_obscure.wav`)
				  "
		}
		DoneOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_finish_relay`, `Trigger`)
					MusicSystemMent.SetMusicTrack(``, 0.5, 0.5)
				  "
		}

		Explanation
        {
            Line    "{Green}Management : Glad to have you back, Team Fortress. Once again, we have another extraterrestrial scheme to dispatch of."
            Line    "{Green}Management : For unknown reasons, third-party anomalies keep localizing to this place. First were those aliens months ago and now this."
            Line    "{Green}Management : Whatever comes, you know the drill."
            Line    " "
            Line    "{RED}MVM MECHANIC NOTICE : WHENEVER THE BOMB ACTIVATES THE HATCH WARNING. BOTS GET TO PICK AND FLANK ON ANY ROUTE. STAY ALERT!"
        }

		CustomWaveNumber 1
		CustomMaxWaveNumber 5

		WaveSpawn // Support Engineers
		{
			Name "Wave1_Support_Engineers"
			Where spawnbot_right
			Support Limited
			TotalCount 3
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 60
			WaitBetweenSpawns 120

			TFBot
			{
				Template T_TFBot_Engineer_Sentry_Battle_TeleIn
			}
		}

		// Subwave 1
		WaveSpawn // 2 GFAN Scouts
		{
			Name "Wave1_Subwave1_GFANScouts"
