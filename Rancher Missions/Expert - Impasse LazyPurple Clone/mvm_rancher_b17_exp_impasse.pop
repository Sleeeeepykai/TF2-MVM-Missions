		//// GIANTS ////
		T_TFBot_Giant_Soldier_ChargeShots
		{
			Name "Giant Charged Mangler Soldier"
			Class Soldier
			ClassIcon soldier_charged_mangler_v2
			Skill Expert
			Health 3800
			Attributes MiniBoss
			Attributes HoldFireUntilFullReload
