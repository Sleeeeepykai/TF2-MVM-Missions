// I HATE SHIT POPFILE FORMATTING - Kai

#base       robot_standard.pop
#base       robot_giant.pop

WaveSchedule
{
	StartingCurrency 800
	RespawnWaveTime 2
	CanBotsAttackWhileInSpawnRoom No

	FlagEscortCountOffset -2

	WaveStartCountdown 5
	TextPrintTime 0
	UseOriginalAnimsForUnintendedClassWeapons 1
	SniperAllowHeadshots 1

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/bots/boss_bot/ubertank/boss_tank_uber.mdl"
	PrecacheModel "models/bots/boss_bot/ubertank/tank_uber_track_l.mdl"
	PrecacheModel "models/bots/boss_bot/ubertank/tank_uber_track_r.mdl"
	PrecacheModel "models/bots/boss_bot/ubertank/bomb_mechanism_uber.mdl"

	PrecacheModel "models/props_mvm/indicator/indicator_circle_long.mdl"

	// Precached Sounds //

	// Music

	PrecacheSound "impasse/the_asparagus_beyond_the_obscure.wav"
	PrecacheSound "impasse/t-error_on_the_dance_floor.wav"
	PrecacheSound "impasse/sky_fall_trigger.wav"
	PrecacheSound "impasse/hard_struck.wav"
	PrecacheSound "impasse/yet_here_we_are_at_an_impasse.wav"

	PrecacheSound "impasse/encore_interlude.mp3"

	//// LUA SCRIPTS ////

	LuaScriptFile "scripts/impasse_mechanic.lua"
	LuaScriptFile "scripts/snurperweapons.lua"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// PLAYER WEAPONS ////
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`music_system_ment`)
						PrecacheSound(`#impasse/the_asparagus_beyond_the_obscure.wav`)
						PrecacheSound(`#impasse/t-error_on_the_dance_floor.wav`)
						PrecacheSound(`#impasse/sky_fall_trigger.wav`)
						PrecacheSound(`#impasse/hard_struck.wav`)
						PrecacheSound(`#impasse/yet_here_we_are_at_an_impasse.wav`)

						MusicSystemMent.ResetAll()
						MusicSystemMent.HookByName(`bignet`)
						
						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankextensions/ubertank`)
					  "
			}

			point_populator_interface
            {
                "targetname" "pop_interface"
            }

			logic_relay
			{
				"targetname" "EncoreFailRelay"

				"OnTrigger" "Wave5CompleteRelay,CancelPending,,2,-1"
			}
			logic_relay
			{
				"targetname" "Wave5CompleteRelay"

				"OnTrigger" "popscript,$encoreCheck,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave2_Engineers,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave2_Engineers,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave3_Pyros,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave3_Pyros,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave4_ArmoredBlackBoxes,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave4_ArmoredBlackBoxes,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave4_Heavies,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave4_Heavies,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave4_Scouts,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave4_Scouts,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave5_Subwave4_QuickUberMedics,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave5_Subwave4_QuickUberMedics,0,-1"

				"OnTrigger" "tf_gamerules,PlayVO,#impasse/encore_interlude.mp3,5,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}Management of the Void {reset}: Highest Priority Set - Team Fortress,5,-1"
			}

			filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "red_team_filter"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "red_team_filter"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		//// ROBOT PTs ////

		RobotUberGenPT
		{
			OnSpawnOutput
			{
				Target "UberGenWarningAnnotation1"
				Action Show
				Delay 1.5
			}
			OnSpawnOutput
			{
				Target "UberGenWarningAnnotation2"
				Action Show
				Delay 5
			}
			OnParentKilledOutput
			{
				Target tankboss_harvester
				Action CallScriptFunction
				Param "ToggleUber"
			}

			training_annotation
			{
				"targetname" "UberGenWarningAnnotation1"
				"display_text" "Target has arrived!"
				"lifetime" "3.5"
			}
			training_annotation
			{
				"targetname" "UberGenWarningAnnotation2"
				"display_text" "Defeat the target to drop the Tank's Uber!"
				"lifetime" "3.5"
			}
		}

		VoidOppressionistPT
		{
			KeepAlive 1

			RemoveIfKilled "VoidOppressionistTeleportTarget"

			logic_case
			{
				"targetname" "VoidOppressionistAttackCase"

				"OnCase01" "!activator,$ChangeAttributes,VoidOppressionistAirstrike,0,-1"
				"OnCase02" "!activator,$ChangeAttributes,VoidOppressionistSummon,0,-1"
			}
			logic_relay
			{
				"targetname" "VoidOppressionistSummonRelay"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_specialcompleted04.mp3,1.8,-1"
				"OnTrigger" "VoidOppressionistTeleport,Enable,,3.2,-1"
				"OnTrigger" "VoidOppressionistPush,Enable,,3.2,-1"
				"OnTrigger" "VoidOppressionistTeleport,Disble,,3.42,-1"
				"OnTrigger" "VoidOppressionistPush,Disable,,3.72,-1"
			}

			trigger_teleport
			{
				"targetname" "VoidOppressionistTeleport"
				"filtername" "SupportBotFilter"
				"origin" "0 0 0"
				"mins" "-6000 -6000 -900"
				"maxs" "6000 6000 900"
				"target" "VoidOppressionistTeleportTarget"
				"spawnflags" "1"
				"startdisabled" "1"

				"OnStartTouch" "!activator,$AddCond,32 4,0,-1"
				"OnStartTouch" "!activator,$AddCond,71 0.5,0,-1"
			}
			info_target
			{
				"targetname" "VoidOppressionistTeleportTarget"
				"origin" "50 0 60"
			}
			point_push
			{
				"targetname" "VoidOppressionistPush"
				"filtername" "SupportBotFilter"
				"origin" "-50 0 100"
				"magnitude" "500"
				"radius" "00"
				"spawnflags" "8"
				"startdisabled" "1"
			}
			filter_tf_bot_has_tag
			{
				"targetname" "SupportBotFilter"
				"tags" "SupportBot"
			}

			logic_relay
			{
				"targetname" "VoidOppressionistDeathRelay"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_laughlong01.mp3,0,-1"
				"OnTrigger" "Player,$DisplayTextChat,{FFC0CB}The Void Oppressionist Laughs,0,-1"
				"OnTrigger" "VoidOppressionistTeleport,Kill,,0,-1"
				"OnTrigger" "VoidOppressionistPush,Kill,,0,-1"
				"OnTrigger" "!activator,$Suicide,,4,-1"
				"OnTrigger" "VoidOppressionistExplosionDamage,Enable,,4,-1"
				"OnTrigger" "VoidOppressionistExplosionDamage,Disable,,4,-1"
				"OnTrigger" "VoidOppressionistExplosionParticle,Start,,4,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 5, 8, 2, 50000, 0, true)4-1"
				"OnTrigger" "VoidOppressionistExplosionParticle,Stop,,4.9,-1"
				"OnTrigger" "VoidOppressionistTeleportTarget,Kill,,5,-1"
			}
			trigger_hurt
			{
				"targetname" "VoidOppressionistExplosionDamage"
				"filtername" "filter_redteam_nouber"
				"origin" "0 0 0"
				"mins" "-270 -270 -120"
				"maxs" "270 270 120"
				"damage" "100"
				"damagetype" "64"
				"spawnflags" "1"
				"startdisabled" "1"
			}
			info_particle_system
			{
				"targetname" "VoidOppressionistExplosionParticle"
				"origin" "0 0 90"
				"effect_name" "cinefx_goldrush"
			}
		}
		VoidOpportunitstPT
		{
			OnSpawnOutput
			{
				Target "VoidOpportunistStickyWeapon"
				Action "$SetOwner"
				Param "!activator"
			}

			logic_case
			{
				"targetname" "VoidOpportunistAttackCase"

				"OnCase01" "!activator,$ChangeAttributes,VoidOpportunistMinigun,0,-1"
				"OnCase02" "!activator,$ChangeAttributes,VoidOpportunistStickies,0,-1"
			}

			logic_relay
			{
				"targetname" "VoidOpportunistStickiesRelay"

				"OnTrigger" "VoidOpportunistStickyWeapon,$StartFiring,,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/heavy_mvm_award09.mp3,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/sentrybuster/mvm_sentrybuster_spin.wav,2,-1"
				"OnTrigger" "VoidOpportunistStickyIndicator,Enable,,2,-1"
				"OnTrigger" "VoidOpportunistStickyIndicator,SetAnimation,Start,,2,-1"
				"OnTrigger" "VoidOpportunistStickyWeapon,$StopFiring,,3,-1"
				"OnTrigger" "VoidOpportunistStickyWeapon,DetonateStickies,,4,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/explosions/explode_2.wav,4,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/sentrybuster/mvm_sentrybuster_explode.wav,4,-1"
			}

			tf_point_weapon_mimic
			{
				"targetname" "VoidOpportunistStickyWeapon"
				"origin" "0 0 110"
				"angles" "90 0 0"
				"teamnum" "3"
				"$firetime" "1"
				"$weaponname" "VoidOpportunistStickyLauncher"
			}
			prop_dynamic
			{
				"targetname" "VoidOpportunistStickyIndicator"
				"origin" "0 0 0"
				"model" "models/props_mvm/indicator/indicator_circle_long.mdl"
				"modelscale" "5"
				"defaultanim" "start"
				"skin" "1"
				"solid" "0"
				
				"disablebonefollowers" "1"
				"disableshadows" "1"
				"startdisabled" "1"
			}
		}
	}

	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"

	//// EXTRA TANK PATHS ////

	//// EXTRA SPAWN POINTS ////
	
	//// ROBOT TEMPLATES ////

	Templates
	{
		//// MINIBOSSES ////
		T_TFBot_Spy_SVChiefMarksmann
		{
			Name "SV-Chief [MARKSMANN]"
			Class Spy
			ClassIcon spy_ambassador_deadly
			Skill Hard
			Health 10000
			Scale 1.2
			Attributes UseBossHealthBar
			Attributes HoldFireUntilFullReload
			WeaponRestrictions PrimaryOnly
			Action FetchFlag

			UseHumanAnimations 1
			AlwaysGlow 1
			NoBombUpgrades 1
			AimTrackingInterval 0.05
			AimAt Head

			Item "The Ambassador"
			Item "Night Vision Gawkers"
			Item "Tuxedo Royale"
			Item "Dustbowl Devil"

			CharacterAttributes
			{
				"move speed penalty" 0.75
				"damage force reduction" 0.4
				"airblast vulnerability multiplier" 0.3
				"cannot be sapped" 1
				"cannot disguise" 1
			}
			
