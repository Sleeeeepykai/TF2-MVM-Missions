	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_front_mission_sentrybuster [$SIGSEGV]
		Where spawnbot_gatea_mission_sentrybuster [$SIGSEGV]
		Where spawnbot_gateb_mission_sentrybuster [$SIGSEGV]
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	//// WAVES ////
	Wave
	{
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)

					EntFire(`tf_gamerules`, `$StopVO`, `ambient/rain.wav`)
					EntFire(`tf_gamerules`, `$PlayVO`, `ambient/rain.wav`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // Support Scouts
		{
			Name "Subwave1_ScoutRunner"
			Where spawnbot_front_main [$SIGSEGV]
			Where spawnbot_gatea_main [$SIGSEGV]
			Where spawnbot_gateb_main [$SIGSEGV]
			Support 1
			TotalCount 50
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 5
			WaitBetweenSpawns 0
			TotalCurrency 100

