#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 2400
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

    BodyPartScaleSpeed 10

	CustomNavFile "mvm_blazehattan_v2.nav"

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)

				SetSkyboxTexture(`sky_well_01`)
				EntFire(`fog_controller`, `SetColor`, `130 134 172`)
				EntFire(`fog_controller`, `SetStartDist`, `100`)
				EntFire(`fog_controller`, `SetEndDist`, `8500`)
			  "
		Delay -1
	}

	//// PRECACHES ////
	
	// Precached Colour Correction

	PrecacheGeneric "materials/colorcorrection/stormlight.raw"

	//// CUSTOM WEAPONS ////

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Grandmaster) War Without Reason`)
						
                        Convars.SetValue(`tf_playergib`, 0)

						IncludeScript(`tankextensions_main`)

						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/combattank_weapons/rocketpod`)
					  "
			}
		}

		MissionPT
		{
			OnSpawnOutput
			{
				Target MissionSetupRelay
				Action Trigger
			}

			logic_relay
			{
				"targetname" "MissionSetupRelay"

				"OnTrigger" "spawnbot_front_main,$SetLocalAngles,0 270 0,0,-1"

				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_front_main:Disable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_front_upper:Disable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_front_mission_sentrybuster:Disable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_front_mission_sniper:Disable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_front_mission_spy:Disable::0:-1,0,-1"

				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gatea_main:Disable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gatea_mission_sentrybuster:Disable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gatea_mission_sniper:Disable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gatea_mission_spy:Disable::0:-1,0,-1"

				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gateb_main:Enable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gateb_upper:Enable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gateb_mission_sentrybuster:Enable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gateb_mission_sniper:Enable::0:-1,0,-1"
				"OnTrigger" "wave_finished_reset_spawns,AddOutput,OnTrigger spawnbot_gateb_mission_spy:Enable::0:-1,0,-1"

				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_front_main:Disable::0:-1,0,-1"
				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_front_upper:Disable::0:-1,0,-1"
				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_front_mission_sentrybuster:Disable::0:-1,0,-1"
				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_front_mission_sniper:Disable::0:-1,0,-1"
				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_front_mission_spy:Disable::0:-1,0,-1"

				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_gatea_main:Enable::0:-1,0,-1"
				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_gatea_mission_sentrybuster:Enable::0:-1,0,-1"
				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_gatea_mission_sniper:Enable::0:-1,0,-1"
				"OnTrigger" "gate1_relay,AddOutput,OnTrigger spawnbot_gatea_mission_spy:Enable::0:-1,0,-1"

				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gatea_main:Disable::0:-1,0,-1"
				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gatea_mission_sentrybuster:Disable::0:-1,0,-1"
				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gatea_mission_sniper:Disable::0:-1,0,-1"
				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gatea_mission_spy:Disable::0:-1,0,-1"

				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gateb_main:Enable::0:-1,0,-1"
				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gateb_upper:Enable::0:-1,0,-1"
				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gateb_mission_sentrybuster:Enable::0:-1,0,-1"
				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gateb_mission_sniper:Enable::0:-1,0,-1"
				"OnTrigger" "gate2_relay,AddOutput,OnTrigger spawnbot_gateb_mission_spy:Enable::0:-1,0,-1"
			}
		}

