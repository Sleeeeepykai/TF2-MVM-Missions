        MapDecorationPT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						EntFire(`StormSkybox`, `ActivateSkybox`)
						SetSkyboxTexture(`sky_day02_09`)
						EntFire(`fog_controller`, `SetColor`, `80 80 80`)
						EntFire(`fog_controller`, `SetStartDist`, `100`)
						EntFire(`fog_controller`, `SetEndDist`, `5000`)

						EntFire(`StormSoundRelay`, `Trigger`)

						EntFire(`env_soundscape*`, `Disable`)

						EntFire(`subway_car_relay`, `Kill`)
					  "
			}

			logic_relay
			{
				"targetname" "StormSoundRelay"

				"OnTrigger" "tf_gamerules,$StopVO,ambient/rain.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/rain.wav,0.1,-1"
			}

			// Skybox

			sky_camera
            {
                "targetname" "StormSkybox"
                "origin" "-8304 24 -309"
                "angles" "0 0 0"
                "scale" "16"

                "fogenable" "1"
                "fogstart" "100"
                "fogend" "15000"
                "fogmaxdensity" "1"
                "fogcolor" "80 80 80"
                "fogblend" "0"
                "fogdir" "1 0 0"
                "fogRadial" "1"
            }

			// Colour Correction

			color_correction
            {
                "targetname" "StormCC"

				"filename" "materials/colorcorrection/stormlight.raw"
                "maxweight" "0.5"

                "minfalloff" "-1"
                "maxfalloff" "-1"
                "fadeInDuration" "0"
                "fadeOutDuration" "0"
            }

			// Searchlights

			point_spotlight
			{
				"origin" "-8769 313 -309"
