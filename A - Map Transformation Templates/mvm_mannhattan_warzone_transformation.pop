			}

			// Randomised Thunder

			logic_timer
			{
				"targetname" "ThunderTimer"

				"UseRandomTime" "1"
                "LowerRandomBound" "20"
                "UpperRandomBound" "30"

				"OnTimer" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 25, 0.6, 0.1, 1)0-1"
				"OnTimer" "ThunderSoundCase,PickRandomShuffle,,0,-1"
			}

			logic_case
			{
				"targetname" "ThunderSoundCase"

				"OnCase01" "tf_gamerules,PlayVO,ambient/thunder4.wav,1,-1"
                "OnCase02" "tf_gamerules,PlayVO,ambient/thunder3.wav,1,-1"
