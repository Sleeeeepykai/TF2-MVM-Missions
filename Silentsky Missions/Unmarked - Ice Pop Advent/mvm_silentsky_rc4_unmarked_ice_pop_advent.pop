	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"

	//// ROBOT TEMPLATES ////

    Templates
    {
        T_TFBot_Boss_Demoman_THEHAMMERREQUIEM
		{
			Name "THE HAMMER - REQUIEM"
			Class Demoman
			ClassIcon mallet_lite
			Skill Expert
			Health 75000
			Scale 2.5
			Attributes MiniBoss
            Attributes UseBossHealthBar
			Attributes AlwaysCrit
			WeaponRestrictions MeleeOnly

            UseCustomModel "models/bots/demo_boss/bot_demo_gray_boss.mdl"
            UseHumanAnimations 0

			SpawnTemplate "HammerRequiemPT"

            Tag HammerRequiem

			Item "HammerRequiemHammer" [$SIGSEGV]

            Item "HammerRequiemHood" [$SIGSEGV]
            Item "HammerRequiemCape" [$SIGSEGV]
			Item "The Shaman's Skull"
			Item "Forgotten King's Pauldrons"
            Item "The Sole Saviors"

			CharacterAttributes
			{
				"move speed penalty" 0.5
                "cancel falling damage" 1
				"damage force reduction" 0.5
				"airblast vulnerability multiplier" 0.5
				"override footstep sound set" 4
			}

            ChangeAttributes
            {
                Name "HammerRequiemIntro"
                Delay 0
                Repeats 1
            }

            EventChangeAttributes
            {
                HammerRequiemIntro [$SIGSEGV]
                {
                    UseHumanAnimations 1

                    CharacterAttributes
                    {
                        "move speed penalty" 0.001
                        "hand scale" 1
                        "no_attack" 1
                        "no_jump" 1
                    }
                    FireInput
                    {
                        Target !activator
                        Action $SetLocalOrigin
                        Param "-5824 -832 232"
                        Delay 0
                        Repeats 1
                    }
                    ChangeAttributes
                    {
                        Name "HammerRequiemDefault"
                    }
                }

                HammerRequiemDefault [$SIGSEGV]
                {
                    WeaponRestrictions MeleeOnly

                    UseHumanAnimations 0

                    Item "HammerRequiemDefaultHammer" [$SIGSEGV]

                    CharacterAttributes
                    {
                        "move speed penalty" 0.5
                        "hand scale" 1
                        "no_attack" 0
                        "no_jump" 0
                    }

                    FireInput
                    {
                        Target "HammerRequiemAttackInit"
                        Action Trigger
                        Delay 5
                        Repeats 1
                    }
                }

                // Phase 1 Attacks //

                HammerRequiemSlam [$SIGSEGV]
                {
                    WeaponRestrictions MeleeOnly

                    UseHumanAnimations 0

                    Item "HammerRequiemBigHammer" [$SIGSEGV]

                    CharacterAttributes
                    {
                        "move speed penalty" 0.25
                        "hand scale" 3.5
                        "no_attack" 1
                        "no_jump" 1
                    }

                    FireInput
                    {
                        Target "HammerRequiemBigSlamAttack"
                        Action Trigger
                        Delay 0
                        Repeats 1
                    }

                    FireWeapon
                    {
                        Type "Primary"
                        Delay 3
                        Repeats 1
                    }
                }

                // Phase 2 Attacks (He's bringing in the snow) //

                HammerRequiemIceRain [$SIGSEGV]
                {
                    WeaponRestrictions MeleeOnly

                    UseHumanAnimations 1

                    Item "HammerRequiemDefaultHammer" [$SIGSEGV]

                    CharacterAttributes
                    {
                        "move speed penalty" 0.5
                        "hand scale" 1
                        "no_attack" 0
                        "no_jump" 0
                    }

                    FireInput
                    {
                        Target "HammerRequiemIceRainAttack"
                        Action Trigger
                        Delay 0
                        Repeats 1
                    }
                }
                HammerRequiemIceStalactite [$SIGSEGV]
                {
                    WeaponRestrictions MeleeOnly

                    UseHumanAnimations 1

                    Item "HammerRequiemDefaultHammer" [$SIGSEGV]

                    CharacterAttributes
                    {
                        "move speed penalty" 0.5
                        "hand scale" 1
                        "no_attack" 0
                        "no_jump" 0
                    }

                    FireInput
                    {
                        Target "HammerRequiemIceStalactiteAttack"
                        Action Trigger
                        Delay 0
                        Repeats 1
                    }
                }
            }
		}
