#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 1000
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

    BodyPartScaleSpeed 10

	//// PRECACHES ////

    // Precached Models //

    PrecacheModel "models/props_mvm/indicator/indicator_circle.mdl"

    PrecacheModel "models/bots/demo_boss/bot_demo_gray_boss.mdl"

    PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun.mdl"
    PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun_fireball.mdl"
    PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun_ice_shard.mdl"
    PrecacheModel "models/weapons/c_models/c_cryo_gun/c_pyro_cryo_gun_animations.mdl"

    //// DISABLED SOUNDS ////

    DisableSound "Announcer.MVM_Tank_Alert_Multiple"
    DisableSound "Announcer.MVM_Tank_Alert_Halfway_Multiple"

	//// CUSTOM WEAPONS ////

    CustomWeapon
	{
        //// POINT-TEMPLATE WEAPONS ////

        // The Hammer Requiem //

        "HammerRequiemNormalSlam"
        {
            OriginalItemName "TF_WEAPON_PIPEBOMBLAUNCHER"
            "blast radius increased" 1.5

            "add damage type" 128
            "remove damage type" 64
            "no damage falloff" 1

            "custom projectile model" "models/empty.mdl"
			"custom kill icon" "necro_smasher"
        }

		"HammerRequiemBigSlam"
        {
            OriginalItemName "TF_WEAPON_PIPEBOMBLAUNCHER"
			"damage bonus" 10
			"blast radius increased" 2.5
			"use large smoke explosion" 1

			"custom projectile model" "models/empty.mdl"
			"custom kill icon" "necro_smasher"
        }

        "HammerRequiemIceRainWeapon"
        {
            OriginalItemName "TF_WEAPON_ROCKETLAUNCHER"

            "add damage type" 2050
            "remove damage type" 64
            "slow enemy on hit" 1
            "set turn to ice" 1

            "projectile speed decreased" 0.9
			"projectile spread angle penalty" 3
            "mult projectile scale" 1.8
            "ignores other projectiles" 1

            "custom projectile model" "models/weapons/c_models/c_cryo_gun/c_cryo_gun_ice_shard.mdl"
            "projectile trail particle" "flare_glow"
            "explosion particle" "snow_steppuff01"

            "custom weapon fire sound" "=15|MVM.GiantSoldierRocketShootCrit"
            "custom impact sound" "weapons\icicle_melt_01.wav"
            "custom kill icon" "taunt_scout"
        }

        //// ROBOT WEAPONS ////

        "HammerRequiemDefaultHammer"
        {
            OriginalItemName "The Scotsman's Skullcutter"
            "fire rate penalty" 1.5
            "melee range multiplier" 0.0001

            "custom item model" "models/weapons/c_models/c_big_mallet/c_big_mallet.mdl"
            "custom kill icon" "necro_smasher"
            "fire input on attack" "HammerNormalSlamRelay^Trigger"
        }
        "HammerRequiemBigHammer"
        {
            OriginalItemName "The Scotsman's Skullcutter"
            "melee range multiplier" 0.0001

            "custom item model" "models/weapons/c_models/c_big_mallet/c_big_mallet.mdl"
            "custom kill icon" "necro_smasher"
        }

        //// ROBOT COSMETICS ////

        "HammerRequiemHood"
        {
            OriginalItemName "Potato of Labor"

            "custom item model" "models\workshop\player\items\all_class\hw2013_ethereal_hood\hw2013_ethereal_hood_demo.mdl"
        }
        "HammerRequiemCape"
        {
            OriginalItemName "Glitched Circuit Board"

            "custom item model" "models/workshop/player/items/demo/sum26_bomb_blanket/sum26_bomb_blanket.mdl"
        }
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
                        EntFire(`routes`, `Kill`)

						IncludeScript(`tankextensions_main`)
					  "
			}

            logic_relay
            {
                "targetname" "wave_init_left_relay"

                "OnTrigger" "route1Holos,Enable,,0,-1"
                "OnTrigger" "route1,Enable,,0,-1"
                "OnTrigger" "route2,Disable,,0,-1"
            }
            logic_relay
            {
                "targetname" "wave_init_right_relay"

                "OnTrigger" "route2Holos,Enable,,0,-1"
                "OnTrigger" "route2,Enable,,0,-1"
                "OnTrigger" "route1,Disable,,0,-1"
            }

			logic_relay
			{
				"targetname" "TankCleanupRelay"

				"OnTrigger" "tank_boss*,RemoveHealth,100000,0,-1"
			}

			// Universal Filters
            filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_red"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_red_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_red"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

        //// ROBOT PTs ////

        HammerRequiemPT
		{
            NoFixUp 1
            OnSpawnOutput
            {
                Target HammerRequiemSetup
                Action Trigger
            }

            logic_relay
            {
                "targetname" "HammerRequiemSetup"

                "OnTrigger" "HammerRequiemTarget,SetParent,!activator,0,-1"
                "OnTrigger" "HammerNormalSlamDamage,$SetOwner,!activator,0,-1"
                "OnTrigger" "HammerBigSlamDamage,$SetOwner,!activator,0,-1"
            }

            info_target
            {
                "targetname" "HammerRequiemTarget"
            }

            filter_tf_bot_has_tag
            {
                "targetname" "HammerRequiemFilter"
                "tags" "HammerRequiem"
            }

            // Attack Pattern Logic //

            logic_relay
            {
                "targetname" "HammerRequiemAttackInit"

                "OnTrigger" "HammerRequiemPhase1AttackPoolRelay,Trigger,,0,-1"
                "OnTrigger" "HammerRequiemPhase2AttackPoolRelay,Trigger,,0,-1"
                "OnTrigger" "HammerRequiemPhase3AttackPoolRelay,Trigger,,0,-1"
            }

            // Phase 1
            logic_relay
            {
                "targetname" "HammerRequiemPhase1AttackPoolRelay"
                "spawnflags" "2"

                "OnTrigger" "HammerRequiemPhase1AttackPool,PickRandomShuffle,,0,-1"
            }
            logic_case
            {
                "targetname" "HammerRequiemPhase1AttackPool"
            }

            // Phase 2
            logic_relay
            {
                "targetname" "HammerRequiemPhase2AttackPoolRelay"
                "spawnflags" "2"
                "startdisabled" "1"

                "OnTrigger" "HammerRequiemPhase2AttackPool,PickRandomShuffle,,0,-1"
            }
            logic_case
            {
                "targetname" "HammerRequiemPhase2AttackPool"
            }

            // Phase 3
            logic_relay
            {
                "targetname" "HammerRequiemPhase3AttackPoolRelay"
                "spawnflags" "2"
                "startdisabled" "1"

                "OnTrigger" "HammerRequiemPhase3AttackPool,PickRandomShuffle,,0,-1"
            }
            logic_case
            {
                "targetname" "HammerRequiemPhase3AttackPool"
            }

            // Phase 1 Attacks //

            // Hammer Default Slam
            logic_relay
            {
                "targetname" "HammerNormalSlamRelay"

                "OnTrigger" "HammerNormalSlamParticle,Stop,,0,-1"
                "OnTrigger" "HammerNormalSlamDamage,FireOnce,,0,-1"
                "OnTrigger" "HammerNormalSlamParticle,Start,,0.1,-1"
                "OnTrigger" "tf_gamerules,PlayVO,misc/halloween/strongman_fast_impact_01.wav,0.1,-1"
                "OnTrigger" "tf_gamerules,PlayVO,ambient/explosions/explode_4.wav,0.1,-1"
                "OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 5, 8, 1, 50000, 0, true)0.1-1"
            }
            tf_point_weapon_mimic
            {
                "targetname" "HammerNormalSlamDamage"
                "origin" "200 0 15"
                "teamnum" "3"
                "$weaponname" "HammerRequiemNormalSlam"
                "$weaponnosound" "1"

                "$OnFire" "!self,DetonateStickies,,0.1,-1"
            }
            info_particle_system
            {
                "targetname" "HammerNormalSlamParticle"
                "origin" "200 0 15"
                "effect_name" "hammer_impact_button_dust"
            }
            info_particle_system
            {
                "targetname" "HammerNormalSlamParticle"
                "origin" "200 0 15"
                "effect_name" "hammer_impact_button_dust2"
            }

            // Hammer Big Slam
            logic_relay
            {
                "targetname" "HammerRequiemBigSlamAttack"

				"OnTrigger" "HammerBigSlamIndicator,Enable,,0,-1"
				"OnTrigger" "HammerBigSlamIndicator,SetAnimation,start,0,-1"
                "OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_deploy_giant.wav,0,-1"
                "OnTrigger" "tf_gamerules,$StopVO,mvm/mvm_deploy_giant.wav,1.65,-1"
				"OnTrigger" "tf_gamerules,PlayVO,weapons/demo_sword_swing1.wav,3.0,-1"
                "OnTrigger" "tf_gamerules,PlayVO,ambient/explosions/explode_2.wav,3.4,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/halloween/strongman_fast_impact_01.wav,3.4,-1"
				"OnTrigger" "HammerBigSlamIndicator,Disable,,3.4,-1"

				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 40, 16, 2, 50000, 0, true)3.4-1"
                "OnTrigger" "HammerBigSlamDamage,FireOnce,,3.4,-1"
				"OnTrigger" "HammerBigSlamFling,ApplyImpulse,,3.4,-1"
            }

            prop_dynamic
            {
                "targetname" "HammerBigSlamIndicator"
                "origin" "600 0 40"
                "model" "models/props_mvm/indicator/indicator_circle.mdl"
                "modelscale" "8"
                "defaultanim" "start"
                "skin" "1"
                "solid" "0"

                "disablebonefollowers" "1"
                "disableshadows" "1"
                "startdisabled" "1"
            }
            tf_point_weapon_mimic
            {
                "targetname" "HammerBigSlamDamage"
                "origin" "600 0 20"
                "teamnum" "3"
                "$weaponname" "HammerRequiemBigSlam"
                "$weaponnosound" "1"

                "$OnFire" "!self,DetonateStickies,,0,-1"
            }
            trigger_apply_impulse 
            {
                "targetname" "HammerBigSlamFling"
                "origin" "600 0 20"
                "maxs" "375 375 40"
                "mins" "-375 -375 -40"
                
                "force" "750"
                "impulse_dir" "262 10 0"
                "spawnflags" "1"
            }

            // Phase 2 Attacks //

            // Ice Rain
            logic_relay
            {
                "targetname" "HammerRequiemIceRainAttack"

                "OnTrigger" "!activator,$TauntFromItem,Taunt: Roar O'War,0,-1"
                "OnTrigger" "HammerRequiemIceRainHazardPT,ForceSpawnAtEntityOrigin,!activator,4,-1"
                "OnTrigger" "HammerRequiemAttackInit,Trigger,,15,-1"
            }

            // Ice Stalactite
            logic_relay
            {
                "targetname" "HammerRequiemIceStalactiteAttack"

                "OnTrigger" "!activator,$TauntFromItem,Taunt: Yeti Smash,0,-1"
                "OnTrigger" "!activatorRunScriptCodeforeach(player in CzUtil.GetClosestPlayersToBot(activator,6))EntFireByHandle(`HammerRequiemIceStalactitePT`, `ForceSpawnAtEntityOrigin`, player, null, null)0-1"
                "OnTrigger" "!activator,$RemoveCond,7,5,-1"
                "OnTrigger" "HammerRequiemAttackInit,Trigger,,5,-1"
            }
		}

        HammerRequiemIceRainHazardPT
        {
            RemoveIfKilled "IceRainTimer"
            
            OnSpawnOutput
            {
                Target IceRainCentre
                Action $SetKey$angles
                Param "0 0 0"
            }
            OnSpawnOutput
            {
                Target IceRainTimer
                Action Kill
                Delay 10
            }

            trigger_once
			{
                "filtername" "HammerRequiemFilter"
				"mins" "-60 -60 -60"
				"maxs" "60 60 60"
				"spawnflags" "1"

				"OnTrigger" "IceRainCentre,$SetFakeParent,!activator,0,-1"
			}

            logic_timer
			{
				"targetname" "IceRainTimer"
				"RefireTime" "0.2"

				"OnTimer" "IceRainLocationCase,PickRandomShuffle,,0,-1"
			}
			logic_case
			{
				"targetname" "IceRainLocationCase"
				
				"OnCase01" "IceRainLocationRow1,PickRandomShuffle,,0,-1"
				"OnCase02" "IceRainLocationRow2,PickRandomShuffle,,0,-1"
				"OnCase03" "IceRainLocationRow3,PickRandomShuffle,,0,-1"
				"OnCase04" "IceRainLocationRow4,PickRandomShuffle,,0,-1"
				"OnCase05" "IceRainLocationRow5,PickRandomShuffle,,0,-1"
			}
            logic_case
            {
                "targetname" "IceRainLocationRow1"

                "OnCase01" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation1,0,-1"
				"OnCase02" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation2,0,-1"
				"OnCase03" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation3,0,-1"
				"OnCase04" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation4,0,-1"
				"OnCase05" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation5,0,-1"
            }
            logic_case
            {
                "targetname" "IceRainLocationRow2"

                "OnCase01" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation6,0,-1"
				"OnCase02" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation7,0,-1"
				"OnCase03" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation8,0,-1"
				"OnCase04" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation9,0,-1"
				"OnCase05" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation10,0,-1"
            }
            logic_case
            {
                "targetname" "IceRainLocationRow3"

                "OnCase01" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation11,0,-1"
				"OnCase02" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation12,0,-1"
				"OnCase03" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation13,0,-1"
				"OnCase04" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation14,0,-1"
				"OnCase05" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation15,0,-1"
            }
            logic_case
            {
                "targetname" "IceRainLocationRow4"

                "OnCase01" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation16,0,-1"
				"OnCase02" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation17,0,-1"
				"OnCase03" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation18,0,-1"
				"OnCase04" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation19,0,-1"
				"OnCase05" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation20,0,-1"
            }
            logic_case
            {
                "targetname" "IceRainLocationRow5"

                "OnCase01" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation21,0,-1"
				"OnCase02" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation22,0,-1"
				"OnCase03" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation23,0,-1"
				"OnCase04" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation24,0,-1"
				"OnCase05" "HammerRequiemIceRainPT,ForceSpawnAtEntityOrigin,IceRainLocation25,0,-1"
            }

            info_target
            {
                "targetname" "IceRainCentre"
                "origin" "0 0 0"
                "$modules" "fakeparent"
                "$positiononly" "1"
            }

            info_target
            {
                "targetname" "IceRainLocation1"
                "parentname" "IceRainCentre"
                "origin" "320 768 1400"
            }
            info_target
            {
                "targetname" "IceRainLocation2"
                "parentname" "IceRainCentre"
                "origin" "320 384 1400"
            }
            info_target
            {
