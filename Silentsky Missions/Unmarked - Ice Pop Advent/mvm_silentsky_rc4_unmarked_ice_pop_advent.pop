        HammerRequiemIceRainPT
		{
			RemoveIfKilled "HammerRequiemIceRain"
			
            OnSpawnOutput
            {
                Target "HammerRequiemIceRain"
                Action "$SetOwner"
                Param @p@HammerRequiemTarget
            }
			OnSpawnOutput
			{
				Target HammerRequiemIceRain
				Action FireOnce
				Delay 0.2
			}
			OnSpawnOutput
			{
				Target HammerRequiemIceRain
				Action Kill
				Delay 0.3
			}

			tf_point_weapon_mimic
			{
				"targetname" "HammerRequiemIceRain"
				"angles" "45 -90 0"
				"teamnum" "3"
				"$weaponname" "HammerRequiemIceRainWeapon"
                "$preventshootparent" "1"
			}
		}

        HammerRequiemIceStalactitePT
        {
            RemoveIfKilled "HammerRequiemIceStalactiteProp"

            OnSpawnOutput
            {
                Target "HammerRequiemIceStalactiteRelay"
                Action Trigger
            }

            prop_dynamic
            {
                "targetname" "HammerRequiemIceStalactiteIndicator"
                "origin" "0 0 20"
                "model" "models/props_mvm/indicator/indicator_circle.mdl"
                "modelscale" "2"
                "defaultanim" "start"
                
                "disablebonefollowers" "1"
                "disableshadows" "1"
            }
            prop_dynamic
            {
                "targetname" "HammerRequiemIceStalactiteWarning"
                "origin" "0 0 -60"
