#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 0
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Sounds //

	PrecacheSound "bazooks/giant_heavy_gunwindup_brassbeast.wav"
	PrecacheSound "bazooks/giant_heavy_gunwinddown_brassbeast.wav"
	PrecacheSound "bazooks/giant_heavy_gunspin_brassbeast.wav"
	PrecacheSound "bazooks/giant_heavy_gunfire_brassbeast.wav"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		"HomewreckerRangedWeapon"
		{
			OriginalItemName "The Rescue Ranger"
			"damage bonus" 1.5
			"no damage falloff" 1
			"add damage type" 128
			"remove damage type" 2

			"fire rate penalty" 2
			"faster reload rate" 0.001

			"penetrate teammates" 1
			"projectile penetration" 1
			"projectile speed decreased" 0.65
			"projectile gravity" 750
			"arrow hit kill time" 0.1

			"custom item model" "models/weapons/c_models/c_sledgehammer/c_sledgehammer.mdl"
			"custom projectile model" "models/weapons/w_models/w_drg_ball.mdl"
			"custom weapon fire sound" "common/null.wav"
			"custom kill icon" "sledgehammer"
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						PrecacheSound(`misc/halloween/strongman_fast_impact_01.wav`)

                        Convars.SetValue(`tf_playergib`, 0)

						EntFire(`saucer`, `Kill`)
						EntFire(`saucer_sound`, `Kill`)

						IncludeScript(`tankextensions_main`)

						IncludeScript(`tankextensions/blimp`)
						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/combattank_weapons/cannon`)
						IncludeScript(`tankextensions/combattank_weapons/rocketpod`)
						IncludeScript(`tankextensions/combattank_weapons/minigun`)
						IncludeScript(`tankextensions/combattank_weapons/fireball`)
						IncludeScript(`tankextensions/combattank_weapons/railgun`)
						IncludeScript(`tankextensions/helicopter`)
						IncludeScript(`tankextensions/teletank`)
						IncludeScript(`tankextensions/ubertank`)
					  "
			}

			// Universal Filters
            filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		MissionPT
		{

			logic_relay
			{
				"targetname" "TankMoveRelay"

				"OnTrigger" "tank_boss*,SetSpeed,25,0,-1"
				"OnTrigger" "tank_boss*,SetSpeed,50,1.5,-1"
				"OnTrigger" "tank_boss*,SetSpeed,75,3,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tank_horn.wav`);EmitSoundEx({sound_name=`mvm/mvm_tank_horn.wav`,pitch = 85,filter_type=5})0-1"
			}
			logic_relay
			{
				"targetname" "TankCleanupRelay"

				"OnTrigger" "tank_boss*,RemoveHealth,100000,0,-1"
			}
		}

		//// ROBOT PTs ////

		RotatingHomewreckerPT
        {
			KeepAlive 1

			RemoveIfKilled "HomewreckerProjectile"

            OnSpawnOutput
            {
                Target "!activator"
                Action "AddOutput"
                Param "rendermode 10"
                Delay 0.01
            }
			OnParentKilledOutput
			{
				Target "HomewreckerRotator"
				Action Stop
			}
			OnParentKilledOutput
			{
				Target "HomewreckerShake"
				Action StartShake
			}
			OnParentKilledOutput
			{
				Target "HomewreckerProjectile"
				Action RunScriptCode
				Param "ScreenShake(self.GetOrigin(), 10, 10, 2, 800, 0, true)"
			}
			OnParentKilledOutput
			{
				Target "HomewreckerProjectile"
				Action RunScriptCode
				Param "EmitSoundEx({sound_name = `misc/halloween/strongman_fast_impact_01.wav`, channel = 6, sound_level = 100, entity = self})"
			}
			OnParentKilledOutput
			{
				Target "HomewreckerProjectile"
				Action Kill
				Delay 3
			}

            prop_dynamic
            {
                "targetname" "HomewreckerProjectile"
                "parentname" "HomewreckerRotator"
				"origin" "-10 0 -50"
                "model" "models/weapons/c_models/c_sledgehammer/c_sledgehammer.mdl"
				"modelscale" "1.5"
            }
            func_rotating
            {
                "targetname" "HomewreckerRotator"
                "spawnflags" "73"
                "maxspeed" "500"
            }
        }
	}

	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"
	SpawnTemplate "MissionPT"

	PlayerShootTemplate
	{
		Name "RotatingHomewreckerPT"
		AttachToProjectile 1
		ItemName "HomewreckerRangedWeapon"
	}

