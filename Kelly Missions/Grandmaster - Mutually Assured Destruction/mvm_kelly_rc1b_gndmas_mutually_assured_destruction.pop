			TotalCurrency 100

			FirstSpawnWarningSound "vo/mvm/mght/heavy_mvm_m_specialweapon01.mp3"

			TFBot
			{
				Name "THE Bitch Haver"
				Template T_TFBot_Giant_Heavy_SteelFist
				Health 45000
				Scale 2
				Attributes UseBossHealthBar
				Attributes AlwaysCrit

				SpawnTemplate "BitchHaverPT"

				CharacterAttributes
				{
					"damage force reduction" 0.01
					"airblast vulnerability multiplier" 0.01
					"airblast vertical vulnerability multiplier" 0.01
					"head scale" 1.5
					"hand scale" 2
				}

				ItemAttributes
				{
					ItemName "Fists of Steel"

					"damage bonus" 1.5
					"melee range multiplier" 2
