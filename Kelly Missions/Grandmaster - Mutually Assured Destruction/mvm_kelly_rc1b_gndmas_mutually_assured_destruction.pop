	//// WAVES ////

	Wave
	{
		InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
					EntFire(`bombpath_clearall_relay`, `Trigger`, null, 6)
					EntFire(`bombpath_arrows_clear_relay`, `Trigger`, null, 6)
					EntFire(`bombpath_left_relay`, `Trigger`, null, 6.1)
            	  "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 1 GBrassBeast Heavy and 2 GCharged Medics
		{
			Name "Wave1_Subwave1_GBrassBeastHeavy"
			Where spawnbot
			TotalCount 3
			MaxActive 3
			SpawnCount 3
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 200

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Heavy_BrassBeast

					CharacterAttributes
					{
						"damage force reduction" 0.01
						"airblast vulnerability multiplier" 0.01
						"airblast vertical vulnerability multiplier" 0.01
					}
				}
				TFBot
				{
					Template T_TFBot_Giant_Medic_Charged

					CharacterAttributes
					{
						"damage force reduction" 0.01
						"airblast vulnerability multiplier" 0.01
						"airblast vertical vulnerability multiplier" 0.01
					}
				}
				TFBot
				{
					Template T_TFBot_Giant_Medic_Charged

					CharacterAttributes
					{
						"damage force reduction" 0.01
						"airblast vulnerability multiplier" 0.01
						"airblast vertical vulnerability multiplier" 0.01
					}
				}
			}
		}
		WaveSpawn // 6 Armor League Scouts
		{
			Name "Wave1_Subwave1_ArmoredSandmanScouts"
			WaitForAllSpawned "Wave1_Subwave1_GBrassBeastHeavy"
			Where spawnbot
			TotalCount 6
			MaxActive 6
			SpawnCount 3
			WaitBeforeStarting 4
			WaitBetweenSpawns 10
			TotalCurrency 20

			TFBot
			{
				Template T_TFBot_Scout_Sandman_Armored

				CharacterAttributes
				{
					"damage force reduction" 0.01
					"airblast vulnerability multiplier" 0.01
					"airblast vertical vulnerability multiplier" 0.01
				}
			}
		}
		WaveSpawn // 15 Loch Demos
		{
			Name "Wave1_Subwave1_LochDemos"
			WaitForAllSpawned "Wave1_Subwave1_GBrassBeastHeavy"
			Where spawnbot_left
			Where spawnbot_right
			TotalCount 15
			MaxActive 9
			SpawnCount 3
			WaitBeforeStarting 4
			WaitBetweenSpawns 3
