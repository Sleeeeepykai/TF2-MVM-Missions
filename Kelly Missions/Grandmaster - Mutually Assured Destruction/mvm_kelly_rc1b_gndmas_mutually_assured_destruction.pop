			TFBot
			{
				Template T_TFBot_Demoman_LochnLoad
				Skill Expert

				AimAt Head
			}
		}

		WaveSpawn // 3 GBarrage Soldiers
		{
			Name "Wave1_Subwave1_GBarrageSoldier"
			WaitForAllDead "Wave1_Subwave1_GBrassBeastHeavy"
			Where spawnbot
			TotalCount 3
			MaxActive 3
			SpawnCount 1
			WaitBeforeStarting 5
			WaitBetweenSpawns 16
			TotalCurrency 40

			RandomChoice
			{
				Shuffle 1 [$SIGSEGV]

				TFBot
				{
					Template T_TFBot_Giant_Soldier_Barrage

					CharacterAttributes
					{
						"damage force reduction" 0.01
						"airblast vulnerability multiplier" 0.01
						"airblast vertical vulnerability multiplier" 0.01
					}
