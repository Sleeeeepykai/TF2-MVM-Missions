					"airblast vertical vulnerability multiplier" 0.01
				}

				ChangeAttributes
				{
					Name "LookingAtHim"
					Delay 0
					Repeats 1
				}

				EventChangeAttributes
				{
					LookingAtHim [$SIGSEGV]
					{
						InterruptAction
						{
							Target "BitchHaverTarget"
							AimTarget "BitchHaverTarget"
							Delay 0.5
							Repeats 0
							Duration 25
							Cooldown 0.3
							Distance 100
						}
					}
					NotLookingAtHim [$SIGSEGV]
					{
						WeaponRestrictions MeleeOnly

						ActionOverride Mobber

						Item "The Ubersaw"

						CharacterAttributes
						{
							"move speed bonus" 3
						}
					}
				}
			}
		}

