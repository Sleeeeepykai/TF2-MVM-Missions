        T_TFBot_Miniboss_Engineer_Widowmaker
        {
            Name "Widowmaker Maniac"
            Class Engineer
            ClassIcon engineer_widowmaker_spammer_hyper_nys_giant
            Skill Expert
            Health 30000
            Scale 2
            Attributes MiniBoss
            Attributes UseBossHealthBar
            WeaponRestrictions PrimaryOnly

            CustomEyeGlowColor "255 0 0"

