    //// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 6
		InitialCooldown 25
		CooldownTime 25
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
    Mission // Sniper (Wave 1) (Kai)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 10
		CooldownTime 35
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper_Anti_Materiel
		}
	}
    Mission // Spy (Wave 3) (Kai)
    {
        Objective Spy
        Where spawnbot_mission_spy
        BeginAtWave 3
        RunForThisManyWaves 1
        InitialCooldown 30
        CooldownTime 30
        DesiredCount 3

        TFBot
        {
            Template T_TFBot_Spy
        }
    }
    Mission // Sniper (Wave 6) (Mike)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 6
		RunForThisManyWaves 1
		InitialCooldown 8
		CooldownTime 15
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Sniper_Explosive_Supercharged
		}
	}

    //// WAVES ////

    Wave
    {
        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`bombpath_force_right`, `Trigger`)
                  "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

        // Subwave 1
        WaveSpawn // 4 GRapid Burst Soldiers (Arlecchino)
        {
            Name "Wave1_Subwave1_GRapidBurstSoldier"
            Where spawnbot
            TotalCount 4
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 0
            WaitBetweenSpawns 16
            TotalCurrency 100

            TFBot
            {
                Template T_TFBot_Giant_Soldier_Burst_Spammer
            }
        }
        WaveSpawn // 16 Pyros and 16 Kritz Medics (Mike & Package)
        {
            Name "Wave1_Subwave1_Pyros"
            Where spawnbot
            TotalCount 32
            MaxActive 18
            SpawnCount 6
            WaitBeforeStarting 2
            WaitBetweenSpawns 8
            TotalCurrency 60

            Squad
            {
                TFBot
                {
                    Class Pyro
                    Skill Normal

                    ItemAttributes
                    {
                        ItemName "TF_WEAPON_FLAMETHROWER"

                        "airblast disabled" 1
                    }
                }
                TFBot
                {
                    Template T_TFBot_Medic_Kritzkrieg
                }
            }
        }

        // Subwave 2
        WaveSpawn // 1 Tank (Kai)
        {
            Name "Wave1_Subwave2_Tank"
            WaitForAllSpawned "Wave1_Subwave1_GRapidBurstSoldier"
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 15
            WaitBetweenSpawns 0
            TotalCurrency 100

            Tank
            {
                Name "tankboss"
                Health 32000
                Speed 75
                StartingPathTrackNode "boss_path_same"

                OnBombDroppedOutput
                {
                    Target boss_deploy_relay
                    Action Trigger
                }
            }
        }
        WaveSpawn // 3 GSunstick Scouts (Package)
        {
            Name "Wave1_Subwave2_GSunstickScouts"
            WaitForAllSpawned "Wave1_Subwave2_Tank"
            Where spawnbot
            TotalCount 3
            MaxActive 3
            SpawnCount 1
            WaitBeforeStarting 2
            WaitBetweenSpawns 2
            TotalCurrency 20

            TFBot
            {
                Template T_TFBot_Scout_Sunstick_Supercharged
            }
        }
        WaveSpawn // 12 Supercharged Scouts (Waffle, they're my version of Public Enemies)
        {
            Name "Wave1_Subwave2_Scouts"
            WaitForAllSpawned "Wave1_Subwave2_Tank"
            Where spawnbot
            TotalCount 12
            MaxActive 5
            SpawnCount 2
            WaitBeforeStarting 2
            WaitBetweenSpawns 3
            TotalCurrency 40

            TFBot
            {
                Template T_TFBot_Scout_Blaster_Supercharged
            }
        }
        WaveSpawn // 20 Rapid Scouts (Datlad, had to take a bit of liberty here)
        {
            Name "Wave1_Subwave2_Scouts"
            WaitForAllSpawned "Wave1_Subwave2_GSunstickScouts"
