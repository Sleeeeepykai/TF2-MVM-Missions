            LastSpawnWarningSound "mvm/giant_heavy/giant_heavy_entrance.wav"

            Squad
            {
                NoWaitForFormation 1 [$SIGSEGV]

                TFBot
                {
                    Template T_TFBot_Miniboss_Scout_Rocket
                }
                TFBot
                {
                    Template T_TFBot_Soldier_Extended_Battalion_Spammer
