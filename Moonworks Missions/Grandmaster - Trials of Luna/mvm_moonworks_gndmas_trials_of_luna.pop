            FOV 346

            Item "The Widowmaker"

            CharacterAttributes
			{
				"move speed penalty" 0.5
                "damage force reduction" 0
				"airblast vulnerability multiplier" 0
                "airblast vertical vulnerability multiplier" 0
                "mult stun resistance" 0
                "rage giving scale" 0.5
				"override footstep sound set" 7
				"voice pitch scale" 0
				"head scale" 0.7
				"hand scale" 1.1
			}

            ItemAttributes
            {
                ItemName "The Widowmaker"

                "damage bonus" 1.25
                "fire rate bonus" 0.6
            }
        }

        T_TFBot_Miniboss_Heavy_Hyperion
        {
            Name "Experiment 'Hyperion'"
            Class Heavy
            ClassIcon heavy_head_nys_giant
            Skill Expert
            Health 45000
            Scale 2
            Attributes MiniBoss
            Attributes UseBossHealthBar
            WeaponRestrictions PrimaryOnly

            CustomEyeGlowColor "255 0 0"

            MaxVisionRange 1200

            UseMeleeThreatPrioritization 1
            FOV 346

            SpawnTemplate "HyperionPT"

            Item "Upgradeable TF_WEAPON_MINIGUN"

            Item "BackpackRocket1" [$SIGSEGV]
            Item "BackpackRocket2" [$SIGSEGV]

            ChangeAttributes
            {
                Name "OppressorPhase"
                Delay 0
                Repeats 1
            }
            FireInput
            {
                Target !activator
                Action $ChangeAttributes
                Param "IncineratorPhase"
                Delay 0
                Repeats 1
                IfHealthBelow 20000
            }

            CharacterAttributes
            {
                "move speed penalty" 0.4
				"damage force reduction" 0
				"airblast vulnerability multiplier" 0
                "airblast vertical vulnerability multiplier" 0
                "mult stun resistance" 0
                "rage giving scale" 0.5
                "override footstep sound set" 2
                "voice pitch scale" 0
            }

            EventChangeAttributes
            {
                OppressorPhase [$SIGSEGV]
                {
                    ItemAttributes
                    {
                        ItemName "Upgradeable TF_WEAPON_MINIGUN"

                        "damage bonus" 2

                        "fire rate penalty" 1.5

                        "item style override" 1
                    }

                    AddAttribute
                    {
                        Item "BackpackRocket1"
                        Name "attachment scale"
                        Value "2.35"
                        Delay 0.1
                        Repeats 1
                        Cooldown -1
                    }
                    AddAttribute
                    {
                        Item "BackpackRocket2"
                        Name "attachment scale"
                        Value "2.35"
                        Delay 0.1
                        Repeats 1
                        Cooldown -1
                    }

                    FireInput
					{
						Target "RocketBarrageRelay"
						Action "Trigger"
						Delay 0
						Repeats 0
						Cooldown 5
						IfLeftSpawn 1
					}
                }
                IncineratorPhase [$SIGSEGV]
                {
                    Item "The Huo Long Heatmaker"

                    ExtAttr AlwaysFireWeaponAlt

                    FireInput
                    {
                        Target "HyperionAngryRelay"
                        Action Trigger
                        Delay 0
                        Repeats 1
                    }

                    ItemAttributes
                    {
                        ItemName "The Huo Long Heatmaker"

                        "damage bonus" 2
                        "damage penalty" 1
                        "ring of fire while aiming" 10
                    }

                    AddAttribute
                    {
                        Item "BackpackRocket1"
                        Name "attachment scale"
                        Value "2.35"
                        Delay 0.1
                        Repeats 1
                        Cooldown -1
                    }
                    AddAttribute
                    {
                        Item "BackpackRocket2"
                        Name "attachment scale"
                        Value "2.35"
                        Delay 0.1
                        Repeats 1
                        Cooldown -1
                    }

                    FireInput
                    {
                        Target FlareBarrageAttack*
                        Action $StartFiring
                        Delay 0
                        Cooldown 1
                        IfSeeTarget 1
                    }

                    FireInput
                    {
                        Target FlareBarrageAttack*
                        Action $StopFiring
                        Delay 2
                        Cooldown 1
                        IfNoTarget 1
                    }
                }
            }
        }

