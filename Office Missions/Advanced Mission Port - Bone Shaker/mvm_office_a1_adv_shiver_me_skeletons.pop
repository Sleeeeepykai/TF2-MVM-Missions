WaveSchedule
{
	StartingCurrency 1200
	RespawnWaveTime 2
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	//// ROBOT TEMPLATES ////

	Templates
	{
		T_TFBot_Giant_Soldier_Burst_Modded
		{
			Template T_TFBot_Giant_Soldier_Burst

			ItemAttributes
			{
				ItemName "TF_WEAPON_ROCKETLAUNCHER"
				"fire rate bonus" 0.2
				"faster reload rate" 0.4
				"clip size upgrade atomic" 5.0
				"projectile speed decreased" 0.9
			}
		}
	}

	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_mission_sentrybuster
		BeginAtWave 1
		RunForThisManyWaves 8
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 1
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	Mission // Spy (Wave 1)
	{
		Objective Spy  
		Where spawnbot_mission_spy
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 5
		CooldownTime 60
		DesiredCount 4

		TFBot
		{
			Template T_TFBot_Spy
		}
	}

	Mission // Sniper (Wave 2-3)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 2
		RunForThisManyWaves 2
		InitialCooldown 75
		CooldownTime 20
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}

	Mission // Spy (Wave 4)
	{
		Objective Spy  
		Where spawnbot_mission_spy
		BeginAtWave 4
		RunForThisManyWaves 1
		InitialCooldown 60
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}

	Mission // Sniper (Wave 5-6)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 5
		RunForThisManyWaves 2
		InitialCooldown 60
		CooldownTime 30
		DesiredCount 4

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}

	Mission // Spy (Wave 7)
	{
		Objective Spy  
		Where spawnbot_mission_spy
		BeginAtWave 7
		RunForThisManyWaves 1
		InitialCooldown 120
		CooldownTime 25
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
	
	Wave
	{
		InitWaveOutput
		{
			Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`bombpath_warehouse_relay`, `Trigger`)
                  "
		}
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 22 Heavies
		{
			Name "Wave1_Subwave1_Heavies"
			Where spawnbot_invasion
			TotalCount 22
			MaxActive 22
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0.1
			TotalCurrency 100		
		
			TFBot
			{
				Class Heavyweapons
				Skill Easy
			}
		}
		WaveSpawn // Support Demoknights
		{
			Name "wave01b"
			Where spawnbot
			Support 1
			TotalCount 50
			MaxActive 6
			SpawnCount 3
			WaitBeforeStarting 5
			WaitBetweenSpawns 15
			TotalCurrency 300
		
			TFBot
			{
				Template T_TFBot_Demoman_Knight
			}
		}

		WaveSpawn // 1 GConch Soldier and 3 Soldiers
		{
			Name "Wave1_Subwave1_GConchSoldier"
			WaitForAllSpawned "Wave1_Subwave1_Heavies"
			Where spawnbot
			TotalCount 4
			MaxActive 4
			SpawnCount 4
