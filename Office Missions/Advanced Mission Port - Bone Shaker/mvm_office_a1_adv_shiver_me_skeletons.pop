		InitialCooldown 20
		CooldownTime 20
		DesiredCount 6

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}	
	
	Wave
	{
		InitWaveOutput
		{
			Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`bombpath_random_choose_relay`, `Trigger`)
                  "
		}
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 22 Heavies
		{
			Name "Wave1_Subwave1_Heavies"
			Where spawnbot_invasion
			TotalCount 22
			MaxActive 22
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0.1
			TotalCurrency 100		
		
			TFBot
			{
				Class Heavyweapons
				Skill Easy
			}
		}
		WaveSpawn // Support Demoknights
		{
			Name "wave01b"
			Where spawnbot
			Support 1
			TotalCount 50
			MaxActive 6
			SpawnCount 3
			WaitBeforeStarting 5
			WaitBetweenSpawns 15
			TotalCurrency 300
		
			TFBot
			{
