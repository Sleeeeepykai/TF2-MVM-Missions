		InitialCooldown 5
		CooldownTime 20
		DesiredCount 10

		TFBot
		{
			Template T_TFBot_Spy
		}
	}	
	Mission // Sniper (Wave 8)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 8
