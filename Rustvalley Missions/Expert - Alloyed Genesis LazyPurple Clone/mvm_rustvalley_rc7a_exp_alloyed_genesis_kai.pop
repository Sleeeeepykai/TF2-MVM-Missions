// Rust Valley Expert - Alloyed Genesis by Sergeant Table: https://steamcommunity.com/id/FinalBossConnoisseur/
// Fucking massive popfile ahead, half of the things here are genuienly indecipherable!
// An attempt at a gimmick mission, probably my last mission for a good while
// --- SPECIAL THANKS ---
//   - Colonel: For the original miner engineer template and concepts for other miner variants
//   - Alche: Better positioning for the boss spawn texts
//   - SNTR: Overall map trouble shooting for Wave 3
//   - Sleeeepykai: Color Corrections across all the waves to simulate the passage of time
//                  Overall lore and story writing
//                  Help with the final boss
//                  Simply Rotund (Bossing it)
//   - Package o' Lies: Overall inspiration from his mission 0 in the way the lore is presented
//   - B855: Bustlet
//
#base robot_standard.pop
#base robot_giant.pop
#base robot_gatebot.pop
#base bustlet_base.pop

WaveSchedule
{
	StartingCurrency 1500
    CanBotsAttackWhileInSpawnRoom No
    RespawnWaveTime 4

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15

	WaveStartCountdown 7

	AllowBotExtraSlots 1
    RobotLimit 26

	BodyPartScaleSpeed 15

	TextPrintTime 0

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/weapons/c_models/c_biobreaker/c_biobreaker.mdl"
	PrecacheModel "models/weapons/w_models/w_atomball_blu.mdl"

	PrecacheModel "models/fog.mdl"

	// Precached Sounds //

	// SFX
	PrecacheSound "major_shocks_spin.mp3"

	// Music
	PrecacheSound "rustvalleynight.mp3"

	// Precached Particles //

	PrecacheParticle "moon_drill_dust"

	// Precached Colour-Corrections //

	PrecacheGeneric "materials/colorcorrection/rustvalleynight2.raw"

	//// DISABLED SOUNDS ////

	DisableSound "Announcer.MVM_Wave_End"
	DisableSound "Announcer.MVM_Get_To_Upgrade"
	DisableSound "Announcer.MVM_Final_Wave_End"
	DisableSound "music.mvm_end_last_wave"
	DisableSound "music.mvm_end_mid_wave"
	DisableSound "music.mvm_end_tank_wave"
	DisableSound "music.mvm_end_wave"
	DisableSound "music.mvm_lost_wave"
	DisableSound "music.mvm_start_last_wave"
	DisableSound "music.mvm_start_mid_wave"
	DisableSound "music.mvm_start_tank_wave"
	DisableSound "music.mvm_start_wave"

	//// LUA SCRIPTS ////

	LuaScriptFile "scripts/shockwave_shields.lua"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// MECHA MINER ////

		"MechaMinerRockWeapon"
		{
			OriginalItemName "TF_WEAPON_ROCKETLAUNCHER"

			"mult dmg vs giants" 2.5
			"add damage type" 128
			"remove damage type" 64
			"blast dmg to self increased" 0
			"self dmg push force decreased" 0

			"projectile speed decreased" 0.55
			"projectile spread angle penalty" 55
			"projectile gravity" 750

			"mult projectile scale" 0.4
			"custom projectile size" 0.1

			"custom projectile model" "models/props_coalmines/boulder3_medium.mdl"
			"projectile trail particle" "manmelter_projectile_trail"
            "explosion particle" "rd_robot_explosion_smoke_linger"

			"custom weapon fire sound" "=55|weapons/rpg/rocketfire1.wav"
            "custom impact sound" "=75|weapons/explode4.wav"
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						PrecacheSound(`physics/concrete/concrete_break3.wav`)
						PrecacheSound(`music/mvm_lost_wave.wav`)

						IncludeScript(`tankextensions_main`)
                		IncludeScript(`tankextensions/gatetank`)
						IncludeScript(`tankextensions/hammertank`)
						IncludeScript(`tankextensions/teletank`)
						IncludeScript(`tankextensions/speedtank`)
					  "
			}

			game_round_win
			{
                "targetname" "RedLose"
                "classname" "game_round_win"
				"TeamNum" "3"
				"switch_teams" "0"
				"force_map_reset" "1"
			}
			logic_timer
			{
				"targetname" "RedLoseTimer"
				"RefireTime" "2.0"

				"OnTimer" "RedLoseRelay,Trigger,,0,-1"

				"StartDisabled" "1"

			}
			logic_relay
			{
				"targetname" "RedLoseRelay"
				"OnTrigger" "RedLose,RoundWin,,0,-1"
                "startdisabled" "1"
			}

			// Global Filters
			filter_multi
            {
                "targetname" "filter_redteam_nouber"
                "Negated" "0"
                "FilterType" "0"

				"Filter01" "filter_is_player"
                "Filter02" "filter_red"
                "Filter03" "filter_is_not_ubered"
                "Filter04" "filter_is_not_ubered2"
                "Filter05" "filter_is_not_ubered3"
                "Filter06" "filter_is_not_ubered4"
            }

			filter_activator_class
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
			filter_tf_condition
            {
                "targetname" "filter_is_not_ubered"
                "Negated" "1"
                "condition" "5"
            }
            filter_tf_condition
            {
                "targetname" "filter_is_not_ubered2"
                "Negated" "1"
                "condition" "52"
            }
            filter_tf_condition
            {
                "targetname" "filter_is_not_ubered3"
                "Negated" "1"
                "condition" "51"
            }
			filter_tf_condition
            {
                "targetname" "filter_is_not_ubered4"
                "Negated" "1"
                "condition" "57"
            }
		}

		MissionPT
		{
			// Wave 2 End Sequence
			logic_relay
			{
				"targetname" "Wave2EndRelay"

				"OnTrigger" "Player,$DisplayTextChat,{99C2D8}???{reset}: ENGAGE PERIMETER SECURITY RELAYS,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,0,-1"
				"OnTrigger" "ambush_gate_a_enable,Trigger,,0,-1"
				"OnTrigger" "ambush_gate_b_enable,Trigger,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave2_Subwave1_Spies,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave2_Subwave4_Spies,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave2_Subwave4_TheCrew,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave2_Subwave4_TheCrew,0,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_startup1.wav,2,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,4,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_top.wav,4.75,-1"
				"OnTrigger" "PlayerRunScriptCodeself.ViewPunch(QAngle(-30,-30,-30))4.751"

				"OnTrigger" "Wave2EndRelayStun,Enable,,5,-1"
				"OnTrigger" "Wave2EndRelayStun,Disable,,5.1,-1"
				"OnTrigger" "item_teamflag*,ForceResetSilent,,5,-1"
				"OnTrigger" "item_teamflag*,Disable,,5,-1"
				"OnTrigger" "BigNetRunScriptCode;EmitSoundEx({sound_name=`music/mvm_lost_wave.wav`,channel = 6, pitch = 60, filter_type = 5})01"
				"OnTrigger" "PlayerRunScriptCodeself.SetHudHideFlags(~132)5-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 64, 119, 158, 150, 0.9, 0.1, 1)51"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 0, 0, 0, 255, 7, 8, 2)5-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_shutdown1.wav,5,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,6,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,8,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_shutdown1.wav,8,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,10,-1"

				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_shutdown1.wav,11,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,12,-1"

				"OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,16,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,16.4,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,16.8,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,17.2,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,17.6,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,18,1"

				"OnTrigger" "GottaSweepSweepSweep,Enable,,19,-1"
				"OnTrigger" "Player,$TeleportToEntity,red_spawn,19.1,-1"

				"OnTrigger" "Wave3PT,ForceSpawn,,20,-1"
				"OnTrigger" "obj_sentry*,RemoveHealth,99999,20,-1"
                "OnTrigger" "obj_teleporter*,RemoveHealth,99999,20,-1"
                "OnTrigger" "obj_dispenser*,RemoveHealth,99999,20,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 0, 0, 0, 255, 5, 0.1, 1)20-1"
				"OnTrigger" "PlayerRunScriptCodeself.RemoveHudHideFlags(~132)25-1"
				"OnTrigger" "GottaSweepSweepSweep,Disable,,25,-1"
			}
			trigger_stun
			{
				"targetname" "Wave2EndRelayStun"
				"filtername" "filter_red"
				"mins" "-6000 -6000 -6000"
				"maxs" "6000 6000 6000"
				"wait" "0.1"

				"stun_type" "2"
				"stun_duration" "15"
				"stun_effects" "0"
				"move_speed_reduction" "0"

				"spawnflags" "1"

				"disableshadows" "1"
				"startdisabled" "1"
			}
			trigger_hurt // Mapwide Bot Cleaner
            {
                "targetname" "GottaSweepSweepSweep"
				"filtername" "filter_blue"
                "mins" "-5000 -5000 -5000"
				"maxs" "5000 5000 5000"

                "damage" "3000000"
                "damagetype" "16"
                "spawnflags" "1"

				"disableshadows" "1"
				"startdisabled" "1"
            }
		}

		Wave3PT
		{
			OnSpawnOutput
			{
				Target "Wave3SetupRelay"
				Action Trigger
			}

			logic_relay
			{
				"targetname" "Wave3SetupRelay"

				"OnTrigger" "Wave3SideBarrierPT,ForceSpawn,,0,-1"
				"OnTrigger" "Wave3MainBarrierPT,ForceSpawn,,0,-1"
				"OnTrigger" "forcecapture_ab_relay,Trigger,,0,-1"
				"OnTrigger" "BigNet,RunScriptCode,SetSkyboxTexture(`sky_halloween`),0,-1"
				"OnTrigger" "RustvalleyNightCC,Enable,,0,-1"
				"OnTrigger" "RustvalleyFog,Enable,,0,-1"
				"OnTrigger" "skybox_revolving,Kill,,0,-1"
				"OnTrigger" "env_sun,Kill,,0,-1"

				"OnTrigger" "door_red_large_win_4,Lock,,0,-1"

				"OnTrigger" "cap_b_trigtimer,$SetKey$area_time_to_cap,40,0,-1"

				"OnTrigger" "cap_b_trigtimer,AddOutput,OnCapTeam1 PointBCaptureRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "cap_a_trigtimer,AddOutput,OnCapTeam1 PointACaptureRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "cap_b_trigtimer,AddOutput,OnCapTeam2 RedLoseRelay:Trigger::0:-1,0,-1"
			}
			logic_relay
			{
				"targetname" "Wave3StartRelay"

				"OnTrigger" "Wave3Music,PlaySound,,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap1.wav,0,-1"

				"OnTrigger" "RedSpawnGarageDoorRunScriptCodemove<-0.2;function Think(){self.SetAbsOrigin(self.GetOrigin()+Vector(0,0,move>3?3:move));move+=0.09;return-1};AddThinkToEnt(self,`Think`)1-1"
				"OnTrigger" "tf_gamerules,PlayVO,doors/heavy_metal_move1.wav,0,-1"
				"OnTrigger" "RedSpawnGarageDoorField,Kill,,1,-1"
				"OnTrigger" "RedSpawnGarageDoorNobuild,Kill,,1,-1"
				"OnTrigger" "door_red_large_win_4,Unlock,,1,-1"
                "OnTrigger" "door_red_large_win_4,Open,,1.1,-1"

				"OnTrigger" "tf_gamerules,PlayVO,doors/garage_stop1.wav,2,-1"
				"OnTrigger" "RedSpawnGarageDoor,Kill,,2,-1"
			}
			color_correction
            {
                "targetname" "RustvalleyNightCC"

				"filename" "materials/colorcorrection/rustvalleynight2.raw"
                "maxweight" "0.5"

                "minfalloff" "-1"
                "maxfalloff" "-1"
                "fadeInDuration" "0"
                "fadeOutDuration" "0"
                "StartDisabled" "1"
            }
			ambient_generic
            {
                "targetname" "Wave3Music"
                "message" "#rustvalleynight.mp3"
                "health" "10"
                "pitch" "100"
                "spawnflags" "17"
            }
			prop_dynamic
            {
                "targetname" "RustvalleyFog"
				"origin" "-890 -1282 -2106"
                "model" "models/fog.mdl"
                "modelscale" "2.8"
                "rendercolor" "0 12 80"

                "disableshadows" "1"
                "disablebonefollowers" "1"
				"startdisabled" "1"
            }
			prop_dynamic
            {
                "targetname" "RustvalleyFog"
				"origin" "-890 -1282 -2436"
				"angles" "-180 0 0"
                "model" "models/fog.mdl"
                "modelscale" "2.8"
                "rendercolor" "0 12 80"

                "disableshadows" "1"
                "disablebonefollowers" "1"
				"startdisabled" "1"
            }

			prop_dynamic
            {
                "targetname" "RedSpawnGarageDoor"
				"origin" "-4197 370 -240"
				"angles" "180 0 0"
                "model" "models/props_gameplay/door_slide_large_door.mdl"
                "modelscale" "3"

				"disablebonefollowers" "1"
                "disableshadows" "1"
            }
			func_forcefield
            {
                "targetname" "RedSpawnGarageDoorField"
                "origin" "-4265 292 -328"
                "mins" "-300 -24 -50"
                "maxs" "300 24 500"

                "teamnum" "3"
            }
			func_nobuild
			{
			    "targetname" "RedSpawnGarageDoorNobuild"
                "origin" "-4210 340 -312"
                "mins" "-300 -70 -50"
                "maxs" "1500 70 500"
			}

			logic_relay
			{
				"targetname" "TeleTankActivateRelay"

				"OnTrigger" "!activator,SetSpeed,13,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,0,-1"
				"OnTrigger" "!activator,SetSpeed,26,2,-1"
				"OnTrigger" "!activator,SetSpeed,39,4,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_activate.wav,4,-1"
				"OnTrigger" "TeleTankParticle,Start,,4,-1"
				"OnTrigger" "!activator,SetSpeed,52,6,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave3_Subwave1_BurstDemos,6,-1"
				"OnTrigger" "!activator,SetSpeed,75,8,-1"
			}

			logic_relay
			{
				"targetname" "PointBUnlockRelay"

				"OnTrigger" "cap_b,SetLocked,0,0,-1"
				"OnTrigger" "cap_b_trigtimer,SetTeamCanCap,2 1,0,-1"
				"OnTrigger" "cap_b_trigtimerRunScriptCodeNetProps.SetPropEntity(self,`m_hFilter`,Entities.FindByName(null, `capture_filter`))0-1"
				"OnTrigger" "BigNetRunScriptCodeSendGlobalGameEvent(`show_annotation`, {text = `It's time to fight back! Capture the gates!`, lifetime = 5, worldPosX = -1256, worldPosY = 2445, worldPosZ = -76})0,-1"
				"OnTrigger" "BigNetRunScriptCodeSendGlobalGameEvent(`show_annotation`, {text = `You must also defend them! We cannot lose the gates again!`, lifetime = 5, worldPosX = -1256, worldPosY = 2445, worldPosZ = -76})5,-1"

				"OnTrigger" "GateBForwardTeleporter,SetAnimation,running,10,-1"
				"OnTrigger" "GateBForwardTeleporterParticle,Start,,10,-1"
			}

			prop_dynamic
			{
				"targetname" "GateBForwardTeleporter"
				"origin" "-3914 1616 -246"
				"model" "models/buildables/teleporter_light.mdl"
				"skin" "1"
				"solid" "0"

				"disablebonefollowers" "1"
				"disableshadows" "1"
			}
			info_particle_system
			{
				"targetname" "GateBForwardTeleporterParticle"
				"origin" "-3914 1616 -246"
				"effect_name" "teleporter_blue_charged_level3"
			}

			logic_relay
			{
				"targetname" "PointBCaptureRelay"

				"OnTrigger" "GateBForwardTeleporter,SetAnimation,idle,0,-1"
				"OnTrigger" "GateBForwardTeleporterParticle,Kill,,0,-1"
				"OnTrigger" "GateATankTeleporter,SetAnimation,running,0,-1"
				"OnTrigger" "pop_interface,$ResumeWavespawn,Wave3_Subwave2_GDeflectorHeavy,0,-1"
			}

			prop_dynamic
			{
				"targetname" "GateATankTeleporter"
				"origin" "-1008 -304 -128"
				"model" "models/buildables/teleporter_light.mdl"
				"modelscale" "4.5"
				"skin" "1"
				"solid" "0"

				"disablebonefollowers" "1"
				"disableshadows" "1"
			}

			logic_relay
			{
				"targetname" "PointAUnlockRelay"

				"OnTrigger" "cap_a,SetLocked,0,0,-1"
				"OnTrigger" "cap_a_trigtimer,SetTeamCanCap,2 1,0,-1"
				"OnTrigger" "cap_a_trigtimerRunScriptCodeNetProps.SetPropEntity(self,`m_hFilter`,Entities.FindByName(null, `capture_filter`))0-1"
			}
		}

