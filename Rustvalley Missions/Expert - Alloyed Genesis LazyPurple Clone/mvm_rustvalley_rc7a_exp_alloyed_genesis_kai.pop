				"targetname" "AlloyedGenesisForemanSlamDamage"
				"origin" "500 0 20"

				"teamnum" "3"
				"WeaponType" "3"
				"Damage" "300"
				"SplashRadius" "350"

				"$preventshootparent" "1"

				"$OnFire" "!self,DetonateStickies,,0,-1"
			}

			// Foreman Axe Throw

			logic_relay
			{
				"targetname" "AlloyedGenesisForemanAxeThrowRelay"

				"OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`hand scale`,7,-1)0-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `mvm/mvm_deploy_giant.wav`, channel = 6, pitch = 85, filter_type = 5})11"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `mvm/mvm_deploy_giant.wav`, channel = 6, pitch = 85, filter_type = 5, flags = 4})2.51"

				"OnTrigger" "!activatorRunScriptCodeself.RemoveCustomAttribute(`hand scale`)6-1"

				"OnTrigger" "AlloyedGenesisAttackInit,Trigger,,10,-1"
			}

			// John Baseball Swarm

			logic_relay
			{
				"targetname" "AlloyedGenesisJohnBaseballSwarmRelay"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/scout_mvm_m_paincrticialdeath01.mp3`, pitch = 60, special_dsp = 57, filter_type = 5})0-1"

				"OnTrigger" "AlloyedGenesisCheckpointPT,ForceSpawnAtEntityOrigin,!activator,2.49,-1"
				"OnTrigger" "!activator,$AddCond,71 16,2.49,-1"

				"OnTrigger" "tf_gamerules,PlayVO,items/powerup_pickup_supernova.wav,2.5,-1"

				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave4_JohnBaseballSummon,2.5,-1"
				"OnTrigger" "SummonSmokescreenParticle,Start,,2.5,-1"

				"OnTrigger" "!activator,$TeleportToEntity,spawnbot_boss0,3,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_JohnBaseballSummon,3,-1"
				"OnTrigger" "SummonSmokescreenParticle,Stop,,3,-1"

				"OnTrigger" "!activator,$TeleportToEntity,CheckpointTarget,11,-1"
				"OnTrigger" "SummonSmokescreenParticle,Start,,11.1,-1"
				"OnTrigger" "SummonSmokescreenParticle,Stop,,11.6,-1"

				"OnTrigger" "AlloyedGenesisAttackInit,Trigger,,18.5,-1"
			}

			// Mecha Miner Burrow Combo

			logic_relay
			{
				"targetname" "AlloyedGenesisBurrowComboRelay"

				"OnTrigger" "!activator,$ChangeAttributes,AlloyedGenesisBurrowInit,0,-1"
				"OnTrigger" "AlloyedGenesisAttackInit,Trigger,,18,-1"
			}

			logic_relay
			{
				"targetname" "AlloyedGenesisBurrowRelay"

				"OnTrigger" "!activator,$PlaySequence,taunt_vehicle_allclass_start,0,-1"
				"OnTrigger" "!activator,$AddPlayerAttribute,no_attack|1,0,-1"

				"OnTrigger" "!activator,$ChangeAttributes,AlloyedGenesisBurrow,1,-1"
				"OnTrigger" "AlloyedGenesisRingAttack,ForceSpawnAtEntityOrigin,!activator,1,-1"
				"OnTrigger" "AlloyedGenesisBurrowRocks,FireMultiple,10,1,-1"
				"OnTrigger" "!activator,$RemovePlayerAttribute,no_attack,1,-1"
				"OnTrigger" "AlloyedGenesisBurrowDust,Start,,1,-1"
				"OnTrigger" "!activatorRunScriptCodeEmitSoundEx({sound_name=`physics/concrete/concrete_break3.wav`,channel = 6, filter_type = 5, origin =  self.GetOrigin()})1-1"
				"OnTrigger" "!activatorRunScriptCodeScreenShake(self.GetOrigin(), 6, 8, 0.5, 2000, 0, true)1-1"

				"OnTrigger" "AlloyedGenesisBurrowDust,Stop,,2,-1"
			}
			logic_relay
			{
				"targetname" "AlloyedGenesisUnBurrowRelay"

				"OnTrigger" "AlloyedGenesisBurrowRocks,FireMultiple,10,0,-1"
				"OnTrigger" "AlloyedGenesisRingAttack,ForceSpawnAtEntityOrigin,!activator,0,-1"
				"OnTrigger" "AlloyedGenesisBurrowDust,Start,,0,-1"
				"OnTrigger" "!activatorRunScriptCodeself.ApplyAbsVelocityImpulse(Vector(0,0,350))0-1"
				"OnTrigger" "!activatorRunScriptCodeEmitSoundEx({sound_name=`physics/concrete/concrete_break3.wav`,channel = 6, filter_type = 5, origin =  self.GetOrigin()})0-1"
				"OnTrigger" "!activatorRunScriptCodeScreenShake(self.GetOrigin(), 6, 8, 0.5, 2000, 0, true)0-1"

				"OnTrigger" "!activator,$PlaySequence,airwalk_loser,0.015,-1"
				"OnTrigger" "AlloyedGenesisBurrowDust,Stop,,1,-1"
			}

			tf_point_weapon_mimic
			{
				"targetname" "AlloyedGenesisBurrowRocks"
				"origin" "0 0 20"
				"angles" "270 0 0"

				"teamnum" "3"
				"$weaponname" "MechaMinerRockWeapon"
			}
			info_particle_system
            {
                "targetname" "AlloyedGenesisBurrowDust"
                "effect_name" "mvm_wood_boards_destroy"
            }
			info_particle_system
            {
                "targetname" "AlloyedGenesisBurrowDust"
                "origin" "0 0 5"
                "effect_name" "hammer_impact_button"
            }
		}
		AlloyedGenesisLoseCondPT
		{
			OnSpawnOutput
			{
				Target bignet
				Action RunScriptCode
				Param "
				IncludeScript(`textualtimer_v3`, getroottable())
				TextualTimer.SetParams({
					minutes = 1
					seconds = 0
					x = -1
					y = 0.77
					color = `0 255 555`
					text_prepend = `IMMINENT DEATH AND DESTRUCTION: `
					automatic = false
        		})
				"
			}

			logic_case
            {
                "targetname" "LoseConditionCase"
                "OnCase01" "BombLoseConditionRelay,Trigger,,0,-1"
                "OnCase02" "GateLoseConditionRelay,Trigger,,0,-1"
                "OnCase03" "TeamWipeLoseConditionRelay,Trigger,,0,-1"
            }
			game_text
			{
				"targetname" "LoseConditionSwitchText"
				"message" "SWITCHING LOSE CONDITIONS..."
				"channel" "2"
				"color" "255 255 255"

				"x" "-1"
				"y" "0.2"

				"effect" "0"
				"fxtime" "0.2"
				"holdtime" "0.2"
				"fadeout" "0.2"

				"spawnflags" "1"
			}

			logic_relay
            {
                "targetname" "LoseConditionTimer"
				"spawnflags" "2"

                "OnTrigger" "LoseConditionSwitchRelay,Trigger,,0,-1"
                "OnTrigger" "!self,Trigger,,90,-1"
            }
			logic_relay
			{
				"targetname" "LoseConditionSwitchRelay"

				"OnTrigger"	"tf_gamerules,PlayVO,mvm/mvm_warning.wav,0,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,0.05,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,0.05,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,0.75,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,0.75,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,1.45,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,1.45,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,2.15,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,2.15,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,2.85,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,2.85,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,3.55,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,3.55,-1"

				"OnTrigger"	"tf_gamerules,PlayVO,mvm/mvm_warning.wav,7,-1"
                "OnTrigger" "LoseConditionCase,PickRandomShuffle,,7,-1"
			}

			// Bomb Lose Condition
			logic_relay
            {
                "targetname" "BombLoseConditionRelay"

				"OnTrigger" "@p@alloyedgenesisRunScriptCodeself.RemoveBotTag(`bot_gatebot`)0-1"

                "OnTrigger" "BombLoseHintTimer,Enable,,0,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave4_BombCarriers,0,-1"

				"OnTrigger" "TeamWipeLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_Mobbers,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_Mobbers,0,-1"

				"OnTrigger" "GateLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_Gatebots,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_Gatebots,0,-1"

                "OnTrigger" "TimerLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "TeamwipeLoseRelay,Disable,,0,-1"
            }
            logic_timer
			{
				"targetname" "BombLoseHintTimer"
				"RefireTime" "2.0"
				"StartDisabled" "1"
				"OnTimer" "BombLoseHint,ShowHudHint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "BombLoseHint"
				"message" "[OBJECTIVE] PREVENT THE BOMB FROM DEPLOYING"
				"spawnflags" "1"
			}

			// Gate Lose Condition
			logic_relay
            {
                "targetname" "GateLoseConditionRelay"

				"OnTrigger" "@p@alloyedgenesisRunScriptCodeself.RemoveBotTag(`bot_gatebot`)0-1"

				"OnTrigger" "intel_classic,ForceReset,,0,-1"

				"OnTrigger" "GateLoseHintTimer,Enable,,0,-1"
				"OnTrigger" "BossGateTimer,Enable,,0,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave4_Gatebots,0,-1"

				"OnTrigger" "BombLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_BombCarriers,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_BombCarriers,0,-1"

				"OnTrigger" "TeamWipeLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_Mobbers,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_Mobbers,0,-1"

                "OnTrigger" "TimerLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "TeamwipeLoseRelay,Disable,,0,-1"
            }
            logic_timer
            {
                "targetname" "BossGateTimer"
                "RefireTime" "0.5"
                "StartDisabled" "1"

                "OnTimer" "@p@alloyedgenesisRunScriptCodeself.AddBotTag(`bot_gatebot`)0-1"
            }
            logic_timer
			{
				"targetname" "GateLoseHintTimer"
				"RefireTime" "2.0"
				"StartDisabled" "1"
				"OnTimer" "GateLoseHint,ShowHudHint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "GateLoseHint"
				"message" "[OBJECTIVE] PREVENT THE GATES FROM BEING CAPTURED"
				"spawnflags" "1"
			}

			// Teamwipe Lose Condition
			logic_relay
            {
                "targetname" "TeamWipeLoseConditionRelay"

				"OnTrigger" "@p@alloyedgenesisRunScriptCodeself.RemoveBotTag(`bot_gatebot`)0-1"

				"OnTrigger" "intel_classic,ForceReset,,0,-1"

				"OnTrigger" "TeamWipeLoseHintTimer,Enable,,0,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave4_Mobbers,0,-1"

				"OnTrigger" "GateLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "BossGateTimer,Disable,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_Gatebots,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_Gatebots,0,-1"

				"OnTrigger" "BombLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_BombCarriers,0,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_BombCarriers,0,-1"

                "OnTrigger" "TimerLoseHintTimer,Disable,,0,-1"
				"OnTrigger" "TeamwipeLoseRelay,Enable,,0,-1"
            }
            logic_timer
			{
				"targetname" "TeamWipeLoseHintTimer"
				"RefireTime" "2.0"
				"StartDisabled" "1"
				"OnTimer" "TeamWipeLoseHint,ShowHudHint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "TeamWipeLoseHint"
				"message" "[OBJECTIVE] DO NOT ALL DIE AT ONCE"
				"spawnflags" "1"
			}

			// Timer Lose Condition
			logic_relay
			{
				"targetname" "TimerLoseConditionRelay"

				"OnTrigger" "@p@alloyedgenesisRunScriptCodeself.RemoveBotTag(`bot_gatebot`)0-1"
				"OnTrigger" "BossGateTimer,Disable,,0,-1"

				"OnTrigger"	"tf_gamerules,PlayVO,mvm/mvm_warning.wav,0,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,0.05,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,0.05,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,0.75,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,0.75,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,1.45,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,1.45,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,2.15,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,2.15,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,2.85,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,2.85,-1"

				"OnTrigger" "LoseConditionSwitchText,Display,,3.55,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,3.55,-1"

				"OnTrigger"	"tf_gamerules,PlayVO,mvm/mvm_warning.wav,7,-1"

				"OnTrigger" "intel_classic,ForceReset,,7,-1"

				"OnTrigger" "TimerLoseHintTimer,Enable,,7,-1"
				"OnTrigger" "TimerTriggerRelay,Trigger,,7,-1"

				"OnTrigger" "BombLoseHintTimer,Disable,,7,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_BombCarriers,7,-1"
				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_BombCarriers,7,-1"

				"OnTrigger" "TeamWipeLoseHintTimer,Disable,,7,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_Mobbers,7,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_Mobbers,7,-1"

				"OnTrigger" "GateLoseHintTimer,Disable,,7,-1"

				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave4_Gatebots,7,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_Gatebots,7,-1"

				"OnTrigger" "TeamwipeLoseRelay,Disable,,7,-1"
			}
			logic_relay
            {
                "targetname" "TimerTriggerRelay"

                "OnTrigger" "BigNet,RunScriptCode,TextualTimer.Start(),0,-1"
            }
			logic_timer
			{
				"targetname" "TimerLoseHintTimer"
				"RefireTime" "2.0"
				"StartDisabled" "1"
				"OnTimer" "TimerLoseHint,ShowHudHint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "TimerLoseHint"
				"message" "[OBJECTIVE] PREVENT THE TIMER FROM REACHING ZERO"
				"spawnflags" "1"
			}
		}
		AlloyedGenesisRingPT
        {
            NoFixUp 1
            env_entity_maker
            {
                "targetname" "AlloyedGenesisRingAttack"
                "entitytemplate" "AlloyedGenesisRingAttackPT"
            }
            OnSpawnOutput
            {
                target "!activator"
