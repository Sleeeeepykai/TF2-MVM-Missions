			Attributes MiniBoss
			Attributes DisableDodge

			UseMeleeThreatPrioritization 1

			SpawnTemplate "MiniMechaMinerPT"

			Tag bot_giant
			Tag dontdoublehp
			Tag dontdoublehp_damageres

			Item "The Data Mining Light"

			ChangeAttributes
			{
				Name "MechaMinerBurrowInit"
				Delay 4
				Repeats 1
			}
			ChangeAttributes
			{
				Name "MechaMinerUnBurrow"
				Delay 0
				Repeats 1
				IfHealthBelow 3700
			}

			EventChangeAttributes
			{
				MechaMinerBurrowInit [$SIGSEGV]
				{
					FireInput
					{
						Target "@c@!activator"
						Action FireUser1
						Delay 0
						Repeats 1
					}
				}
				MechaMinerBurrow [$SIGSEGV]
				{
					Attributes AlwaysFireWeapon

					Item "TF_WEAPON_GRENADELAUNCHER"

					UseCustomModel "models/empty.mdl"

					CharacterAttributes
					{
						"move speed penalty" 0.65
						"damage force reduction" 0
						"airblast vulnerability multiplier" 0
						"airblast vertical vulnerability multiplier" 0
						"mult stun resistance" 0.2
						"cancel falling damage" 1
						"not solid to players" 1
						"ignored by enemy sentries" 1

                		"voice pitch scale"	0
						"head scale" 0

						"dmg from ranged reduced" 0.25
						"dmg from melee increased" 0.25
						"add cond when active" 30

						"stomp player force" 270
						"stomp player time" 3
						"stomp player damage" 10
					}

					ItemAttributes
					{
						ItemName "TF_WEAPON_GRENADELAUNCHER"

						"damage penalty" 0.01
						"dmg bonus vs buildings" 5
						"dmg taken from self reduced" 0.001
						"self dmg push force decreased" 0.001
						"blast radius increased" 1.33
						"fuse bonus" 0.05
						"override projectile type" 17

						"fire rate bonus" 0.07
						"faster reload rate" 0.001

						"projectile speed decreased" 0.001
						"projectile spread angle penalty" 3
						"mult projectile count" 3
						"projectile gravity" 10000

						"custom item model" "models/empty.mdl"
						"custom projectile model" "models/empty.mdl"
						"projectile trail particle" "~unusual_smoking"
						"explosion particle" "weight_dust"
						"custom kill icon" "sticky_resistance"
					}
				}
				MechaMinerUnBurrow [$SIGSEGV]
				{
					Attributes AlwaysFireWeapon
					WeaponRestrictions SecondaryOnly

					Item "The Frontier Justice"

					UseCustomModel "models/bots/engineer/bot_engineer.mdl"

					CharacterAttributes
					{
						"move speed penalty" 1
						"damage force reduction" 1
						"airblast vulnerability multiplier" 1
						"airblast vertical vulnerability multiplier" 1
						"mult stun resistance" 1
						"cancel falling damage" 1
						"not solid to players" 0
						"ignored by enemy sentries" 0

                		"voice pitch scale"	0

						"dmg from ranged reduced" 1
						"dmg from melee increased" 1
					}

					ItemAttributes
					{
						ItemName "The Frontier Justice"

						"is_passive_weapon" 1

						"dmg bonus vs buildings" 2.5
						"blast radius decreased" 0.01
						"no damage falloff" 1
						"no self blast dmg" 2
						"override projectile type" 2
						"centerfire projectile" 1

						"fire rate bonus" 0.1
						"mod max primary clip override" -1

						"projectile speed decreased" 0.2
						"projectile spread angle penalty" 1
						"mult projectile count" 3
						"projectile lifetime" 0.5
						"ignores other projectiles" 1
