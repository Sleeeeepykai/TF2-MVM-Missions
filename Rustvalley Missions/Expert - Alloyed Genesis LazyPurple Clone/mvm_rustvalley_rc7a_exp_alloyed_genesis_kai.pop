// Rust Valley Expert - Alloyed Genesis by Sergeant Table: https://steamcommunity.com/id/FinalBossConnoisseur/
// Fucking massive popfile ahead, half of the things here are genuienly indecipherable!
// An attempt at a gimmick mission, probably my last mission for a good while
// --- SPECIAL THANKS ---
//   - Colonel: For the original miner engineer template and concepts for other miner variants
//   - Alche: Better positioning for the boss spawn texts
//   - SNTR: Overall map trouble shooting for Wave 3
//   - Sleeeepykai: Color Corrections across all the waves to simulate the passage of time
//                  Overall lore and story writing
//                  Help with the final boss
//                  Simply Rotund (Bossing it)
//   - Package o' Lies: Overall inspiration from his mission 0 in the way the lore is presented
//   - B855: Bustlet
//
#base robot_standard.pop
#base robot_giant.pop
#base robot_gatebot.pop
#base bustlet_base.pop

WaveSchedule
{
	StartingCurrency 1500
    CanBotsAttackWhileInSpawnRoom No
    RespawnWaveTime 4

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15

	WaveStartCountdown 7

	AllowBotExtraSlots 1
    RobotLimit 26

	BodyPartScaleSpeed 15

	TextPrintTime 0

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/weapons/c_models/c_biobreaker/c_biobreaker.mdl"
	PrecacheModel "models/weapons/w_models/w_atomball_blu.mdl"

	PrecacheModel "models/fog.mdl"

	PrecacheModel "models/bots/demo/bot_sentry_buster_gibby.mdl"

	PrecacheModel "models/bots/pyro_boss/bot_pyro_boss_gibby.mdl"
	PrecacheModel "models/bots/soldier_boss/bot_soldier_boss_gibby.mdl"
	PrecacheModel "models/bots/sniper_boss/bot_sniper_boss.mdl"
	PrecacheModel "models/bots/heavy_boss/bot_heavy_boss_gibby.mdl"

	PrecacheModel "models/props_halloween/fist_projectile_purple.mdl"

	// Precached Sounds //

	// SFX
	PrecacheSound "major_shocks_spin.mp3"
	PrecacheSound "megabuster_explode.mp3"
	PrecacheSound "boss_defeated_ignis.mp3"

	PrecacheSound "fat_w7_wind.mp3"

	PrecacheSound "megalaser_chargeup.wav"
	PrecacheSound "megalaser_fire.wav"
	PrecacheSound "megalaser_fireloop.wav"

	// Music
	PrecacheSound "rustvalleynight.mp3"
	PrecacheSound "w3preboss.mp3"
	PrecacheSound "vstimeddisastersrevenge_intro.mp3"
	PrecacheSound "vstimeddisastersrevenge.mp3"
	PrecacheSound "alloyed_genesis_placeholder.mp3"

	// Precached Particles //

	PrecacheParticle "moon_drill_dust"

	// Precached Colour-Corrections //

	PrecacheGeneric "materials/colorcorrection/rustvalleynight2.raw"
	PrecacheGeneric "materials/colorcorrection/stormlight.raw"

	//// DISABLED SOUNDS ////

	DisableSound "Announcer.MVM_Wave_End"
	DisableSound "Announcer.MVM_Get_To_Upgrade"
	DisableSound "Announcer.MVM_Final_Wave_End"
	DisableSound "music.mvm_end_last_wave"
	DisableSound "music.mvm_end_mid_wave"
	DisableSound "music.mvm_end_tank_wave"
	DisableSound "music.mvm_end_wave"
	DisableSound "music.mvm_lost_wave"
	DisableSound "music.mvm_start_last_wave"
	DisableSound "music.mvm_start_mid_wave"
	DisableSound "music.mvm_start_tank_wave"
	DisableSound "music.mvm_start_wave"

	//// LUA SCRIPTS ////

	LuaScriptFile "scripts/shockwave_shields.lua"

