		// VORTEX CHAMP //

		VortexChampPT
		{
			OnSpawnOutput
			{
				Target VortexChampTarget
				Action SetParent
				Param !activator
			}

			info_target
			{
				"targetname" "VortexChampTarget"

				"OnUser1" "VortexChampSpinRelay,Trigger,,0,-1"
			}

			logic_relay
			{
				"targetname" "VortexChampSpinRelay"
				"spawnflags" "2"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_cap_spin_start.wav,0,-1"
				"OnTrigger" "!activator,$AddCond,2 9,0,-1"

				"OnTrigger" "VortexChampParticle,Start,,1,-1"
				"OnTrigger" "VortexProp,$SetKey$renderfx,8,1,-1"

				"OnTrigger" "!activator,$AddCond,11 7.5,1,-1"
				"OnTrigger" "tf_gamerules,PlayVO,major_shocks_spin.mp3,1,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient_mp3/halloween/windgust_10.mp3,1,-1"
				"OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,1.3,-1)1-1"
                "OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,1.6,-1)1.2-1"
                "OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,1.9,-1)1.4-1"
                "OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,2.2,-1)1.6-1"
				"OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,5,-1)1.8-1"

				"OnTrigger" "VortexDrag,Enable,,2,-1"
				"OnTrigger" "VortexDamage,Enable,,2,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_cap_spin_start.wav,8.5,-1"
				"OnTrigger" "VortexProp,$SetKey$renderfx,6,9,-1"
				"OnTrigger" "VortexChampParticle,Stop,,9,-1"

				"OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,2.2,-1)9-1"
                "OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,1.9,-1)9.2-1"
                "OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,1.6,-1)9.4-1"
                "OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,1.3,-1)9.6-1"
				"OnTrigger" "!activatorRunScriptCodeself.AddCustomAttribute(`gesture speed increase`,1,-1)9.8-1"

				"OnTrigger" "VortexDrag,Disable,,10,-1"
				"OnTrigger" "VortexDamage,Disable,,10,-1"
				"OnTrigger" "!activator,$ChangeAttributes,VortexChampCooldown,10,-1"
			}

			point_push
			{
				"targetname" "VortexDrag"
				"origin" "0 0 10"

				"radius" "1200"
				"innerradius" "200"
				"magnitude" "-120"
				"spawnflags" "8"

				"startdisabled" "1"
			}
			trigger_hurt
			{
				"targetname" "VortexDamage"
				"filtername" "filter_redteam_nouber"
				"origin" "0 0 90"
				"mins" "-100 -100 -100"
				"maxs" "100 100 100"

				"damagetype" "128"
				"damage" "65"
			}

			func_rotating
