	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					local Bomb = Entities.FindByName(null, `intel_classic`)
                	Bomb.AcceptInput(`RunScriptFile`, `bombhop.nut`, null, null)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_start_relay_expert`, `Trigger`)
				  "
		}
		DoneOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_finished_relay`, `Trigger`)
				  "
		}

		CustomMaxWaveNumber 3

