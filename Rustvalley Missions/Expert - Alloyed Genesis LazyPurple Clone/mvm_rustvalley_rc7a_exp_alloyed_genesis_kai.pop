            {
                target "roundbeamtest"
                action "TurnOff"
                delay "4.5"
            }
            OnSpawnOutput
            {
                target "roundbeamtest"
                action "StrikeOnce"
                delay "0"
            }
            OnSpawnOutput
            {
                target "roundbeamtest"
                action "kill"
                delay "5.0"
            }
            OnSpawnOutput
            {
                target "ringmarkerone"
                action "RunScriptCode"
                param "SetMoveIgnoreSolid(self, 600)"
            }
            OnSpawnOutput
            {
                target "roundbeamtest"
                action "RunScriptCode"
                param "RingRegister(self,500,CzUtil.GetTracking(`ringOwnerGenesis`))"
                delay 0.0
            }
            OnSpawnOutput
