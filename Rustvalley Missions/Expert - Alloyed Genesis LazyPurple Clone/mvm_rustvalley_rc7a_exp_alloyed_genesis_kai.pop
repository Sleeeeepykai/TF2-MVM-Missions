	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`FinaleSetupRelay`, `Trigger`)

					IncludeScript(`bosstickdown`)

					::AlloyedGenesisDeathScript <- {
						function OnGameEvent_recalculate_holidays(_) { if(GetRoundState() == 3) delete ::AlloyedGenesisDeathScript }
						function OnGameEvent_player_death(params)
						{
							local hVictim = GetPlayerFromUserID(params.userid)
							if(hVictim.IsBotOfType(1337))
							{
								if(hVictim.HasBotTag(`dontdoublehp`))
								{
									EntFire(`AlloyedGenesisDeathPT`,`ForceSpawnAtEntityOrigin`,`AlloyedGenesisDeathSpawn`)
								}
							}
						}
					}
					__CollectGameEventCallbacks(AlloyedGenesisDeathScript)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_start_relay_classic`, `Trigger`)
					EntFire(`AlloyedGenesisIntroPT`, `ForceSpawn`)
				  "
		}
		DoneOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_finished_relay`, `Trigger`)
				  "
		}

		Explanation
        {
            Line "{yellow}IT WILL NOT HOLD BACK. IT WILL PULL ALL THE STOPS."
            Line "{yellow}IT WILL DYNAMICALLY SWITCH LOSE CONDITIONS."
        }

		CustomWaveNumber 4
        CustomMaxWaveNumber 0

