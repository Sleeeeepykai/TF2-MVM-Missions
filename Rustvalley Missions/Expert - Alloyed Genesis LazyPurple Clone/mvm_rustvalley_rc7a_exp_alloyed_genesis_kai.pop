		// TIMED DISASTER //

		TimedDisasterPT
		{
			KeepAlive 1

			RemoveIfKilled "TimedDisasterAttackInit"

			OnParentKilledOutput
			{
				Target "TimedDisasterDeathPT"
				Action ForceSpawnAtEntityOrigin
				Param "TimedDisasterDeathSpawn"
				Delay -1
			}
			OnParentKilledOutput
			{
				Target "TimedDisasterAttackInit"
				Action Kill
				Delay 0.2
			}

			info_particle_system
            {
                "targetname" "TimedDisasterDeathSpawn"
                "effect_name" "mvm_tank_destroy_bloom"
            }

			// TITLE & MUSIC LOGIC //

			logic_relay
			{
				"targetname" "TimedDisasterIntroRelay"

				"OnTrigger" "TimedDisasterMusicIntroRelay,Trigger,,0,-1"
				"OnTrigger" "TimedDisasterTitleTextUpper,Display,,1.1,-1"
				"OnTrigger" "TimedDisasterTitleTextLower,Display,,2,-1"
			}

			game_text
			{
				"targetname" "TimedDisasterTitleTextUpper"
				"message" "REVENGE OF THE TICKING TIME BOMB"
				"channel" "1"
				"color" "255 255 255"

				"x" "-1"
				"y" "0.2"

				"effect" "2"
				"fxtime" "0.2"
				"holdtime" "5"
				"fadeout" "1"

				"spawnflags" "1"
			}
			game_text
			{
				"targetname" "TimedDisasterTitleTextLower"
				"message" "TIMED DISASTER"
				"channel" "2"
				"color" "255 255 255"

				"x" "-1"
				"y" "0.25"

				"effect" "2"
				"fadein" "0.2"
				"holdtime" "3.8"
				"fadeout" "1"

				"spawnflags" "1"
			}

			logic_relay
			{
				"targetname" "TimedDisasterMusicIntroRelay"
				"OnTrigger"	"TimedDisasterMusicIntro,PlaySound,,0,-1"
				"OnTrigger"	"TimedDisasterMusicIntro,StopSound,,8.9,-1"
				"OnTrigger" "TimedDisasterMusicLoopRelay,Trigger,,8.91,-1"

				"spawnflags" "2"
			}
			ambient_generic
			{
				"targetname" "TimedDisasterMusicIntro"
				"message" "#vstimeddisastersrevenge_intro.mp3"
				"health" "10"
				"pitch" "100"
				"spawnflags" "17"
			}

			logic_relay
			{
				"targetname" "TimedDisasterMusicLoopRelay"
				"OnTrigger"	"TimedDisasterMusicLoop,PlaySound,,0,-1"
				"OnTrigger"	"TimedDisasterMusicLoop,StopSound,,50.7,-1"
				"OnTrigger" "TimedDisasterMusicLoopRelay,Trigger,,50.705,-1"

				"spawnflags" "2"
			}
			ambient_generic
			{
				"targetname" "TimedDisasterMusicLoop"
				"message" "#vstimeddisastersrevenge.mp3"
				"health" "10"
				"pitch" "100"
				"spawnflags" "17"
			}

			// ATTACK POOL LOGIC //

			logic_relay
			{
				"targetname" "TimedDisasterAttackInit"
				"spawnflags" "2"

				"OnTrigger" "TimedDisasterAttackPool,PickRandomShuffle,,0,-1"
			}
			logic_case
			{
				"targetname" "TimedDisasterAttackPool"

				"OnCase01" "pop_interface,ChangeBotAttributes,TimedDisasterNuke,0,-1"
				"OnCase02" "pop_interface,ChangeBotAttributes,TimedDisasterGrenadeShotgun,0,-1"
				"OnCase03" "pop_interface,ChangeBotAttributes,TimedDisasterGrenadeShotgun2,0,-1"
				"OnCase04" "pop_interface,ChangeBotAttributes,TimedDisasterCannonSpray,0,-1"
				"OnCase05" "pop_interface,ChangeBotAttributes,TimedDisasterPillRain,0,-1"
				"OnCase06" "pop_interface,ChangeBotAttributes,TimedDisasterBigBombs,0,-1"
				"OnCase07" "pop_interface,ChangeBotAttributes,TimedDisasterBusterSpray,0,-1"
			}

			// NUKE ATTACK //

			logic_relay
			{
				"targetname" "TimedDisasterNukeRelay"

				"OnTrigger" "!activator,$Taunt,,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,megabuster_explode.mp3,0,-1"

				"OnTrigger" "TimedDisasterChargeParticle1,TurnOn,,1,-1"

				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 3, 3, 8, 50000, 0, true)2-1"

				"OnTrigger" "TimedDisasterChargeParticle2,TurnOn,,3.5,-1"

				"OnTrigger" "TimedDisasterChargeParticle3,TurnOn,,6,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 3, 3, 8, 50000, 0, true)6-1"

				"OnTrigger" "TimedDisasterNukeWeapon,FireOnce,,8.8,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 110, 0.7, 0.1, 1)9-1"
				"OnTrigger" "!activator,$RemoveCond,7,9.2,-1"
				"OnTrigger" "TimedDisasterChargeParticle*,TurnOff,,9.3,-1"

				"OnTrigger" "TimedDisasterAttackInit,Trigger,,11,-1"

				"spawnflags" "2"
			}

			tf_point_weapon_mimic
			{
				"targetname" "TimedDisasterNukeWeapon"
				"origin" "0 0 90"

				"teamnum" "3"
				"WeaponType" "3"
				"Damage" "99999"
				"SplashRadius" "99999"

				"$preventshootparent" "1"

				"$OnFire" "!self,DetonateStickies,,0,-1"
			}

			point_tesla
			{
				"targetname" "TimedDisasterChargeParticle1"
				"origin" "0 0 90"
				"texture" "sprites/physbeam.vmt"
				"m_Color" "255 240 170"
				"m_flRadius" "350"
				"beamcount_min" "1"
				"beamcount_max" "3"
