				"OnUser1" "MiniMechaMinerBurrowRelay,Trigger,,0,-1"
				"OnUser2" "MiniMechaMinerUnBurrowRelay,Trigger,,0,-1"
			}

			logic_relay
			{
				"targetname" "MiniMechaMinerBurrowRelay"

				"OnTrigger" "!activator,$PlaySequence,taunt_vehicle_allclass_start,0,-1"
				"OnTrigger" "!activator,$AddPlayerAttribute,no_attack|1,0,-1"

				"OnTrigger" "!activator,$ChangeAttributes,MechaMinerBurrow,1,-1"
				"OnTrigger" "!activator,$RemovePlayerAttribute,no_attack,1,-1"
				"OnTrigger" "MiniMechaMinerBurrowDust,Start,,1,-1"
				"OnTrigger" "!activatorRunScriptCodeEmitSoundEx({sound_name=`physics/concrete/concrete_break3.wav`,channel = 6, filter_type = 5, origin = self.GetOrigin()})1-1"
				"OnTrigger" "!activatorRunScriptCodeScreenShake(self.GetOrigin(), 6, 8, 0.5, 1000, 0, true)1-1"

				"OnTrigger" "MiniMechaMinerBurrowDust,Stop,,2,-1"
			}
			logic_relay
			{
				"targetname" "MiniMechaMinerUnBurrowRelay"

				"OnTrigger" "MiniMechaMinerBurrowDust,Start,,0,-1"
				"OnTrigger" "!activatorRunScriptCodeself.ApplyAbsVelocityImpulse(Vector(0,0,175))0-1"
				"OnTrigger" "!activatorRunScriptCodeEmitSoundEx({sound_name=`physics/concrete/concrete_break3.wav`,channel = 6, filter_type = 5, origin = self.GetOrigin()})0-1"
				"OnTrigger" "!activatorRunScriptCodeScreenShake(self.GetOrigin(), 6, 8, 0.5, 1000, 0, true)0-1"

				"OnTrigger" "!activator,$PlaySequence,airwalk_loser,0.015,-1"
				"OnTrigger" "MiniMechaMinerBurrowDust,Stop,,1,-1"
			}
		}

