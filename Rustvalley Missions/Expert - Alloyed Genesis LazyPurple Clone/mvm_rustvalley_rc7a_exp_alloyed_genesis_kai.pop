	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						PrecacheSound(`physics/concrete/concrete_break3.wav`)
						PrecacheSound(`music/mvm_lost_wave.wav`)

						PrecacheSound(`vo/mvm/norm/engineer_mvm_jeers01.mp3`)
						PrecacheSound(`vo/mvm/mght/soldier_mvm_m_jeers01.mp3`)
						PrecacheSound(`vo/mvm/mght/heavy_mvm_m_jeers01.mp3`)
						PrecacheSound(`vo/mvm/mght/pyro_mvm_m_jeers01.mp3`)
						PrecacheSound(`vo/mvm/mght/scout_mvm_m_jeers03.mp3`)
						PrecacheSound(`vo/mvm/norm/sniper_mvm_painsevere02.mp3`)

						PrecacheSound(`vo/mvm/mght/taunts/pyro_mvm_m_taunts04.mp3`)
						PrecacheSound(`vo/mvm/mght/pyro_mvm_m_paincrticialdeath01.mp3`)
						PrecacheSound(`ambient/explosions/explode_4.wav`)
						PrecacheSound(`vo/mvm/mght/soldier_mvm_m_laughhappy03.mp3`)
						PrecacheSound(`megalaser_chargeup.wav`)
						PrecacheSound(`vo/mvm/mght/heavy_mvm_m_meleedare13.mp3`)
						PrecacheSound(`vo/mvm/mght/heavy_mvm_m_laughevil03.mp3`)
						PrecacheSound(`mvm/mvm_deploy_giant.wav`)
						PrecacheSound(`vo/mvm/mght/scout_mvm_m_paincrticialdeath01.mp3`)

						IncludeScript(`tankextensions_main`)
                		IncludeScript(`tankextensions/gatetank`)
						IncludeScript(`tankextensions/hammertank`)
						IncludeScript(`tankextensions/targetank`)
						IncludeScript(`tankextensions/teletank`)

						IncludeScript(`claudz_logic_v3`)
					  "
			}

			game_round_win
			{
                "targetname" "RedLose"
                "classname" "game_round_win"
				"TeamNum" "3"
				"switch_teams" "0"
				"force_map_reset" "1"
			}
			logic_relay
			{
				"targetname" "RedLoseRelay"
				"OnTrigger" "RedLose,RoundWin,,0,-1"
                "startdisabled" "1"
			}

			math_counter
            {
                "targetname" "TeamWipeCounter"
                "startvalue" "0"
                "min" "0"
                "max" "99"

                "OutValue" "TeamWipeCompare,SetValueCompare,,0,-1"
            }
            logic_compare
            {
                "targetname" "TeamWipeCompare"
                "CompareValue" "0"

                "OnEqualTo" "TeamwipeLoseTimer,Enable,,0,-1"
                "OnGreaterThan" "TeamwipeLoseTimer,Disable,,0,-1"
            }
            logic_timer
			{
				"targetname" "TeamwipeLoseTimer"
				"RefireTime" "2.0"
				"StartDisabled" "1"
				"OnTimer" "TeamwipeLoseRelay,Trigger,,0,-1"
			}
			logic_relay
			{
				"targetname" "TeamwipeLoseRelay"
				"OnTrigger" "RedLose,RoundWin,,0,-1"
                "startdisabled" "1"
			}

			// Global Filters
			filter_multi
            {
                "targetname" "filter_redteam_nouber"
                "Negated" "0"
                "FilterType" "0"

				"Filter01" "filter_player"
                "Filter02" "filter_red"
                "Filter03" "filter_is_not_ubered"
                "Filter04" "filter_is_not_ubered2"
                "Filter05" "filter_is_not_ubered3"
                "Filter06" "filter_is_not_ubered4"
            }
			filter_multi
			{
				"targetname" "filter_redplayer"
				"Negated" "0"
                "FilterType" "0"

				"Filter01" "filter_player"
                "Filter02" "filter_red"
			}

			filter_activator_class
            {
                "targetname" "filter_player"
                "Negated" "0"
                "filterclass" "Player"
            }
			filter_tf_condition
            {
                "targetname" "filter_is_not_ubered"
                "Negated" "1"
                "condition" "5"
            }
            filter_tf_condition
            {
                "targetname" "filter_is_not_ubered2"
                "Negated" "1"
                "condition" "52"
            }
            filter_tf_condition
            {
                "targetname" "filter_is_not_ubered3"
                "Negated" "1"
                "condition" "51"
            }
			filter_tf_condition
            {
                "targetname" "filter_is_not_ubered4"
                "Negated" "1"
                "condition" "57"
            }
		}

		MissionPT
		{
			// Wave 2 End Sequence
			logic_relay
			{
				"targetname" "Wave2EndRelay"

				"OnTrigger" "Player,$DisplayTextChat,{99C2D8}???{reset}: ENGAGE PERIMETER SECURITY RELAYS,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,0,-1"
				"OnTrigger" "ambush_gate_a_enable,Trigger,,0,-1"
				"OnTrigger" "ambush_gate_b_enable,Trigger,,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave2_Subwave1_Spies,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave2_Subwave4_Spies,0,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave2_Subwave4_TheCrew,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave2_Subwave4_TheCrew,0,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_startup1.wav,2,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,4,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_top.wav,4.75,-1"
				"OnTrigger" "PlayerRunScriptCodeself.ViewPunch(QAngle(-30,-30,-30))4.751"

				"OnTrigger" "Wave2EndRelayStun,Enable,,5,-1"
				"OnTrigger" "Wave2EndRelayStun,Disable,,5.1,-1"
				"OnTrigger" "item_teamflag*,ForceResetSilent,,5,-1"
				"OnTrigger" "item_teamflag*,Disable,,5,-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`music/mvm_lost_wave.wav`,channel = 6, pitch = 60, filter_type = 5})01"
				"OnTrigger" "PlayerRunScriptCodeself.SetHudHideFlags(~132)5-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 64, 119, 158, 150, 0.9, 0.1, 1)51"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 0, 0, 0, 255, 7, 8, 2)5-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_shutdown1.wav,5,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,6,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,8,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_shutdown1.wav,8,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,10,-1"

				"OnTrigger" "tf_gamerules,PlayVO,ambient/machines/thumper_shutdown1.wav,11,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,12,-1"

				"OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,16,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,16.4,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,16.8,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,17.2,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,17.6,1"
                "OnTrigger"  "tf_gamerules,PlayVO,weapons/teleporter_receive.wav,18,1"

				"OnTrigger" "GottaSweepSweepSweep,Enable,,19,-1"
				"OnTrigger" "Player,$TeleportToEntity,red_spawn,19.1,-1"

				"OnTrigger" "Wave3PT,ForceSpawn,,20,-1"
				"OnTrigger" "obj_sentry*,RemoveHealth,99999,20,-1"
                "OnTrigger" "obj_teleporter*,RemoveHealth,99999,20,-1"
                "OnTrigger" "obj_dispenser*,RemoveHealth,99999,20,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 0, 0, 0, 255, 5, 0.1, 1)20-1"
				"OnTrigger" "PlayerRunScriptCodeself.RemoveHudHideFlags(~132)25-1"
				"OnTrigger" "GottaSweepSweepSweep,Disable,,25,-1"
			}
			trigger_stun
			{
				"targetname" "Wave2EndRelayStun"
				"filtername" "filter_red"
				"mins" "-6000 -6000 -6000"
				"maxs" "6000 6000 6000"
				"wait" "0.1"

				"stun_type" "2"
				"stun_duration" "15"
				"stun_effects" "0"
				"move_speed_reduction" "0"

				"spawnflags" "1"

				"disableshadows" "1"
				"startdisabled" "1"
			}
			trigger_hurt // Mapwide Bot Cleaner
            {
                "targetname" "GottaSweepSweepSweep"
				"filtername" "filter_blue"
                "mins" "-5000 -5000 -5000"
				"maxs" "5000 5000 5000"

                "damage" "3000000"
                "damagetype" "16"
                "spawnflags" "1"

				"disableshadows" "1"
				"startdisabled" "1"
            }

			// Finale
			logic_relay
			{
				"targetname" "FinaleSetupRelay"

				"OnTrigger" "BigNet,RunScriptCode,SetSkyboxTexture(`sky_day03_01`),0,-1"
				"OnTrigger" "RustvalleyStormCC,Enable,,0,-1"
				"OnTrigger" "skybox_revolving,Kill,,0,-1"
				"OnTrigger" "env_sun,Kill,,0,-1"
				"OnTrigger" "cap_b_trigtimer,AddOutput,OnCapTeam2 RedLoseRelay:Trigger::0:-1,0,-1"

				"OnTrigger" "FinaleWindSound,StopSound,,0,-1"
				"OnTrigger" "FinaleWindLoopRelay,Trigger,,0.1,-1"
			}
			color_correction
            {
                "targetname" "RustvalleyStormCC"

				"filename" "materials/colorcorrection/stormlight.raw"
                "maxweight" "1"

                "minfalloff" "-1"
                "maxfalloff" "-1"
                "fadeInDuration" "0"
                "fadeOutDuration" "0"
                "StartDisabled" "1"
            }
			logic_relay
            {
                "targetname" "FinaleWindLoopRelay"
                "spawnflags" "2"

                "OnTrigger" "FinaleWindSound,PlaySound,,0,-1"
                "OnTrigger" "FinaleWindSound,StopSound,,198.8,-1"
                "OnTrigger" "!self,Trigger,,198.8,-1"
            }
			ambient_generic
            {
                "targetname" "FinaleWindSound"
                "message" "fat_w7_wind.mp3"
				"health" "7"
                "spawnflags" "17"
            }

			logic_relay
            {
                "targetname" "timeforthefinaleboss"
                "OnTrigger" "PlayerRunScriptCodeScreenFade(null, 0, 0, 0, 255, 5, 0.4, 2)2-1"
            }

			ambient_generic
            {
                "targetname" "AlloyedGenesisMusic"
                "message" "#alloyed_genesis_placeholder.mp3"
                "health" "10"
                "pitch" "100"
                "spawnflags" "17"
            }
		}

		Wave3PT
		{
			RemoveIfKilled "RustvalleyNightCC"

			OnSpawnOutput
			{
				Target "Wave3SetupRelay"
				Action Trigger
			}

			logic_relay
			{
				"targetname" "Wave3SetupRelay"

				"OnTrigger" "Wave3MainBarrierPT,ForceSpawn,,0,-1"
				"OnTrigger" "Wave3SideBarrierPT,ForceSpawn,,0,-1"
				"OnTrigger" "Wave3FrontBarrierPT,ForceSpawn,,0,-1"
				"OnTrigger" "forcecapture_ab_relay,Trigger,,0,-1"
				"OnTrigger" "pathblocker_b,Disable,,0,-1"
				"OnTrigger" "pathblocker_a,Enable,,0,-1"
				"OnTrigger" "BigNet,RunScriptCode,SetSkyboxTexture(`sky_halloween`),0,-1"
				"OnTrigger" "RustvalleyNightCC,Enable,,0,-1"
				"OnTrigger" "RustvalleyFog,Enable,,0,-1"
				"OnTrigger" "skybox_revolving,Kill,,0,-1"
				"OnTrigger" "env_sun,Kill,,0,-1"

				"OnTrigger" "door_red_large_win_4,Lock,,0,-1"

				"OnTrigger" "cap_b_trigtimer,$SetKey$area_time_to_cap,40,0,-1"
