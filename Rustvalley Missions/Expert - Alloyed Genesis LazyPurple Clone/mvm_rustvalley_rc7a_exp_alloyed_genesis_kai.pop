		AlloyedGenesisPT
		{
			OnSpawnOutput
			{
				Target AlloyedGenesisTarget
				Action SetParent
				Param !activator
			}
			OnSpawnOutput
			{
				Target AlloyedGenesisGlow
				Action SetParent
				Param !activator
			}
			OnSpawnOutput
			{
				Target AlloyedGenesisHomingGauntlet
				Action SetParent
				Param !activator
			}

            OnSpawnOutput
            {
                Target "AlloyedGenesisFakeParentTarget"
                Action $SetFakeParent
                Param "!activator"
                Delay 0
            }
            OnSpawnOutput
            {
                Target "AlloyedGenesisFakeParentTarget"
                Action "SetParent"
                Param ""
                Delay 0
            }

			// CORE LOGIC //

			info_target
			{
				"targetname" "AlloyedGenesisTarget"
			}
			info_target
			{
				"targetname" "AlloyedGenesisFakeParentTarget"
				"$modules" "fakeparent"
                "$positiononly" "1"
			}
			tf_glow
            {
				"targetname" "AlloyedGenesisGlow"
				"target" "!parent"
                "GlowColor" "219 152 250 255"
            }

			// INTRO LOGIC //

			logic_relay
			{
				"targetname" "AlloyedGenesisBotIntroRelay"

				"OnTrigger" "!activator,$SetLocalOrigin,1442 -1322 600,0,-1"
				"OnTrigger" "!activator,Color,0 0 0,0,-1"
				"OnTrigger" "!activator,RunScriptCode,self.SetGravity(0.0001),0,-1"
				"OnTrigger" "AlloyedGenesisFormChangeRelay,Trigger,,0.1,-1"
				"OnTrigger" "!activatorRunScriptCodeCzUtil.KirbyBoss(self, function(){}, `bossbar1.wav`, 1)0.51"
				"OnTrigger" "AlloyedGenesisTitleTextUpper,Display,,0.5,-1"
				"OnTrigger" "AlloyedGenesisTitleTextLower,Display,,1.5,-1"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/pyro_mvm_m_laughevil04.mp3,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/pyro_mvm_m_laughevil04.mp3,2,-1"
				"OnTrigger" "!activator,$Addcond,87 6,2,-1"
				"OnTrigger" "!activator,$PlaySequence,taunt_flip_success_receiver,2,-1"

				"OnTrigger" "!activator,RunScriptCode,self.SetGravity(1),3,-1"

				"OnTrigger"	"tf_gamerules,PlayVO,ambient/explosions/explode_2.wav,4.5,-1"
				"OnTrigger" "AlloyedGenesisRingAttack,ForceSpawnAtEntityOrigin,!activator,4.5,-1"
				"OnTrigger" "AlloyedGenesisIntroExplosionDamage,FireOnce,,4.5,-1"
				"OnTrigger" "AlloyedGenesisIntroExplosion,Start,,4.5,-1"
				"OnTrigger" "AlloyedGenesisIntroExplosion,Stop,,4.7,-1"

				"OnTrigger" "!activator,$PlaySequence,run_melee,6,-1"

				"OnTrigger" "!activator,$ChangeAttributes,AlloyedGenesisIntroMegaLaser,6,-1"
				"OnTrigger" "Phase2TransitionRelay,Enable,,6,-1"
                "OnTrigger" "Phase3TransitionRelay,Enable,,6,-1"
			}

			game_text
			{
				"targetname" "AlloyedGenesisTitleTextUpper"
				"message" "THE SOURCE, THE HEART"
				"channel" "1"
				"color" "100 50 255"

				"x" "-1"
				"y" "0.2"

				"effect" "2"
				"fxtime" "0.2"
				"holdtime" "5"
				"fadeout" "1"

				"spawnflags" "1"
			}
			game_text
			{
				"targetname" "AlloyedGenesisTitleTextLower"
				"message" "THE ALLOYED GENESIS"
				"channel" "2"
				"color" "100 50 255"

				"x" "-1"
				"y" "0.25"

				"effect" "2"
				"fadein" "0.2"
				"holdtime" "3.8"
				"fadeout" "1"

				"spawnflags" "1"
			}

			info_particle_system
			{
				"targetname" "AlloyedGenesisIntroExplosion"
				"origin" "0 0 20"
				"effect_name" "cinefx_goldrush"
			}

			tf_point_weapon_mimic
			{
				"targetname" "AlloyedGenesisIntroExplosionDamage"
				"origin" "0 0 90"

				"teamnum" "3"
				"WeaponType" "3"
				"Damage" "500"
				"SplashRadius" "400"

				"$preventshootparent" "1"

				"$OnFire" "!self,DetonateStickies,,0,-1"
			}

			// MegaLaser Sequence

			logic_relay
			{
				"targetname" "AlloyedGenesisIntroMegaLaserRelay"

				"OnTrigger" "AlloyedGenesisBotProp,Enable,,0,-1"
				"OnTrigger" "AlloyedGenesisBotProp,SetAnimation,taunt02,0,-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/taunts/pyro_mvm_m_taunts04.mp3`, pitch = 50, special_dsp = 57, filter_type = 5})0-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/taunts/pyro_mvm_m_taunts04.mp3`, pitch = 50, special_dsp = 57, filter_type = 5})0-1"

				"OnTrigger" "!activator,$BotCommand,interrupt_action -pos 1442 -1322 600 -lookpos 1546 544 -154 -duration 12,1,1"
				"OnTrigger" "tf_gamerules,PlayVO,megalaser_chargeup.wav,1,-1"
				"OnTrigger" "AlloyedGenesisMegaLaserChargeParticle,Start,,1,-1"
				"OnTrigger" "AlloyedGenesisMegaLaserCharge,TurnOn,,1,-1"

				"OnTrigger" "AlloyedGenesisBotProp,SetPlaybackRate,0,1.5,-1"

				"OnTrigger" "!activator,$Addcond,87 11,2,-1"

				"OnTrigger" "AlloyedGenesisBotProp,SetPlaybackRate,1,5.3,-1"
				"OnTrigger" "AlloyedGenesisMegaLaserChargeParticle,Stop,,5.7,-1"
				"OnTrigger" "AlloyedGenesisMegaLaserCharge,TurnOff,,5.7,-1"

				"OnTrigger" "AlloyedGenesisBotProp,SetPlaybackRate,0,6,-1"
				"OnTrigger" "AlloyedGenesisMegaLaser,Enable,,6,-1"
				"OnTrigger" "AlloyedGenesisMegaLaserDamageDetector,$StartFiring,,6,-1"
				"OnTrigger" "AlloyedGenesisMegaLaserChargeParticle2,Start,,6,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 110, 0.7, 0.1, 1)6-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/pyro_mvm_m_paincrticialdeath01.mp3`, pitch = 50, special_dsp = 57, filter_type = 5})6-1"
				"OnTrigger" "tf_gamerules,PlayVO,megalaser_fire.wav,6,-1"

				"OnTrigger" "tf_gamerules,PlayVO,megalaser_fireloop.wav,6,-1"
                "OnTrigger" "tf_gamerules,PlayVO,megalaser_fireloop.wav,7.4,-1"
                "OnTrigger" "tf_gamerules,PlayVO,megalaser_fireloop.wav,8.8,-1"
                "OnTrigger" "tf_gamerules,PlayVO,megalaser_fireloop.wav,10.2,-1"

				"OnTrigger" "AlloyedGenesisMegaLaserRunScriptCodeself.SetModelScale(0,0.5)11-1"
				"OnTrigger" "AlloyedGenesisMegaLaserDamageDetector,$StopFiring,,11,-1"
                "OnTrigger" "tf_gamerules,$StopVO,megalaser_fireloop.wav,11,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/halloween/spell_spawn_boss_disappear.wav,11,-1"
				"OnTrigger" "AlloyedGenesisMegaLaserDamageTrigger,Disable,,11.1,-1"
				"OnTrigger" "AlloyedGenesisMegaLaserChargeParticle2,Stop,,11.5,-1"

				"OnTrigger" "AlloyedGenesisBotProp,SetPlaybackRate,1,12,-1"
				"OnTrigger" "AlloyedGenesisMegaLaser,Disable,,12,-1"
				"OnTrigger" "AlloyedGenesisLoseConditionTimer,Trigger,,12,-1"

				"OnTrigger" "AlloyedGenesisBotProp,SetAnimation,run_PRIMARY,12.95,-1"
				"OnTrigger" "AlloyedGenesisBotProp,Disable,,13,-1"
				"OnTrigger" "AlloyedGenesisAttackInit,Trigger,,13,-1"
			}

			prop_dynamic
            {
                "targetname" "AlloyedGenesisBotProp"
                "origin" "0 0 0"
                "model" "models/player/pyro.mdl"
                "modelscale" "2.5"
