			// PHASE 1 ATTACKS //

			// Obsolescence Stomp

			logic_relay
			{
				"targetname" "AlloyedGenesisObsolescenceStompRelay"

				"OnTrigger" "!activator,$Addcond,36 12,0,-1"
				"OnTrigger" "!activator,$PlaySequence,taunt_unleashed_rage_soldier,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_laughlong01.mp3,0,-1"

				"OnTrigger" "!activator,$PlaySequence,taunt_zoomin_broom_exit,2.5,-1"

				"OnTrigger" "ObsolescenceStompLaunch,Enable,,3.3,-1"
				"OnTrigger" "ObsolescenceStompLaunch,Disable,,3.4,-1"
				"OnTrigger" "StompParticle,Start,,3.3,-1"
				"OnTrigger" "!activatorRunScriptCodeEmitSoundEx({sound_name = `ambient/explosions/explode_4.wav`, channel = 6, sound_level = 100, origin = self.GetOrigin()})3-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 16, 5, 2, 50000, 0, true)3-1"

				"OnTrigger" "StompParticle,Stop,,3.5,-1"
				"OnTrigger" "!activator,$PlaySequence,run_primary,3.5,-1"

				"OnTrigger" "AlloyedGenesisAttackInit,Trigger,,12,-1"
			}

			trigger_multiple
			{
				"targetname" "ObsolescenceStompLaunch"
				"filtername" "filter_redplayer"

				"maxs" "2500 2500 400"
                "mins" "-2500 -2500 0"

				"spawnflags" "1"
				"startdisabled" "1"

				"OnStartTouch" "!activatorRunScriptCodeself.ApplyAbsVelocityImpulse(Vector(0,0,2000))0-1"
				"OnStartTouch" "!activatorRunScriptCodeself.AddCustomAttribute(`increased air control`,4,-1)0-1"
				"OnStartTouch" "!activatorRunScriptCodeself.RemoveCustomAttribute(`increased air control`)7-1"
				"OnStartTouch" "!activator,$AddCond,80,1,-1"
				"OnStartTouch" "!activator,$AddCond,125 7,1,-1"
			}

			info_particle_system
            {
                "targetname" "StompParticle"
                "effect_name" "hammer_impact_button"
            }
            info_particle_system
            {
                "targetname" "StompParticle"
                "effect_name" "hammer_impact_button_dust2"
            }

			// Overclocked Dave Homing Gauntlet

			tf_point_weapon_mimic
			{
				"targetname" "AlloyedGenesisHomingGauntlet"
				"origin" "0 20 100"
				"teamnum" "3"
				"$weaponname" "HomingGauntletWeapon"
			}

			// Trolldier

			logic_relay
			{
				"targetname" "AlloyedGenesisTrolldierSetupRelay"

				"OnTrigger" "!activator,$ChangeBotAttributes,AlloyedGenesisTrolldierPart3,15,-1"
			}

			logic_relay
			{
				"targetname" "AlloyedGenesisTrolldierHitRelay"

				"OnTrigger" "tf_gamerules,PlayVO,player/pl_impact_stun_range.wav,0,-1"
				"OnTrigger" "!activator,$ChangeAttributes,AlloyedGenesisTrolldierPart1,0,-1"
			}

			logic_relay
			{
				"targetname" "AlloyedGenesisTrolldierPart3Relay"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/soldier_mvm_m_laughhappy03.mp3`, channel = 6, pitch = 70, special_dsp = 57, filter_type = 5})0-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/soldier_mvm_m_laughhappy03.mp3`, channel = 6, pitch = 70, special_dsp = 57, filter_type = 5})0-1"

				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave4_TrolldierSummon,0,-1"
				"OnTrigger" "SummonSmokescreenParticle,Start,,0,-1"

				"OnTrigger" "pop_interface,$PauseWaveSpawn,Wave4_TrolldierSummon,0.1,-1"
				"OnTrigger" "SummonSmokescreenParticle,Stop,,0.1,-1"
			}

			info_particle_system
