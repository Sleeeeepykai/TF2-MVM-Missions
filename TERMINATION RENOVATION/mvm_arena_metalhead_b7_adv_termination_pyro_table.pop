        // Main Hailstorm Point Template
        boss_logic
        {
            NoFixUp 1
            OnSpawnOutput
            {
                Target "!activator"
                Action "RunScriptCode"
                Param  "
                self.Teleport(true, Vector(530, 0, -1020),false,QAngle(0,0,0),false,Vector(0,0,0))
                if((`HailstormIntroPlayed` in getroottable()) && ::HailstormIntroPlayed){
                    EntFire(`boss_intro_relay`,`trigger`,``,0.5)
                    EntFire(`main_door_2`,`unlock`)
                    EntFire(`main_door_2`,`open`,``,0.1)
                    EntFire(`dooralarm`,`playsound`,``,0,1)
                    EntFire(`dooralarm`,`playsound`,``,1,1)
                    EntFire(`dooralarm`,`playsound`,``,2,1)


                } else {
                    EntFire(`pop_interface`, `ChangeBotAttributes`, `HailstormPreIntro`, 0, null)
                    //Hailstorm.ChangeAttributes(`HailstormPreIntro`);
                }

                "
                Delay  0.2
            }

            trigger_stun
            {
                "targetname" "boss_stun"
                "origin"     "0 0 0"
                "mins"       "-100 -100 0"
                "maxs"       "100 100 100"
                "stun_type" "1"
                "move_speed_reduction" "0"
                "filtername" "filter_chief"
                "spawnflags" "1" //1: players; 64 everything
                "stun_effects" "0"
                "stun_duration" "0.6"
                "wait" "0.2"
                "StartDisabled" "1"
            }

            logic_relay
            {
                "targetname" "boss_intro_relay"
                "OnTrigger" "pop_interfaceRunScriptCodeHailstorm.ChangeAttributes(`HailstormIntroEvent`);0-1"
                "OnTrigger" "pop_interfaceRunScriptCodeCzUtil.LookAtPos(Hailstorm.Boss,Vector(-277, -3, -767),0,8);0-1"
                "OnTrigger"  "tf_gamerules,RunScriptCode,Hailstorm.StopTargeting(),14,-1"

                //"OnTrigger" "pop_interfaceRunScriptCodeHailstorm.ChangeAttributes(`IntermissionFire`);0-1"

                //FireStomp HailstormShootCoreTest
                "OnTrigger" "@p@boss_thingyRunScriptCodeCzUtil.KirbyBoss(self,function(){Hailstorm.ChangeAttributes(`FireStomp`)},`mvm/giant_heavy/giant_heavy_entrance.wav`)0.3-1" //Hailstorm.ChangeAttributes(`FireStomp`)
                "OnTrigger" "pop_interfaceRunScriptCodeCzUtil.MoveTo(Hailstorm.Boss, Vector(80, 0, -1023),10,false)0.2-1"
                //"OnTrigger" "pop_interfaceRunScriptCodeEntFire(`coreTimer`,`enable`);0-1"
                "OnTrigger" "pop_interfaceRunScriptCode::HailstormIntroPlayed <- true;5-1"
                "OnTrigger"  "bossSetupRelay,trigger,,0"
                "OnTrigger"  "pop_interface,$ResumeWavespawn,mainsupport,18,-1"
                "OnTrigger" "tf_gamerulesRunScriptCodeEntFire(`red_forward_spawn_enable`,`trigger`)0.2-1"

                "spawnflags" "1"
            }

            logic_relay
            {
                "targetname" "bossSetupRelay"
                "OnTrigger"  "introMus3*,FadeOut,3,0,-1"
                "OnTrigger"  "bossMus1,PlaySound,,3,-1"
                "OnTrigger"  "bossMus1,StopSound,,165.99,-1"
                "OnTrigger"  "bossMus1,PlaySound,,166,-1"

                "spawnflags" "1"
            }

