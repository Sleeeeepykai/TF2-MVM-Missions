					EntFire(`red_normal_mission_relay`, `Trigger`)
					EntFire(`RelayD`, `Trigger`)
					EntFire(`Wave4PT`, `ForceSpawn`)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_start_relay`, `Trigger`)
					EntFire(`Wave4StartRelay`, `Trigger`)
			 	  "
		}
		DoneOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_finished_relay`, `Trigger`)
				  "
		}

