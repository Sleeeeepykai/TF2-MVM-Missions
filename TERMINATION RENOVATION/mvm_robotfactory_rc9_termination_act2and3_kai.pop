				"x" "-1"
				"y" "0.45"
				"effect" "2"
				"color" "255 255 255"
				"fxtime" "0.05"
				"fadein" "0.05"
				"holdtime" "1.35"
				"fadeout" "0.2"
				"channel" "2"

				"spawnflags" "1"
			}

			prop_dynamic
            {
				"targetname" "ManufactoryDrillTank"
                "origin" "848 -287 336"
				"angles" "0 143 0"
                "model" "models/bots/boss_bot/drill_tank/drill_tank.mdl"
				"skin" "2"
                "solid" "6"

				"disableshadows" "1"
            }
            prop_dynamic
            {
                "targetname" "ManufactoryDrillTank"
				"origin" "838 -347 336"
				"angles" "0 143 0"
                "model" "models/bots/boss_bot/tank_track_l.mdl"
                "solid" "0"

				"disableshadows" "1"
            }
            prop_dynamic
            {
                "targetname" "ManufactoryDrillTank"
				"origin" "901 -259 336"
				"angles" "0 143 0"
                "model" "models/bots/boss_bot/tank_track_r.mdl"
                "solid" "0"

				"disableshadows" "1"
            }
		}

