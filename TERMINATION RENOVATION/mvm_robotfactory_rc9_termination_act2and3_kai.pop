	PrecacheSound "termination/act2/wave2-7/saxtonhalevoicelines/saxton_hale_intro.mp3"

	PrecacheSound "termination/act2/wave3-7/saxtonhalevoicelines/saxton_hale_drilltankstolen.mp3"
