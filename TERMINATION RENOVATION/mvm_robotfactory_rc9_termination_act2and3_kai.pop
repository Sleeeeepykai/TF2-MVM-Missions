	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`red_reverse_mission_relay`, `Trigger`)
					EntFire(`Wave2PT`, `ForceSpawn`)
					EntFire(`Wave2ControlPointPT`, `ForceSpawn`)

					Convars.SetValue(`tf_playergib`, 0)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`red_reverse_wave_start_relay`, `Trigger`)
					EntFire(`ActStartRelay`, `Trigger`)
				  "
		}
		DoneOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`red_reverse_wave_finished_relay`, `Trigger`)
				  "
		}

		CustomWaveNumber 2
		CustomMaxWaveNumber 7

