			{
				"targetname" "EngibotWorkbench"
				"origin" "1401 -3024 38"
				"angles" "0 -16 0"
				"model" "models/flags/scrap_metal_flag.mdl"
				"solid" "6"
			}

			logic_relay
			{
				"targetname" "SubwaveWarningRelay"
				"OnTrigger"	"tf_gamerules,PlayVO,mvm/mvm_warning.wav,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,mvm/mvm_warning.wav,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,0.05,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,0.75,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,1.45,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,2.15,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 0, 0, 20, 0.3, 0.25, 1)0.05-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 0, 0, 20, 0.3, 0.25, 1)0.75-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 0, 0, 20, 0.3, 0.25, 1)1.45-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 0, 0, 20, 0.3, 0.25, 1)2.15-1"
			}

			logic_relay
			{
				"targetname" "PayloadReadyRelay"

				"OnTrigger" "BigNet,RunScriptCode,TextualTimer.End(),0,1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 40, 16, 2, 50000, 0, true)0-1"
				"OnTrigger"	"tf_gamerules,PlayVO,misc/cp_harbor_blue_whistle.wav,0,-1"
				"OnTrigger" "PayloadEscortAnnotation,Show,,0,-1"
				"OnTrigger" "AustraliumTankPiece1,Kill,,0,-1"

				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave4_Subwave4_AustraliumTank,0,-1"
				"OnTrigger" "RedLoseRelay,Disable,,0,-1"
				"OnTrigger" "@p@EngiBotTarget,$Suicide,0.1,-1"
				"OnTrigger" "RedLoseRelay,Enable,,0,-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})51"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave4-7/saxtonhalevoicelines/saxton_hale_australiumtankready.mp3`,channel = 6,special_dsp = 55,filter_type=5})6.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave4-7/saxtonhalevoicelines/saxton_hale_australiumtankready.mp3`,channel = 6,special_dsp = 55,filter_type=5})6.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave4-7/saxtonhalevoicelines/saxton_hale_australiumtankready.mp3`,channel = 6,special_dsp = 55,filter_type=5})6.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Our Engibot's escorting the Australium! Keep Gray Mann's robots away from it while it gets to the elevator shaft!,6.4,-1"

				"OnTrigger" "Player,$DisplayTextHint,ESCORT YOUR ENGIBOT TO THE ELEVATOR,5,-1"
				"OnTrigger" "HUDHint,$SetKey$message,[OBJECTIVE] ESCORT YOUR ENGIBOT TO THE ELEVATOR,8,-1"
			}
			training_annotation
			{
				"targetname" "PayloadEscortAnnotation"
				"origin" "1254 -3185 285"
				"display_text" "The Australium Payload is ready to be escorted!"
				"lifetime" "10"
			}

			logic_relay
			{
				"targetname" "InterceptorMonorailDeployRelay"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_missile_explosion.wav,0,-1"
				"OnTrigger" "tank_boss*,RemoveHealth,10000,0,-1"
			}

			logic_relay
			{
				"targetname" "ElevatorDoorsRelay"

				"OnTrigger" "door_front_r,SetSpeed,60,0,-1"
				"OnTrigger" "door_front_l,SetSpeed,60,0,-1"
				"OnTrigger" "door_front_r,Open,,0.1,-1"
				"OnTrigger" "door_front_l,Open,,0.1,-1"
				"OnTrigger" "wave_finished_relay,Trigger,,5,-1"
				"OnTrigger" "pop_interface,PauseBotSpawning,,5,-1"
				"OnTrigger" "ElevatorAnnotation,Show,,10,-1"
			}
			training_annotation
			{
				"targetname" "ElevatorAnnotation"
				"origin" "407 1686 265"
				"display_text" "Get to the Elevator!"
				"lifetime" "5"
			}

			logic_relay
			{
				"targetname" "AustraliumTankElevatorRelay"

				"OnTrigger" "ElevatorCheck,Enable,,5,-1"
				"OnTrigger" "!activator,$SetLocalOrigin,456 1387 0,5,-1"
				"OnTrigger" "RedLoseRelay,Disable,,5,-1"
				"OnTrigger" "!activator,Kill,,5.1,-1"
				"OnTrigger" "Wave4ElevatorPT,ForceSpawn,,5.1,-1"
			}

		}
		Wave4TimerPT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`textualtimer_v3`)
						TextualTimer.SetParams({
							minutes = 4
							seconds = 00
							x = -1
							y = 0.77
							text_prepend = `PAYLOAD READY IN: `
							color = `0 255 255`
							relayname = `PayloadReadyRelay`
						})
					  "
			}
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						TextualTimer.Start()
					  "
				Delay 0.2
			}
		}
		Wave4AustraliumTankBuildPT
		{
			NoFixUp 1

			RemoveIfKilled "AustraliumTankPiece1"

			logic_relay
			{
				"targetname" "AustraliumTankBuildSequenceRelay"

