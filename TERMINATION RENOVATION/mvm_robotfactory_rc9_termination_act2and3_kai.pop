#base robot_standard.pop
#base robot_giant.pop

WaveSchedule
{
	StartingCurrency 2000
	RespawnWaveTime 1

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	WaveStartCountdown 3

	MaxRedPlayers 6
	AllowBotExtraSlots 1
	RobotLimit 40

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/effects/mvm_holograms/mvm_cappoint_hologram.mdl"
	PrecacheModel "models/effects/mvm_holograms/mvm_cappoint_hologram_onlyblue.mdl"

	PrecacheModel "models/flags/lava_canister.mdl"

	PrecacheModel "models/bots/boss_bot/drill_tank/drill_tank_termination.mdl"

	PrecacheModel "models/flags/scrap_metal_flag.mdl"

	PrecacheModel "models/robot_factory/australium_tank_build_chunk_1_build_chunk_1.mdl"
