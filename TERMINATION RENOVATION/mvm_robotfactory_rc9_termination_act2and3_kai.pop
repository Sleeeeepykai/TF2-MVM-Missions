	//// LUA SCRIPTS ////

	LuaScriptFile "tank_repair_script.lua"
	
	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// COSMETICS ////

		"VolatileBotBarrel"
		{
			OriginalItemName "Potato of Labor"

			"custom item model" "models/flags/lava_canister.mdl"
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination`)

						EntFire(`tube_bot_model`, `Kill`)

						IncludeScript(`music_system_ment`)
						PrecacheSound(`#termination/act2/wave2-7/music/termination_factory_intrusion_calm.wav`)
						PrecacheSound(`#termination/act2/wave2-7/music/termination_factory_intrusion.wav`)
						PrecacheSound(`#termination/act2/wave3-7/music/termination_rusty_yet_pristine.mp3`)
						PrecacheSound(`#termination/act2/wave4-7/music/termination_turning_point.wav`)

						MusicSystemMent.ResetAll()
						MusicSystemMent.HookByName(`bignet`)

						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankextensions/drilltank_watermine`)
					  "
			}

			point_populator_interface
            {
                "targetname" "pop_interface"
            }

			logic_timer
			{
				"targetname"    "RagdollRemover"
				"RefireTime"    "5"
				"OnTimer"       "tf_ragdoll*,Kill,,0,-1"
			}

			logic_timer
			{
				"targetname"    "HUDHintTimer"
				"RefireTime"    "2.0"
				"startdisabled" "1"

				"OnTimer" "HUDHint,ShowHudHint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "HUDHint"
				"message" ""
				"spawnflags" "1"
			}

			game_round_win
			{
				"targetname" "red_win"
				"TeamNum" "2"
				"switch_teams" "0"
				"force_map_reset" "1"
			}
			logic_relay
			{
				"targetname" "RedWinRelay"
				"OnTrigger" "red_win,RoundWin,,0,-1"
			}
            logic_relay
			{
				"targetname" "RedLoseRelay"
				"OnTrigger" "bots_win,RoundWin,,0,-1"
			}

			prop_dynamic // Thermal Pyro Model
			{
