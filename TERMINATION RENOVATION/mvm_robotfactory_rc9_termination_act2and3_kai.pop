				"disableshadows" "1"
			}

			item_ammopack_medium
            {
                "targetname" "ammo_pack1"
                "angles" "0 0 0"
                "origin" "960 -1510 -1"
            }
			item_ammopack_medium
            {
                "targetname" "ammo_pack1"
                "angles" "0 0 0"
                "origin" "353 -328 0"
