		Wave2TimerPT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`textualtimer_v3`)
						TextualTimer.SetParams({
							minutes = 4
							seconds = 00
							x = -1
							y = 0.77
							text_prepend = `APPREHENSION: `
							color = `0 255 255`
							relayname = `RedLoseRelay`
						})
					  "
			}
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						TextualTimer.Start()
					  "
				Delay 0.2
			}
		}
	}

