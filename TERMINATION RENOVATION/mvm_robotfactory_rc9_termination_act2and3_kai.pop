			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`red_reverse_mission_relay`, `Trigger`)
					EntFire(`cylindrical_upgrades_deploy_relay`, `Trigger`)
					EntFire(`Wave3PT`, `ForceSpawn`)
					EntFire(`Wave3SetupPT`, `ForceSpawn`)

					EntFire(`FriendlyEngibot`, `Kill`, null, 0.1)
					EntFire(`ControlPointMaster`, `Kill`, null, 0.1)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`red_reverse_wave_start_relay`, `Trigger`)
					EntFire(`Wave3StartRelay`, `Trigger`)
				  "
		}
		DoneOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_finished_relay`, `Trigger`)
				  "
		}

