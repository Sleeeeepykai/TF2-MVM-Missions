		//// Wave 4 PTs ////
		Wave4PT
		{
			NoFixUp 1

			RemoveIfKilled "EngibotWorkbench"

			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						EntFire(`Wave4SetupRelay`, `Trigger`)

						EntFire(`carrier_door_front_close_relay`, `Trigger`)

						EntFire(`obj_sentry*`, `RemoveHealth`, 99999)
						EntFire(`obj_dispenser*`, `RemoveHealth`, 99999)
						EntFire(`obj_teleporter*`, `RemoveHealth`, 99999)
					  "
			}

			logic_relay
			{
				"targetname" "Wave4SetupRelay"

				"OnTrigger" "BigNetRunScriptCodeNetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination - Industrial Sabotage`)0-1"
				"OnTrigger" "vault_door_open,Trigger,,0,-1"
				"OnTrigger" "HUDHintTimer,Disable,,0,-1"
				"OnTrigger" "HUDHint,HideHudHint,,0,-1"

				"OnTrigger" "tank_path_australium_14,AddOutput,OnPass ElevatorDoorsRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "tank_path_australium_16,AddOutput,OnPass AustraliumTankElevatorRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "tank_path_interceptor_monoraila_1,AddOutput,OnPass monorail_script:CallScriptFunction:SetMonorailTank():0:-1,0,-1"
				"OnTrigger" "tank_path_interceptor_monorailb_1,AddOutput,OnPass monorail_script:CallScriptFunction:SetMonorailTank():0:-1,0,-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})101"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave4-7/saxtonhalevoicelines/saxton_hale_graymannescape.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave4-7/saxtonhalevoicelines/saxton_hale_graymannescape.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave4-7/saxtonhalevoicelines/saxton_hale_graymannescape.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: How did you blokes let him get away?! Ugh no matter - we've got what we wanted; but you've got ten thousand tons of steel headed your way! Gear up and keep them off our Engibot!,11.4,-1"
			}
			logic_relay
			{
				"targetname" "Wave4StartRelay"

				"OnTrigger" "Player,$DisplayTextHint,PROTECT YOUR ENGIBOT,0,-1"
				"OnTrigger" "HUDHintTimer,Enable,,3,-1"
				"OnTrigger" "HUDHint,$SetKey$message,[OBJECTIVE] PROTECT YOUR ENGIBOT,3,-1"

				"OnTrigger" "BigNet,RunScriptCode,MusicSystemMent.SetMusicTrack(`#termination/act2/wave4-7/music/termination_turning_point.wav`),0,-1"
				"OnTrigger" "Wave4TimerPT,ForceSpawn,,0,-1"
				"OnTrigger" "Wave4AustraliumTankBuildPT,ForceSpawn,,0,-1"
				"OnTrigger" "RedLoseRelay,Enable,,0,-1"
				"OnTrigger" "carrier_door_front_open_relay,Trigger,,0,-1"
				"OnTrigger" "IncomingBombAnnotation,Show,,0,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 40, 16, 2, 50000, 0, true)0-1"
				"OnTrigger"	"tf_gamerules,PlayVO,mvm/mvm_warning.wav,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,mvm/mvm_warning.wav,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,misc/doomsday_lift_start.wav,1,1"
				"OnTrigger"	"tf_gamerules,PlayVO,misc/doomsday_lift_start.wav,1,1"
				"OnTrigger" "Player,$DisplayTextChat,{yellow}[ Now Playing: {6383ff} Turning Point - GoodBobFR {yellow}],6,-1"
				"OnTrigger" "EngineerPayloadAnnotation,Show,,10,-1"
			}
			training_annotation
			{
				"targetname" "IncomingBombAnnotation"
				"origin" "-1808 2636 209"
				"display_text" "The robots have brought in a bomb!"
				"lifetime" "5"
			}
