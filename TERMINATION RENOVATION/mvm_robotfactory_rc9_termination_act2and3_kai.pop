				"OnTrigger" "Player,$DisplayTextChat,{d9d9d9}Gray Mann{reset}: Wait we aren't conducting training. What's going on out there?!,5,-1"

				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/manhack_alert_pass1.wav,12,-1"
