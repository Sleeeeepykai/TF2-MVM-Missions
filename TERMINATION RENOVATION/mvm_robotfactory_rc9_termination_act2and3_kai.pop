		Wave2TimerPT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`textualtimer_v3`)
						TextualTimer.SetParams({
							minutes = 4
							seconds = 00
							x = -1
							y = 0.77
							text_prepend = `APPREHENSION: `
							color = `0 255 255`
							relayname = `RedLoseRelay`
						})
					  "
			}
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						TextualTimer.Start()
					  "
				Delay 0.2
			}
		}

		//// Wave 3 PTs ////
		Wave3PT
		{
			NoFixUp 1

			RemoveIfKilled "ManufactoryGenerator"

			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						EntFire(`Player`, `$TeleportToEntity`, `wave3forwardspawn`, 0.2)

						EntFire(`Wave3SetupRelay`, `Trigger`)

						EntFire(`carrier_door_front_close_relay`, `Trigger`)
						EntFire(`carrier_lift_raise_relay`, `Trigger`)
						EntFire(`container_lift_raise_relay`, `Trigger`)

						EntFire(`B1_wall_fix_relay`, `Trigger`)
						EntFire(`C1_wall_fix_relay`, `Trigger`)
						EntFire(`B1_wall_fix_relay`, `Trigger`, null, 0.2)
						EntFire(`C1_wall_fix_relay`, `Trigger`, null, 0.2)

						EntFire(`A_route_wall_2_fix_relay`, `Trigger`)
						EntFire(`A_route_wall_3_fix_relay`, `Trigger`)
						EntFire(`A_route_wall_4_fix_relay`, `Trigger`)

						EntFire(`A1_door_lock_relay`, `Trigger`)
						EntFire(`A2_door_lock_relay`, `Trigger`)
						EntFire(`B1_door_lock_relay`, `Trigger`, null, 1)
						EntFire(`C1_door_lock_relay`, `Trigger`, null, 1)

						EntFire(`bridge_flank_door_A_lock_relay`, `Trigger`)
						EntFire(`bridge_flank_door_B_lock_relay`, `Trigger`)
						EntFire(`bridge_flank_door_C_lock_relay`, `Trigger`)

						EntFire(`hatch_shortcut_A_fix_relay`, `Trigger`)
						EntFire(`hatch_shortcut_B_fix_relay`, `Trigger`)

						EntFire(`red_spawn_security_door`, `Close`)
						EntFire(`door_front_l`, `Close`)
						EntFire(`door_front_r`, `Close`)

						EntFire(`obj_sentry*`, `RemoveHealth`, 99999)
						EntFire(`obj_dispenser*`, `RemoveHealth`, 99999)
						EntFire(`obj_teleporter*`, `RemoveHealth`, 99999)
					  "
			}
			OnSpawnOutput
			{
				Target UpgradeStationEngibotWrench
				Action TurnOff
			}

			logic_relay
			{
				"targetname" "Wave3SetupRelay"

				"OnTrigger" "tank_path_drill_14,AddOutput,OnPass FirstWallBreakRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "tank_path_drill_15,AddOutput,OnPass !activator:SetSpeed:75:0:-1,0,-1"
				"OnTrigger" "tank_path_drill_17,AddOutput,OnPass SecondWallBreakRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "tank_path_drill_18,AddOutput,OnPass !activator:SetSpeed:83:0:-1,0,-1"
				"OnTrigger" "tank_path_drill_24,AddOutput,OnPass ThirdWallBreakRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "tank_path_drill_36,AddOutput,OnPass GeneratorBreakRelay:Trigger::0:-1,0,-1"
				"OnTrigger" "tank_path_drill_37,AddOutput,OnPass EscortVictoryRelay:Trigger::0:-1,0,-1"

				"OnTrigger" "wave3forwardspawn,Enable,,0,-1"
				"OnTrigger"	"red_spawn_point_rev,Disable,,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,player/sprayer.wav,0,-1"
				"OnTrigger" "ManufactoryDrillTankParticle,Start,,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,player/sprayer.wav,0.5,-1"
				"OnTrigger" "ManufactoryDrillTankParticle2,Start,,0.5,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,player/sprayer.wav,1.7,-1"
				"OnTrigger" "ManufactoryDrillTankParticle3,Start,,1.7,-1"

				"OnTrigger"	"tf_gamerules,PlayVO,ambient_mp3/walkway_move.mp3,2.5,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_battlecry06.mp3,5,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_laughhappy01.mp3,7.5,-1"
				"OnTrigger" "UpgradeStationEngibot,Enable,,7.5,-1"
				"OnTrigger" "UpgradeStationEngibotWrench,TurnOn,,7.5,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_goodjob01.mp3,10,-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})101"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave3-7/saxtonhalevoicelines/saxton_hale_drilltankstolen.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave3-7/saxtonhalevoicelines/saxton_hale_drilltankstolen.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave3-7/saxtonhalevoicelines/saxton_hale_drilltankstolen.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Great work gents! You've got yourself a mean machine of destruction here! You'll be committing some proper property damage and screwing up the security's power source to get that Australium!,11.4,-1"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Better make it quick before the geezer takes off with it!,28.4,-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave3-7/saxtonhalevoicelines/saxton_hale_drilltankhint.mp3`,channel = 6,special_dsp = 55,filter_type=5})37.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave3-7/saxtonhalevoicelines/saxton_hale_drilltankhint.mp3`,channel = 6,special_dsp = 55,filter_type=5})37.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave3-7/saxtonhalevoicelines/saxton_hale_drilltankhint.mp3`,channel = 6,special_dsp = 55,filter_type=5})37.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Psst - Engineer - you should take a hint from the Engibots. Your wrench will repair that tank as well as theirs do.,37.4,-1"
			}
