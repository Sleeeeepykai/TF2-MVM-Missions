		//// Wave 2 PTs ////
		Wave2PT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						//EntFire(`ElevatorSoundLoopRelay`, `Trigger`)

						EntFire(`carrier_lift_raise_relay`, `Trigger`)
						EntFire(`container_lift_raise_relay`, `Trigger`)

						EntFire(`B1_wall_fix_relay`, `Trigger`)
						EntFire(`C1_wall_fix_relay`, `Trigger`)
						EntFire(`B1_wall_fix_relay`, `Trigger`, null, 0.2)
						EntFire(`C1_wall_fix_relay`, `Trigger`, null, 0.2)

						EntFire(`A_route_wall_1_fix_relay`, `Trigger`)
						EntFire(`A_route_wall_2_fix_relay`, `Trigger`)
						EntFire(`A_route_wall_3_fix_relay`, `Trigger`)
						EntFire(`A_route_wall_4_fix_relay`, `Trigger`)

						EntFire(`B1_door_lock_relay`, `Trigger`)
						EntFire(`B1_door_lock_relay`, `Trigger`, null, 1)

						EntFire(`bridge_flank_door_A_lock_relay`, `Trigger`)
						EntFire(`bridge_flank_door_B_lock_relay`, `Trigger`)
						EntFire(`bridge_flank_door_C_lock_relay`, `Trigger`)

						EntFire(`hatch_shortcut_A_fix_relay`, `Trigger`)
						EntFire(`hatch_shortcut_B_fix_relay`, `Trigger`)

						EntFire(`red_spawn_security_door`, `Close`)
					  "
			}

			logic_relay // Elevator Sound Loop
			{
				"targetname" "ElevatorSoundLoopRelay"

				"OnTrigger"	"tf_gamerules,PlayVO,plats\skylift_move.wav,0,-1"
                "OnTrigger"	"tf_gamerules,$StopVO,plats\skylift_move.wav,7.59,-1"
                "OnTrigger" "ElevatorSoundLoopRelay,Trigger,,7.595,-1"

                "spawnflags" "2"
			}

			logic_auto
			{
				"targetname" "Wave2ExtraSetup"

				"OnMapSpawn" "ControlPointACaptureArea,SetControlPoint,ControlPointA,0,-1"
				"OnMapSpawn" "ControlPointBCaptureArea,SetControlPoint,ControlPointB,0,-1"
				"OnMapSpawn" "ControlPointCCaptureArea,SetControlPoint,ControlPointC,0,-1"
			}

			prop_dynamic
			{
				"targetname" "FriendlyEngibot"
				"origin" "308 2004 0"
				"angles" "0 270 0"
				"model" "models/bots/engineer/bot_engineer.mdl"
				"defaultanim" "selectionmenu_idle"
			}
			prop_dynamic_ornament
			{
				"targetname" "FriendlyEngibotWrench"
				"InitialOwner" "FriendlyEngibot"
				"model" "models/weapons/c_models/c_wrench/c_wrench.mdl"
			}

			logic_relay
			{
				"targetname" "ActStartRelay"

				"OnTrigger" "ElevatorSoundLoopRelay,Disable,,0,-1"
				"OnTrigger"	"tf_gamerules,$StopVO,plats/skylift_move.wav,0,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 40, 16, 2, 50000, 0, true)0-1"
				"OnTrigger"	"tf_gamerules,PlayVO,plats/hall_elev_stop.wav,0,-1"
				"OnTrigger"	"tf_gamerules,PlayVO,plats/hall_elev_stop.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,termination/act2/wave2-7/vox/termination_vox_subsurface.mp3,1,1"
				"OnTrigger" "door_front_l,SetSpeed,50,4,1"
				"OnTrigger" "door_front_r,SetSpeed,50,4,1"
				"OnTrigger" "door_front_l,Open,,4.1,1"
				"OnTrigger" "door_front_r,Open,,4.1,1"
				"OnTrigger"	"tf_gamerules,PlayVO,doors/door_metal_large_open1.wav,4.1,1"
				"OnTrigger"	"tf_gamerules,PlayVO,doors/door_metal_large_open1.wav,4.1,1"
				"OnTrigger" "ActIntroCardUpper,Display,,5,-1"
				"OnTrigger" "ActIntroCardLower,Display,,6,-1"
				"OnTrigger" "Player,$DisplayTextChat,{yellow}[ Now Playing: {6383ff} Factory Intrusion - GoodBobFR {yellow}],6,-1"
				"OnTrigger" "BigNet,RunScriptCode,MusicSystemMent.SetMusicTrack(`#termination/act2/wave2-7/music/termination_factory_intrusion_calm.wav`),6,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_specialcompleted06.mp3,7.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_specialcompleted06.mp3,7.5,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})101"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave2-7/saxtonhalevoicelines/saxton_hale_intro.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave2-7/saxtonhalevoicelines/saxton_hale_intro.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Now that upper security is smashed to bits you boys have a job to do messing up lower security!,11.4,-1"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Intel's shown us one of {d9d9d9}Gray Mann{reset}'s Drill Tanks is lyin' around here so you're gonna get your hands on it.,20.4,-1"
				"OnTrigger" "Player,$DisplayTextHint,FIND A WAY TO REACH THE DRILL TANK,25,1"
				"OnTrigger" "HUDHint,$SetKey$message,[OBJECTIVE] ACQUIRE THE DRILL TANK,28,-1"
				"OnTrigger" "HUDHintTimer,Enable,,28,-1"
			}

			game_text
			{
				"targetname" "ActIntroCardUpper"
				"message" "ACT 2"
				"x" "-1"
				"y" "0.4"
				"effect" "0"
				"color" "255 255 255"
				"fadein" "0.5"
				"holdtime" "3"
				"fadeout" "0.2"
