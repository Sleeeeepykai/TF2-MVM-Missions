				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act2/wave2-7/graymannvoicelines/gray_mann_controlpointa2.mp3`,channel = 6,special_dsp = 57,filter_type=5})171"
				"OnTrigger" "Player,$DisplayTextChat,{d9d9d9}Gray Mann{reset}: Attention all personnel! We have intruders on Mann Co.'s property - my property!,17,-1"
