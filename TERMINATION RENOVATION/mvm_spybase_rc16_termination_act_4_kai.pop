				"OnTrigger" "!activatorRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro1.mp3`,channel = 6,special_dsp = 55,filter_type=4,entity=activator})4.41"
				"OnTrigger" "!activator,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Great work taking out that prototype! I don't think {d9d9d9}Gray Mann{reset}'s got anything up his sleeve now.,4.4,-1"

				"OnTrigger" "!activatorRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro2.mp3`,channel = 6,special_dsp = 55,filter_type=4,entity=activator})14.41"
				"OnTrigger" "!activatorRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro2.mp3`,channel = 6,special_dsp = 55,filter_type=4,entity=activator})14.41"
