				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_blastdoor.mp3`,channel = 6,special_dsp = 55,filter_type=5})8.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_blastdoor.mp3`,channel = 6,special_dsp = 55,filter_type=5})8.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_blastdoor.mp3`,channel = 6,special_dsp = 55,filter_type=5})8.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: That door's not gonna budge Mercs! We need some real brute force here!,8.4,-1"

