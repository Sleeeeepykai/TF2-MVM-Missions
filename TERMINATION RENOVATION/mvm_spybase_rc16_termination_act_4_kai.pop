		//// WAVE 7 PTs ////

		Wave7PT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`textualtimer_v3`)
						TextualTimer.SetParams({
							minutes = 7
							seconds = 30
							x = -1
							y = 0.77
							text_prepend = `ROCKET FUELING: `
							color = `0 255 255`
							relayname = `HoldoutVictoryRelay`
						})
					  "
			}

			logic_relay
			{
				"targetname" "Wave7SetupRelay"

				"OnTrigger" "silo_door_close,Trigger,,0,-1"
				"OnTrigger" "BigNetRunScriptCodeNetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination - Total Teardown`)0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})31"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave7-7/saxtonhalevoicelines/saxton_hale_rocketfuelling.mp3`,channel = 6,special_dsp = 55,filter_type=5})4.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave7-7/saxtonhalevoicelines/saxton_hale_rocketfuelling.mp3`,channel = 6,special_dsp = 55,filter_type=5})4.41"
