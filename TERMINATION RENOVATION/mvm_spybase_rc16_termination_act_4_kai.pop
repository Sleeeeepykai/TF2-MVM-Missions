				"OnTrigger" "!activator,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: It'll be smooth sailing from here! With this Australium we'll load it onto that ol' rocket on the other end and send it packing to a safe location.,14.4,-1"
			}
