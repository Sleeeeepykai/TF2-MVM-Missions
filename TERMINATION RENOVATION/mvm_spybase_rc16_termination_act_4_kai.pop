					WeaponSwitch
					{
						Type "Melee"
						Delay 0
						Repeats 1
						Cooldown -1
					}

					InterruptAction
					{
						Target "australiumtank"
						AimTarget "australiumtank"
						Delay 5
						Duration 6
						Repeats 1
						Cooldown -1  
					}

					FireInput
