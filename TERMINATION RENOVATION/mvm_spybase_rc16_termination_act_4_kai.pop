				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/graymannvoicelines/gray_mann_aftermath.mp3`,channel = 6,special_dsp = 57,filter_type=5})51"
				"OnTrigger" "Player,$DisplayTextChat,{d9d9d9}Gray Mann{reset}: ARGH! Not even my Patrol Chiefs could stop you?! Fine. If these robots won't do the job then I'll do it myself. Send out the rest of them at once!,5,-1"

