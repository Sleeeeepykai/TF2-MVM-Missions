#base robot_standard.pop
#base robot_giant.pop

WaveSchedule
{
	StartingCurrency 4800
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15

	WaveStartCountdown 3

	MaxRedPlayers 6
	AllowBotExtraSlots 1
	RobotLimit 40

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/robot_factory/australium_tank.mdl"
	PrecacheModel "models/props_tumb/mvm/tank_shield.mdl"
	PrecacheModel "models/props_mvm/no_entry.mdl"

	PrecacheModel "models/bots/heavy_boss/bot_heavy_boss_gibby.mdl"

	// Precached Sounds //

	// VOX

	// Saxton Hale Voicelines
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro1.mp3"
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro2.mp3"
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro3.mp3"

	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs.mp3"
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs2.mp3"

	// Gray Mann Voicelines
	PrecacheSound "termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs.mp3"
	PrecacheSound "termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs2.mp3"

	// SFX
	PrecacheSound "termination/act4/wave6-7/sfx/patrol_chief_beam.mp3"

	// Music
	PrecacheSound "termination/act4/wave6-7/music/termination_hurricane_of_power.wav"
	PrecacheSound "termination/act4/wave7-7/music/termination_t_minus.mp3"

	//// DISABLED SOUNDS ////

	//// LUA SCRIPTS ////

	LuaScriptFile "tank_repair_script.lua"

	//// CUSTOM WEAPONS ////

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination`)

						EntFire(`sky_sunset_relay`, `Trigger`)

						IncludeScript(`music_system_ment`)
						PrecacheSound(`#termination/act4/wave6-7/music/termination_hurricane_of_power.wav`)
						PrecacheSound(`#termination/act4/wave7-7/music/termination_t_minus.mp3`)

						MusicSystemMent.ResetAll()
						MusicSystemMent.HookByName(`bignet`)

						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankextensions/combattank`)
						IncludeScript(`tankextensions/combattank_weapons/minigun`)
						IncludeScript(`tankextensions/combattank_weapons/rocketpod`)
						IncludeScript(`tankextensions/combattank_weapons/fireball`)
						IncludeScript(`tankextensions/combattank_weapons/railgun`)
						IncludeScript(`tankextensions/drilltank_watermine`)
					  "
			}
			
			point_populator_interface
            {
                "targetname" "pop_interface"
            }

			logic_timer
			{
				"targetname"    "RagdollRemover"
				"RefireTime"    "5"
				"OnTimer"       "tf_ragdoll*,Kill,,0,-1"
			}
			logic_timer
			{
				"targetname" "MissionAlarmTimer"
				"RefireTime" "60"

				"OnTimer" "tf_gamerules,PlayVO,ambient/alarms/citadel_alert_loop2.wav,0.1,-1"
				"OnTimer" "tf_gamerules,$StopVO,ambient/alarms/citadel_alert_loop2.wav,6,-1"
			}

			logic_timer
			{
				"targetname"    "HUDHintTimer"
				"RefireTime"    "2.0"
				"startdisabled" "1"

				"OnTimer" "HUDHint,ShowHudHint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "HUDHint"
				"message" ""
				"spawnflags" "1"
			}

            logic_relay
			{
				"targetname" "RedLoseRelay"
				"OnTrigger" "bots_win,RoundWin,,0,-1"
			}
		}

		//// WAVE 6 PTs ////

		Wave6PT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						EntFire(`Player`, `$TeleportToEntity`, `lift_red_spawn`)

						EntFire(`ActSetupRelay`, `Trigger`)

						EntFire(`lift_spawn_set_team_red`, `Trigger`)
						EntFire(`red_lift_door_left_trigger`, `Disable`, null, 0.02)
						EntFire(`red_lift_door_right_trigger`, `Disable`, null, 0.02)
						EntFire(`lift_door_left`, `Close`, null, 0.2)
						EntFire(`lift_door_right`, `Close`, null, 0.2)

						EntFire(`rocket_spawn_set_team_blu`, `Trigger`)

						EntFire(`01_door_lock_relay`, `Trigger`)

						EntFire(`carrier_lift`, `SetSpeed`, 99999)
						EntFire(`carrier_lift_lower_relay`, `Trigger`)
					  "
			}

			logic_relay
			{
				"targetname" "ActSetupRelay"

				"OnTrigger" "tank_path_australium_9,AddOutput,OnPass FirstPatrolChiefAmbushRelay:Trigger::0:-1,0,-1"
			}

			logic_relay
			{
				"targetname" "ActStartRelay"

				"OnTrigger" "BigNet,RunScriptCode,MusicSystemMent.SetMusicTrack(`#termination/act4/wave6-7/music/termination_hurricane_of_power.wav`),0,-1"
				"OnTrigger" "Player,$DisplayTextChat,{yellow}[ Now Playing: {6383ff} Hurricane of Power - GoodBobFR {yellow}],0,-1"

				"OnTrigger" "AustraliumTankProp,Kill,,0,-1"

				"OnTrigger" "lift_door_left,Open,,0,-1"
				"OnTrigger" "lift_door_right,Open,,0,-1"

				"OnTrigger" "red_lift_door_left_trigger,Enable,,5,-1"
				"OnTrigger" "red_lift_door_right_trigger,Enable,,5,-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})51"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro3.mp3`,channel = 6,special_dsp = 55,filter_type=5})6.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro3.mp3`,channel = 6,special_dsp = 55,filter_type=5})6.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro3.mp3`,channel = 6,special_dsp = 55,filter_type=5})6.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: This was too easy. He practically handed it to us on a silver platter! You lot have thinned out his numbers so the rest of this should be a cakewalk.,6.4,-1"
			}

			logic_relay
			{
				"targetname" "FirstPatrolChiefAmbushRelay"

				"OnTrigger" "shortcut_bridge_retract_relay,Trigger,,0,-1"
				"OnTrigger" "carrier_lift_raise_relay,Trigger,,0,-1"
				"OnTrigger" "carrier_door_front,SetAnimation,open,,0,-1"
				"OnTrigger" "carrier_door_closed_collision,Disable,,0,-1"
				"OnTrigger" "carrier_door_open_collision,Enable,,0,-1"
				"OnTrigger" "vanilla_flank,Enable,,0,-1"

				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/manhack_alert_pass1.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/manhack_alert_pass1.wav,0,-1"
				"OnTrigger" "!activator,SetSpeed,50,1,-1"
				"OnTrigger" "!activator,SetSpeed,37.5,1.5,-1"
				"OnTrigger" "!activator,SetSpeed,23,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_negativevocalization02.mp3,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_negativevocalization02.mp3,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,npc/combine_gunship/ping_patrol.wav,3,1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 5, 8, 2, 50000, 0, true)3-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs.mp3`,channel = 6,special_dsp = 57,filter_type=5})51"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs.mp3`,channel = 6,special_dsp = 57,filter_type=5})51"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs.mp3`,channel = 6,special_dsp = 57,filter_type=5})51"
				"OnTrigger" "Player,$DisplayTextChat,{d9d9d9}Gray Mann{reset}: Don't get your hopes up mercenaries! I told you - you won't leave this facility alive!,5,-1"
				"OnTrigger" "Player,$DisplayTextChat,{d9d9d9}Gray Mann{reset}: Obliterate them Patrol Chiefs!,13,-1"

				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave6_Subwave1_HeavyPatrolChief,15,-1"
				"OnTrigger" "01_door_unlock_relay,Trigger,,15,-1"
				"OnTrigger" "!activator,SetSpeed,0,15,-1"
				"OnTrigger" "!activator,SetSpeed,75,20,-1"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_negativevocalization05.mp3,17,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_negativevocalization05.mp3,17,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})171"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs.mp3`,channel = 6,special_dsp = 55,filter_type=5})18.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs.mp3`,channel = 6,special_dsp = 55,filter_type=5})18.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs.mp3`,channel = 6,special_dsp = 55,filter_type=5})18.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: You're telling me he has more?!,18.4,-1"

				"OnTrigger" "ActIntroCardUpper,Display,,17,-1"
				"OnTrigger" "ActIntroCardLower,Display,,18,-1"
				"OnTrigger" "BigNetRunScriptCodeNetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination - Total Teardown`)18-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs2.mp3`,channel = 6,special_dsp = 57,filter_type=5})281"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs2.mp3`,channel = 6,special_dsp = 57,filter_type=5})281"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs2.mp3`,channel = 6,special_dsp = 57,filter_type=5})281"
				"OnTrigger" "Player,$DisplayTextChat,{d9d9d9}Gray Mann{reset}: You will not escape my grasp! That Australium is mine!,28,-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})351"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs2.mp3`,channel = 6,special_dsp = 55,filter_type=5})36.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs2.mp3`,channel = 6,special_dsp = 55,filter_type=5})36.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs2.mp3`,channel = 6,special_dsp = 55,filter_type=5})36.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Those Patrol Chiefs are screwing up the tank's mobility! Take them down! They will not stop us! Not when we're this close!,36.4,-1"
			}

			game_text
			{
				"targetname" "ActIntroCardUpper"
				"message" "ACT 4"
				"x" "-1"
				"y" "0.4"
				"effect" "0"
				"color" "255 255 255"
				"fadein" "0.5"
				"holdtime" "3"
				"fadeout" "0.2"
				"channel" "1"

				"spawnflags" "1"
			}
			game_text
			{
				"targetname" "ActIntroCardLower"
				"message" "TOTAL TEARDOWN"
				"x" "-1"
				"y" "0.45"
				"effect" "2"
				"color" "255 255 255"
				"fxtime" "0.05"
				"fadein" "0.05"
				"holdtime" "1.75"
				"fadeout" "0.2"
				"channel" "2"

				"spawnflags" "1"
			}
		}

		Wave6AustraliumTankPT
