		//// PLAYER PTs ////

		PlayerVoicelinePT
		{
			OnSpawnOutput
			{
				Target Act4IntroVoicelineRelay
				Action Trigger
				Delay 3
			}

			logic_relay
			{
				"targetname" "Act4IntroVoicelineRelay"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro1.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro1.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro1.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Great work taking out that prototype! I don't think Gray Mann's got anything up his sleeve now.,1.4,-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro2.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro2.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro2.mp3`,channel = 6,special_dsp = 55,filter_type=5})11.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: It'll be smooth sailing from here! With this Australium we'll load it onto that ol' rocket on the other end and send it packing to a safe location.,11.4,-1"
			}
		}

		//// ROBOT PTs ////

		// Australium Tank
		AustraliumTankPT
		{
			prop_dynamic
			{
				"targetname" "AustraliumTankBeamPoint"
				"origin" "0 0 120"
                "model" "models/empty.mdl"
			}

			logic_relay
			{
				"targetname" "PatrolChiefBeamReleaseRelay"

				"OnTrigger" "tf_gamerules,PlayVO,misc/halloween/spell_spawn_boss_disappear.wav,0,-1"
				"OnTrigger" "AustraliumTankBeamEffect,$SetKey$renderfx,6,0,-1"
				"OnTrigger" "AustraliumTankBeamEffect,Disable,,1.5,-1"
				"OnTrigger" "AustraliumTankBeamEffect,$SetKey$renderfx,24,1.5,-1"
				"OnTrigger" "australiumtank,SetSpeed,60,1.5,-1"
			}

			prop_dynamic
			{
				"targetname" "AustraliumTankBeamEffect"
				"origin" "0 0 0"
				"model" "models/props_tumb/mvm/tank_shield.mdl"
				"rendercolor" "0 0 0"
				"renderfx" "24"

				"disableshadows" "1"
				"startdisabled" "1"
			}
			dispenser_touch_trigger
			{
				"targetname" "AustraliumTankDispenserZone"
				"mins" "-300 -200 -60"
				"maxs" "300 200 60"
			}
			mapobj_cart_dispenser
			{
				"targetname" "AustraliumTankDispenser"
				"TeamNum" "2"
				"touch_trigger" "AustraliumTankDispenserZone"
			}
		}

		// Patrol Chief Heavy
		PatrolChiefHeavyPT
		{
			OnParentKilledOutput
			{
				Target "BeamReleaseRelay"
				Action Trigger
			}

			logic_relay
			{
				"targetname" "PatrolChiefHeavyBeamRelay"
				
				"OnTrigger" "PatrolChiefHeavyBeamSustainRelay,Trigger,,0,-1"
				"OnTrigger" "australiumtank,SetSpeed,5,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,termination/act4/wave6-7/sfx/patrol_chief_beam.mp3,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/powerup_pickup_supernova.wav,0,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 5, 5, 2, 50000, 0, true)0-1"
				"OnTrigger" "AustraliumTankBeamEffect,Enable,,0,-1"
				"OnTrigger" "!activator,$PlaySequence,taunt_burstchester_heavy,0,-1"
				"OnTrigger" "!activator,$PlaySequence,run_PRIMARY,2,-1"
			}
			logic_relay
			{
				"targetname" "PatrolChiefHeavyBeamSustainRelay"
				"OnTrigger" "PatrolChiefHeavyBeam,StrikeOnce,,0,-1"
				"OnTrigger" "PatrolChiefHeavyBeamSustainRelay,Trigger,,0.15,-1"
				"spawnflags" "2"
			}

			env_beam
			{
				"targetname" "PatrolChiefHeavyBeam"
				"origin" "0 0 140"
				"LightningStart" "PatrolChiefHeavyBeamStart"
				"LightningEnd" "AustraliumTankBeamPoint"
				"texture" "sprites/laserbeam.spr"
				"BoltWidth" "10"
				"life" "0.16"
				"renderamt" "200"
				"rendercolor" "200 200 255"
				"NoiseAmplitude" "1"
				"spawnflags" "96"
			}
			prop_dynamic
            {
                "targetname" "PatrolChiefHeavyBeamStart"
				"origin" "0 0 120"
                "model" "models/empty.mdl"
            }
		}
	}

