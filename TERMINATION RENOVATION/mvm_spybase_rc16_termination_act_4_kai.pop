	//// MISSION BOTS ////

	//// WAVES ////

	Wave
	{
		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`Wave6PT`, `ForceSpawn`)
					EntFire(`Wave6AustraliumTankPT`, `ForceSpawn`)

					IncludeScript(`claudz_logic_v3`)

					Convars.SetValue(`tf_playergib`, 0)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`ActStartRelay`, `Trigger`)
					EntFire(`carrier_lift`, `SetSpeed`, 100)

					EntFire(`Wave6PlayerBarrierPT`, `ForceSpawn`)
					EntFire(`Wave6BotBarrierPT`, `ForceSpawn`)
				  "
		}
		DoneOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_finished_relay`, `Trigger`)
				  "
		}

		CustomWaveNumber 6
        CustomMaxWaveNumber 7

		// Subwave 1
		WaveSpawn // 1 Australium Tank
		{
			Name "Wave6_Subwave1_AustraliumTank"
			Support Limited
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0

			FirstSpawnWarningSound "mvm/mvm_tank_start.wav"

			Tank
			{
				Template Tank_Australium
				Health 30000
				Speed 60
				StartingPathTrackNode "tank_path_australium_1"
			}
		}

