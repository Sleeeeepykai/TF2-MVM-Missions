		AustraliumTankGasCanCounterPT
		{
			RemoveIfKilled "GasCanCounter"

			logic_relay
			{
				"targetname" "AustraliumTankTurboChargeObjectiveRelay"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_turbocharge.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_turbocharge.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_turbocharge.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Now that's what we're looking for! That gas will turbo-charge the Australium Tank! We'll need a lot of that stuff to juice up this tank and PUNCH that door wide open!,1.4,-1"

				"OnTrigger" "Player,$DisplayTextHint,TURBO-CHARGE THE AUSTRALIUM TANK,10,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave6_Subwave4_Trigger,10,-1"
