		InitWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`bombpath_right_relay`, `Trigger`)

					EntFire(`Wave7PT`, `ForceSpawn`)
					EntFire(`Wave7SetupRelay`, `Trigger`)

					EntFire(`ActSetupRelay`, `Kill`)
					EntFire(`RocketTerminalButton`, `Kill`)
				  "
		}
		StartWaveOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_start_relay`, `Trigger`)
					EntFire(`Wave7StartRelay`, `Trigger`)
				  "
		}
		DoneOutput
		{
			Target BigNet
			Action RunScriptCode
			Param "
					EntFire(`wave_finished_relay`, `Trigger`)
				  "
		}

