		// Gas Can
		BotGasCanPT
		{
			KeepAlive 1

			OnParentKilledOutput
			{
				Target GasCan
				Action Enable
			}
			OnParentKilledOutput
			{
				Target GasCan
				Action SetTeam
				Param 3
			}
			OnParentKilledOutput
			{
				Target GasCanGlow
				Action Enable
			}

			item_teamflag
			{
				"targetname" "GasCan"
				"origin" "0 0 15"
				"angles" "-90 0 0"
				"flag_model" "models/weapons/c_models/c_gascan/c_gascan.mdl"
				"TeamNum" "2"
				"StartDisabled" "1"
				
				"OnPickup1" "!activatorRunScriptCodeClientPrint(self, 4, `YOU PICKED UP A NITRO CAN!`)01"
				"OnPickup1" "!activator,$PlaySoundToSelf,items/gunpickup2.wav,0,-1"
				"OnReturn" "GasCanCounter,Add,1,0,1"
				"OnReturn" "!self,Kill,,0.1,1"
			}
			tf_glow
            {
				"targetname" "GasCanGlow"
				"target" "GasCan"
                "GlowColor" "0 176 199 255"
				"startdisabled" "1"
            }
		}

		// Magma Pyro
		MagmaProjectilePT
		{
			KeepAlive 1

			RemoveIfKilled "MagmaFireTarget"

			OnParentKilledOutput
			{
				Target MagmaFirePT
				Action ForceSpawnAtEntityOrigin
				Param "MagmaFireTarget"
			}
			OnParentKilledOutput
			{
				Target MagmaFireTarget
				Action Kill
				Delay 0.1
			}

			info_target
			{
				"targetname" "MagmaFireTarget"
			}
		}
		MagmaFirePT
		{
			RemoveIfKilled "MagmaFireDamage"

			OnSpawnOutput
			{
				Target MagmaFireParticle
				Action Start
			}
			OnSpawnOutput
			{
				Target MagmaFireDamage
				Action Kill
				Delay 3
			}

			trigger_hurt
			{
				"targetname" "MagmaFireDamage"
				"filtername" "filter_redteam_nouber"
				"mins" "-60 -60 -60"
				"maxs" "60 60 60"
				"damage" "40"
				"damagetype" "8"
				"$killicon" "firedeath"
				"spawnflags" "64"

				"disablebonefollowers" "1"
				"disableshadows" "1"

				"OnHurtPlayer" "!activator,$IgnitePlayerDuration,5,0,-1"
			}
			info_particle_system
			{
				"targetname" "MagmaFireParticle"
				"effect_name" "lava_fireball_01"
				"start_active" "0"
			}
		}

		// Sticky Nuke
		StickyNukePT
		{
			RemoveIfKilled "StickyNukeHitbox"

			OnSpawnOutput
			{
				Target "StickyNukeRelay"
				Action "Trigger"
			}
			OnSpawnOutput
			{
				Target "StickyNukeIndicator"
				Action "$SetFakeParent"
				Param "StickyNukeHitbox"
			}
			OnSpawnOutput
            {
                Target "StickyNukeIndicator"
                Action "$SetLocalAngles"
                Param "0 0 0"
                Delay 0.05
            }

			logic_relay
			{
				"targetname" "StickyNukeRelay"

				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode_trigger.wav,0.5,-1"
				"OnTrigger" "StickyNukeCharge,Start,,1,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode_trigger.wav,1.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode_trigger.wav,2.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode_trigger.wav,3.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/bomb_warning.wav,5.3,-1"
				"OnTrigger" "tf_gamerules,$StopVO,items/bomb_warning.wav,6,-1"
			}

			obj_sentrygun
			{
				"targetname" "StickyNukeHitbox"
				"TeamNum" "3"
				"defaultupgrade" "2"
				"health" "1500"
				"SolidToPlayer" "0"
				"rendermode" "10"
				"$sentrymodelprefix" "models/weapons/w_models/w_stickybomb.mdl"

				"damagefilter" "filter_red"

				"OnDamaged" "Player,$DisplayTextCenter,$$=test(!caller.m_iHealth>1,'Nuke HP: '..string(max(!caller.m_iHealth, 0)),''),0,-1"
                "OnDamaged" "!parentRunScriptCodetry{if(caller.GetHealth()<1){self.Kill()}}catch(e){}0-1"
			}
			prop_dynamic
			{
				"targetname" "StickyNukeIndicator"
				"origin" "0 0 50"
				"model" "models/props_gameplay/cap_circle_768.mdl"
				"modelscale" "2"
				
				"$modules" "fakeparent"
				"$fakeparentoffset" "0 0 50"

				"disablebonefollowers" "1"
				"disableshadows" "1"
			}
			info_target
			{
				"targetname" "StickyNukeCharge"
				"origin" "0 0 0"
				"effect_name" "charge_up"
				"start_active" "0"
			}
		}
	}

