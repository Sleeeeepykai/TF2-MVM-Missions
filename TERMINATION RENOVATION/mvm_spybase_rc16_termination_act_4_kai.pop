#base robot_standard.pop
#base robot_giant.pop

WaveSchedule
{
	StartingCurrency 4800
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15

	WaveStartCountdown 3

	MaxRedPlayers 6
	AllowBotExtraSlots 1
	RobotLimit 40

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/robot_factory/australium_tank.mdl"
	PrecacheModel "models/bots/boss_bot/tankred_track_l.mdl"
	PrecacheModel "models/bots/boss_bot/tankred_track_r.mdl"

	PrecacheModel "models/props_tumb/mvm/tank_shield.mdl"
	PrecacheModel "models/props_mvm/no_entry.mdl"

	PrecacheModel "models/bots/heavy_boss/bot_heavy_boss_gibby.mdl"
	PrecacheModel "models/bots/pyro_boss/bot_pyro_boss_gibby.mdl"

	PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun.mdl"
	PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun_fireball.mdl"

	PrecacheModel "models/props_gameplay/cap_circle_768.mdl"

	// Precached Sounds //

	// VOX

	// Saxton Hale Voicelines
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro1.mp3"
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro2.mp3"
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_intro3.mp3"

	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs.mp3"
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_patrolchiefs2.mp3"

	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_blastdoor.mp3"
	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_turbocharge.mp3"

	PrecacheSound "termination/act4/wave6-7/saxtonhalevoicelines/saxton_hale_aftermath.mp3"

	PrecacheSound "termination/act4/wave7-7/saxtonhalevoicelines/saxton_hale_rocketfuelling.mp3"
	PrecacheSound "termination/act4/wave7-7/saxtonhalevoicelines/saxton_hale_holdoutfirstquarter.mp3"
	PrecacheSound "termination/act4/wave7-7/saxtonhalevoicelines/saxton_hale_holdoutsecondquarter.mp3"
	PrecacheSound "termination/act4/wave7-7/saxtonhalevoicelines/saxton_hale_holdoutthirdquarter.mp3"
	PrecacheSound "termination/act4/wave7-7/saxtonhalevoicelines/saxton_hale_goliathfootsteps.mp3"

	// Gray Mann Voicelines
	PrecacheSound "termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs.mp3"
	PrecacheSound "termination/act4/wave6-7/graymannvoicelines/gray_mann_patrolchiefs2.mp3"
	
	PrecacheSound "termination/act4/wave6-7/graymannvoicelines/gray_mann_aftermath.mp3"

	// SFX
	PrecacheSound "termination/act4/wave6-7/sfx/patrol_chief_beam.mp3"

	PrecacheSound "termination/act4/wave7-7/sfx/goliath_waterstep.mp3"
	PrecacheSound "termination/act4/wave7-7/sfx/goliath_waterstep2.mp3"
	PrecacheSound "termination/act4/wave7-7/sfx/goliath_waterstep3.mp3"
	PrecacheSound "termination/act4/wave7-7/sfx/goliath_waterstep4.mp3"
	PrecacheSound "termination/act4/wave7-7/sfx/goliath_waterstep5.mp3"

	// Music
	PrecacheSound "termination/act4/wave6-7/music/termination_hurricane_of_power.wav"
	PrecacheSound "termination/act4/wave7-7/music/termination_t_minus.mp3"

	// Precached Particles
	
	PrecacheParticle "spell_fireball_small_trail_red"

	//// DISABLED SOUNDS ////

    DisableSound "Announcer.MVM_Wave_End"
	DisableSound "Announcer.MVM_Get_To_Upgrade"
	DisableSound "Announcer.MVM_Final_Wave_End"	
	DisableSound "music.mvm_end_last_wave"						
	DisableSound "music.mvm_end_mid_wave"						
	DisableSound "music.mvm_end_tank_wave"						
	DisableSound "music.mvm_end_wave"							
	DisableSound "music.mvm_lost_wave"							
	DisableSound "music.mvm_start_last_wave"					
	DisableSound "music.mvm_start_mid_wave"	
	DisableSound "music.mvm_start_tank_wave"					
	DisableSound "music.mvm_start_wave"
	DisableSound "Announcer.MVM_First_Wave_Start"				
	DisableSound "Announcer.MVM_Wave_Start"						
	DisableSound "Announcer.MVM_Wave_End"						
	DisableSound "Announcer.MVM_Wave_Lose"						
	DisableSound "Announcer.MVM_Final_Wave_Start"
	DisableSound "Announcer.MVM_Tank_Planted"

	//// LUA SCRIPTS ////

	LuaScriptFile "tank_repair_script.lua"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// WEAPONS ////

		"MagmaGun"
		{
			OriginalItemName "TF_WEAPON_SHOTGUN_PYRO"
			
			"damage bonus" 1.2
			"add damage type" 2056
			"remove damage type" 64
			"fire rate bonus" 1.2
			"mod max primary clip override" -1
			"attach particle effect" "704"

			"override projectile type" 2
			"blast radius decreased" 0.5
			"projectile speed decreased" 0.65
			"mult projectile scale" 2
			"penetrate teammates" 1

			"custom item model" "models/weapons/c_models/c_cryo_gun/c_cryo_gun.mdl"
			"custom projectile model" "models/weapons/c_models/c_cryo_gun/c_cryo_gun_fireball.mdl"
			"projectile trail particle" "~spell_fireball_small_trail_red"
			"custom weapon fire sound" "MVM.GiantSoldierRocketShootCrit"
			"custom kill icon" "firedeath"
		}

		"NukeLauncher"
		{
			OriginalItemName "Upgradeable TF_WEAPON_PIPEBOMBLAUNCHER"

			"damage bonus" 10
