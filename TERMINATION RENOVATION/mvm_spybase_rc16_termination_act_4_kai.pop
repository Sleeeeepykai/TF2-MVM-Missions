			"airblast pushback scale" 5
			"blast radius increased" 5
			"no self blast dmg" 1
			"fire rate penalty" 7
			"mod max primary clip override" -1

			"mult projectile scale" 3
			"projectile range decreased" 0.5
			"max pipebombs decreased" -7
			"projectile detonate time" 6
			"sticky arm time penalty" 4.6
