	//// ROBOT TEMPLATES ////

	Templates
	{
		//// MINIBOSSES ////

		T_TFBot_Heavy_PatrolChief
        {
            Name "Patrol Chief H-74"
			Template T_TFBot_Giant_Heavyweapons
            ClassIcon heavy_head_nys
            Skill Normal
            Scale 2
            Health 40000
            Attributes UseBossHealthBar
            Action Mobber

			UseCustomModel "models/bots/heavy_boss/bot_heavy_boss_gibby.mdl"

			SpawnTemplate "PatrolChiefHeavyPT"

            Item "Lo-Fi Longwave"

            CharacterAttributes
            {
                "never gib" 1
            }

            ItemAttributes
            {
				ItemName "TF_WEAPON_MINIGUN"
				"mod minigun can holster while spinning" 1
			}

			ChangeAttributes
			{
				Name "Intro"
				Delay 0
				Repeats 1
			}
			ChangeAttributes
			{
				Name "Shotgun"
				Delay 0
				Repeats 1
				IfHealthBelow 26501
			}
			ChangeAttributes
			{
				Name "BackToMini"
				Delay 0
				Repeats 1
				IfHealthBelow 14001
			}

            EventChangeAttributes
			{
				Intro [$SIGSEGV]
				{
					FireInput
					{
						Target !self
						Action $SetLocalOrigin
						Param "-2307 8186 678"
						Delay -1
						Repeats 1
