		//// PLAYER PTs ////

		PlayerVoicelinePT
		{
			OnSpawnOutput
			{
				Target Act1IntroVoicelineRelay
				Action Trigger
				Delay 3
			}

			logic_relay
			{
				"targetname" "Act1IntroVoicelineRelay"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxton_hale_intro1.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxton_hale_intro1.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Aaaalright Mercenaries! The name's Saxton Hale. You gents have just broken into Gray Mann's not-so-secret base for me.,1.4,-1"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: What for you might ask? Well he's holdin' onto heaps of Australium down below and its your job to get it out.,14.4,-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_intro2.mp3`,channel = 6,special_dsp = 55,filter_type=5})271"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_intro2.mp3`,channel = 6,special_dsp = 55,filter_type=5})271"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: First task is gonna get ya escortin' a path for this EMP Tank here - it'll crack upper security wide open.,27,-1"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: But she's a delicate beauty so make sure those robot lackeys don't rip her a new one.,39,-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_engibotintro_variation3.mp3`,channel = 6,special_dsp = 55,filter_type=5})501"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_engibotintro_variation3.mp3`,channel = 6,special_dsp = 55,filter_type=5})501"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: This Engibot we stole and had reprogrammed by RnD to whip up gadgets along the way. It'll handle the tech-ing while you Mercenaries handle the smashing!,50,-1"
			}
		}

		//// ROBOT PTs ////

		// Chief Technician Assets
		ChiefTechnicianPT
        {
			logic_relay
			{
				"targetname" "ChiefTechnicianIntroRelay"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_jeers04.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_jeers04.mp3`,channel = 6,pitch = 90,filter_type = 5})2.5-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_jeers04.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_jeers04.mp3`,channel = 6,pitch = 90,filter_type = 5})2.5-1"
				"OnTrigger" "!activator+,$PlaySequence,taunt_highfivestart,6,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_helpmedefend01.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_helpmedefend01.mp3`,channel = 6,pitch = 90,filter_type = 5})6-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_helpmedefend01.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_helpmedefend01.mp3`,channel = 6,pitch = 90,filter_type = 5})6-1"
			}
            logic_relay // Highlighter Relay
            {
                "targetname" "chieftechnicianhighlighter"
                "OnTrigger"  "highlightglow1,enable,,0,-1"
                "OnTrigger"  "highlightglow1,disable,,2.49,-1"
                "OnTrigger"  "highlightglow2,enable,,2.5,-1"
                "OnTrigger"  "highlightglow2,disable,,4.99,-1"
                "OnTrigger"  "chieftechnicianhighlighter,trigger,,5,-1"
                "spawnflags" "2"
            }
			logic_relay
			{
				"targetname" "chieftechnicianhighlighter"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})81"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_chieftechnician.mp3`,special_dsp = 55,filter_type=5})9.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_chieftechnician.mp3`,special_dsp = 55,filter_type=5})9.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: That Chief Technician is riling me up; go smash his head in so you can redeploy that bridge!,9.4,1"
			}
            tf_glow // Indicator Glow
            {
                "GlowColor" "255 255 0 255"
                "target" "!parent"
				"targetname" "highlightglow1"
				"startdisabled" "1"
            }
            tf_glow // Indicator Glow
            {
                "GlowColor" "0 255 0 255"
                "target" "!parent"
				"targetname" "highlightglow2"
				"startdisabled" "1"
            }
            tf_glow // Indicator Glow
            {
                "GlowColor" "102 153 255 255"
                "target" "!parent"
				"targetname" "highlightglow3"
				"startdisabled" "1"
            }
            info_particle_system // Boss Fight Start FX (I thought this was already set up?)
			{
				"targetname" "kablooey"
				"origin" "0 0 0"
				"angles" "0 0 0"
				"effect_name" "mvm_tank_destroy"
			}
        }
        ChiefTechnicianRingAttackMaker
        {
            NoFixUp 1

            OnSpawnOutput // Sets RingMaker Owner
            {
                target "!activator"
                action "RunScriptCode"
                param "CzUtil.AddTracking(`ChiefTechnicianRingAttackMaker`, self)"
                delay 0.0
            }
            OnParentKilledOutput // Removes RingMaker Owner
            {
                target "ring_maker"
                action "RunScriptCode"
                param "CzUtil.RemoveTracking(`ChiefTechnicianRingAttackMaker`)"
                delay 0.0
            }
            env_entity_maker // RingMaker Entity
            {   
                "targetname" "ring_maker"
                "entitytemplate" "ChiefTechnicianRingAttackLogic"
            }
        }
        ChiefTechnicianRingAttackLogic
        {
            KeepAlive 1

            env_beam // Ring Attack Indicator Beam
            {
                "parentname" ""
                "targetname" "roundbeamtest"
                "BoltWidth" "4"
                "LightningStart" "ringmarkerone"
                "LightningEnd" "ringmarkertwo"
                "origin" "0 0 30"
                "renderamt" "200"
                "rendercolor" "200 200 255"
                "damage" "0"
                "NoiseAmplitude" "4"
                "dissolvetype" "1"
                "texture" "sprites/laserbeam.spr"
                "life" "4"
                "spawnflags" "8" //8
                "TouchType" "1"
            }
            prop_dynamic // Ring Attack Bounding Prop
            {
                "parentname" ""
                "targetname" "ringmarkerone"
                "model" "models/empty.mdl"
                "solid" "0"
                "origin" "0 0 30"                
            }
            prop_dynamic // Ring Attack Bounding Prop
            {
                "parentname" ""
                "targetname" "ringmarkertwo"
                "model" "models/empty.mdl"
                "solid" "0"
                "angles" "0 180 0"
                "origin" "0 0 30"
            }
            OnSpawnOutput // Ring Attack Firing Sound
            {
                target "tf_gamerules"
                action "PlayVO"
                Param "npc/combine_gunship/gunship_ping_search.wav"
                delay "0.0"
            }
            OnSpawnOutput // ???
            {
                target "roundbeamtest"
                action "StrikeOnce"
                delay "0"
            }
            OnSpawnOutput // Registers RingMaker Owner
            {
                target "roundbeamtest"
                action "RunScriptCode"
                param "RingRegister(self,80,CzUtil.GetTracking(`ChiefTechnicianRingAttackMaker`))"
                delay 0.0
            }
            OnSpawnOutput // Sets Bounding Prop to be Non-Solid?
            {
                target "ringmarkerone"
                action "RunScriptCode"
                param "SetMoveIgnoreSolid(self, 120)"
            }
            OnSpawnOutput // Sets Bounding Prop to be Non-Solid?
            {
                target "ringmarkertwo"
                action "RunScriptCode"
                param "SetMoveIgnoreSolid(self, 120)"
            }
            OnSpawnOutput // Turns Off Ring Beam Entity
            {
                target "roundbeamtest"
                action "TurnOff"
                delay "4.5"
            }
            OnSpawnOutput // Despawns Ring Beam Entity
            {
                target "roundbeamtest"
                action "kill"
                delay "5.0"
            }
            OnSpawnOutput // Despawns Bounding Prop
            {
                target "ringmarkerone"
                action "kill"
                delay "5.5"
            }
            OnSpawnOutput // Despawns Bounding Prop
            {
                target "ringmarkertwo"
                action "kill"
                delay "5.5"
            }
        }
	}

