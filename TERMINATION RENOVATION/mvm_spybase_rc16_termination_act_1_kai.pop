 			}
			func_button
			{
				"targetname" "SpawnDoorButton"
				"origin" "-2064 7505 750"
				"mins" "-40 -65 -75"
                "maxs" "20 30 75"
				"wait" "-1"

				"spawnflags" "2560"

				"OnPressed" "SpawnDoorBreakdownRelay,Trigger,,0,-1"
			}
			logic_timer
			{
				"targetname" "SpawnDoorButtonGlowTimer"
				"RefireTime" "1"
				"startdisabled" "1"

				"OnTimer" "SpawnDoorButtonGlow,Enable,,0,-1"
				"OnTimer" "SpawnDoorButtonGlow,Disable,,0.5,-1"
			}
			tf_glow
