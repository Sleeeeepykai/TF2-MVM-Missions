			}

			logic_relay
			{
				"targetname" "ChiefTechnicianFightRelay"

				"OnTrigger" "!activator,$RemoveCond,7,0,-1"
				"OnTrigger" "ChiefTechnicianChairParticle,Start,,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/rd_robot_explosion01.wav,0,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_paincriticaldeath02.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_paincriticaldeath02.mp3`,channel = 6,pitch = 90,filter_type = 5})0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_paincriticaldeath02.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_paincriticaldeath02.mp3`,channel = 6,pitch = 90,filter_type = 5})0-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_dominationengineer_mvm06.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_dominationengineer_mvm06.mp3`,channel = 6,pitch = 90,filter_type = 5})5-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_dominationengineer_mvm06.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_dominationengineer_mvm06.mp3`,channel = 6,pitch = 90,filter_type = 5})5-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave1_Subwave5_Bowmen,5,-1"
