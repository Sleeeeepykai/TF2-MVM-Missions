				"OnTrigger" "tf_gamerules,PlayVO,weapons/sapper_removed.wav,12,-1"
				"OnTrigger" "01_door_unlock_relay,Trigger,,12,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave1_Subwave1_ChiefTechnician,12,-1"
				"OnTrigger" "BlockerCratePT,ForceSpawn,12,-1"
				"OnTrigger" "SpawnDoorButton,Kill,,12.5,-1"
			}

			prop_dynamic
			{
				"targetname" "SpawnDoorButtonProp"
				"parentname" "01_door"
				"origin" "-2215 7525 1060"
				"model" "models/props_powerhouse/emergency_launch_button.mdl"
				"modelscale" "1.5"
				"solid" "6"

				"disableshadows" "1"
			}
			prop_dynamic
			{
				"targetname" "SpawnDoorButtonSapper"
				"parentname" "01_door"
