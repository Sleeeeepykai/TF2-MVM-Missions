				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_helpmedefend01.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_helpmedefend01.mp3`,channel = 6,pitch = 90,filter_type = 5})6-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_go01.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_go01.mp3`,channel = 6,pitch = 90,filter_type = 5})10.1-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_go01.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_go01.mp3`,channel = 6,pitch = 90,filter_type = 5})10.1-1"
				"OnTrigger" "tf_gamerules,PlayVO,weapons/drg_wrench_teleport.wav,10.1,-1"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_moveup02.mp3,12.1,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/soldier_mvm_m_moveup02.mp3,12.1,-1"
