#base robot_standard.pop
#base robot_giant.pop

WaveSchedule
{
	StartingCurrency 1000
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15

	WaveStartCountdown 3

	MaxRedPlayers 6
	AllowBotExtraSlots 1
	RobotLimit 40

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/spybase/emp_tank.mdl"

	PrecacheModel "models/robot_factory/monorail/trains/monorail_cargo_container_separate_open.mdl"

	// Precached Sounds //

	// VOX
	PrecacheSound "wee_woo_wee_woo.mp3"
	PrecacheSound "terminationlogo.mp3"

	// Saxton Hale Voicelines
	PrecacheSound "saxton_hale_intro1.mp3"
	PrecacheSound "saxtonhale/saxton_hale_intro2.mp3"
	PrecacheSound "saxtonhale/saxton_hale_engibotintro_variation3.mp3"

	PrecacheSound "saxtonhale/saxton_hale_bombpickup.mp3"
	PrecacheSound "saxtonhale/saxton_hale_drilltank.mp3"

	PrecacheSound "saxtonhale/saxton_hale_emptankready.mp3"
	PrecacheSound "saxtonhale/saxton_hale_chieftechnician.mp3"
	PrecacheSound "saxtonhale/saxton_hale_emptankfired.mp3"
	PrecacheSound "saxtonhale/saxton_hale_elevatorsequence_variation2.mp3"

	// SFX
	PrecacheSound "tank_emp_deploy.mp3"
	
	// Music
	PrecacheSound "termination_leadening_winds.wav"

	//// DISABLED SOUNDS ////

    DisableSound "Announcer.MVM_Wave_End"
	DisableSound "Announcer.MVM_Get_To_Upgrade"
	DisableSound "Announcer.MVM_Final_Wave_End"	
	DisableSound "music.mvm_end_last_wave"						
	DisableSound "music.mvm_end_mid_wave"						
	DisableSound "music.mvm_end_tank_wave"						
	DisableSound "music.mvm_end_wave"							
	DisableSound "music.mvm_lost_wave"							
	DisableSound "music.mvm_start_last_wave"					
	DisableSound "music.mvm_start_mid_wave"	
	DisableSound "music.mvm_start_tank_wave"					
	DisableSound "music.mvm_start_wave"
	DisableSound "Announcer.MVM_First_Wave_Start"				
	DisableSound "Announcer.MVM_Wave_Start"						
	DisableSound "Announcer.MVM_Wave_End"						
	DisableSound "Announcer.MVM_Wave_Lose"						
	DisableSound "Announcer.MVM_Final_Wave_Start"
	DisableSound "Announcer.MVM_Tank_Planted"

	//// LUA SCRIPTS ////

	LuaScriptFile "tank_repair_script.lua"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// COSMETICS ////

		"ExtraBomb"
		{
			OriginalItemName "Potato of Labor"

			"custom item model" "models/props_td/atom_bomb.mdl"
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination`)

						EntFire(`Player`, `$TeleportToEntity`, `spawnbot_right`)

						EntFire(`carrier_lift`, `SetSpeed`, 99999)
						EntFire(`carrier_lift_tab`, `SetSpeed`, 99999)
						EntFire(`carrier_disable_relay`, `Trigger`)

						EntFire(`drydock_open_relay`, `Trigger`)
						EntFire(`silo_door_close`, `Trigger`)
						EntFire(`01_door_lock_relay`, `Trigger`)
						EntFire(`01_door`, `SetSpeed`, 99999)
						EntFire(`02_door_lock_relay`, `Trigger`)
						EntFire(`02_door_flank_1_lock_relay`, `Trigger`)
						EntFire(`02_door_flank_2_lock_relay`, `Trigger`)
						EntFire(`03_door_lock_relay`, `Trigger`)
						EntFire(`03_door_flank_1_lock_relay`, `Trigger`)
						EntFire(`03_door_flank_2_lock_relay`, `Trigger`)
						EntFire(`04_door_lock_relay`, `Trigger`)
						EntFire(`05_door_lock_relay`, `Trigger`)
						EntFire(`06_door_lock_relay`, `Trigger`)
						EntFire(`08_door_lock_relay`, `Trigger`)

						IncludeScript(`music_system_ment`)
						PrecacheSound(`#termination_leadening_winds.wav`)
						PrecacheSound(`#ui/gamestartup22.mp3`)

						MusicSystemMent.ResetAll()
						MusicSystemMent.HookByName(`bignet`)

						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankextensions/drilltank`)
					  "
			}

			logic_auto
			{
				"targetname" "MissionExtraSetup"

				"OnMapSpawn" "tank_path_emp_8,AddOutput,OnPass EMPTankDisruptRelay:Trigger::0:-1,0,-1"
				"OnMapSpawn" "tank_path_emp_21,AddOutput,OnPass EMPTankDeployRelay:Trigger::0:-1,0,-1"

				"OnMapSpawn" "ConsoleControlPointCaptureArea,SetControlPoint,ConsoleControlPoint,0,-1"
			}

			point_populator_interface
            {
                "targetname" "pop_interface"
            }

			logic_timer
			{
				"targetname"    "RagdollRemover"
				"RefireTime"    "5"
				"OnTimer"       "tf_ragdoll*,Kill,,0,-1"
			}
			logic_timer
			{
				"targetname" "MissionAlarmTimer"
				"RefireTime" "60"

				"OnTimer" "tf_gamerules,PlayVO,ambient/alarms/citadel_alert_loop2.wav,0.1,-1"
				"OnTimer" "tf_gamerules,$StopVO,ambient/alarms/citadel_alert_loop2.wav,6,-1"
			}

			logic_relay
			{
				"targetname" "ActStartRelay"

				"OnTrigger" "SpawnDoorButton,Unlock,,0,-1"
				"OnTrigger" "SpawnDoorButtonGlowTimer,Enable,,0.1,-1"
				"OnTrigger" "HUDHint,$setkey$message,MOUSE1: INTERACT,0,-1"
				"OnTrigger" "HUDHintTimer,Enable,,0.1,-1"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_gunslingertriplepunchfinal01.mp3,0.1,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_battlecry04.mp3,4,-1"
			}

			logic_relay
			{
				"targetname" "FirstObjectiveRelay"

				"OnTrigger" "Player,$DisplayTextHint,CLEAR THE PATH FOR OUR EMP TANK,0,-1"
				"OnTrigger" "HUDHintTimer,Enable,,5,-1"
				"OnTrigger" "HUDHint,$SetKey$message,[OBJECTIVE] CLEAR THE PATH FOR OUR EMP TANK,5,-1"
			}
			logic_relay
			{
				"targetname" "SecondObjectiveRelay"

				"OnTrigger" "02_door_flank_1_unlock_relay,Trigger,,0,-1"
				"OnTrigger" "spybase_nav_interface,RecomputeBlockers,,0,-1"
				"OnTrigger" "Player,$DisplayTextHint,TAKE OUT THE GIANT AND GRAB HIS BOMB,8,-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})81"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_bombpickup.mp3`,channel = 6,special_dsp = 55,filter_type=5})9.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_bombpickup.mp3`,channel = 6,special_dsp = 55,filter_type=5})9.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Looks like they brought us a bomb! Excellent! Normally I'd smash through all those crates myself but I guess you'll need to blow em up instead.,9.4,-1"
			}
			logic_relay
			{
				"targetname" "ThirdObjectiveRelay"

				"OnTrigger" "02_door_flank_2_unlock_relay,Trigger,,4,-1"
				"OnTrigger" "03_door_flank_2_unlock_relay,Trigger,,4,-1"
				"OnTrigger" "spybase_nav_interface,RecomputeBlockers,,4,-1"

				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave1_Subwave3_DrillTank,6,-1"
				"OnTrigger" "Player,$DisplayTextHint,STOP THE DRILL TANK FROM REACHING OUR PAYLOAD,6,1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})61"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_drilltank.mp3`,channel = 6,special_dsp = 55,filter_type=5})7.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_drilltank.mp3`,channel = 6,special_dsp = 55,filter_type=5})7.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Crikey! Drill Tank incoming! take it out or our EMP Tank's trashed!,7.4,-1"
			}
			logic_relay
			{
				"targetname" "FourthObjectiveRelay"

				"OnTrigger" "tf_gamerules,PlayVO,misc/cp_harbor_blue_whistle.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_moveup01.mp3,1,-1"
				"OnTrigger" "Player,$DisplayTextHint,PROTECT THE EMP TANK,0,1"
				"OnTrigger" "HUDHint,$SetKey$message,[OBJECTIVE] PROTECT THE EMP TANK,5,-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})21"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_emptankready.mp3`,channel = 6,special_dsp = 55,filter_type=5})3.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_emptankready.mp3`,channel = 6,special_dsp = 55,filter_type=5})3.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Great work boys! You've bought our Engibot enough time to finish up the EMP. Keep him safe while he reaches the security breaker!,3.4,-1"
			}
			logic_relay
			{
				"targetname" "FifthObjectiveRelay"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_chieftechnician.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_chieftechnician.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: That Chief Technician is riling me up; go smash his head in so you can redeploy that bridge!,1.4,-1"

				"OnTrigger" "ChiefTechnicianHighlightTimer,Enable,,3,-1"
				"OnTrigger" "Player,$DisplayTextHint,KILL THE CHIEF TECHNICIAN AND CONTROL THE MAIN CONSOLE,3,-1"
				"OnTrigger" "HUDHint,$SetKey$message,[OBJECTIVE] OVERRIDE THE MAIN CONSOLE,5,-1"

				"OnTrigger" "tank_hologram_relay_left,Trigger,,8,-1"
				"OnTrigger" "03_door_unlock_relay,Trigger,,8,-1"
				"OnTrigger" "spybase_nav_interface,RecomputeBlockers,,8,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_start.wav,8,-1"
				"OnTrigger" "ConsoleDoorPT,ForceSpawn,,8,-1"
				"OnTrigger" "ConsoleDoorButtonGlowTimer,Enable,,8.1,-1"
			}
			logic_relay
			{
				"targetname" "SixthObjectiveRelay"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`ui/quest_alert.wav`);EmitSoundEx({sound_name=`ui/quest_alert.wav`,special_dsp = 55,filter_type=5})01"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_emptankfired.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name=`saxtonhale/saxton_hale_emptankfired.mp3`,channel = 6,special_dsp = 55,filter_type=5})1.41"
				"OnTrigger" "Player,$DisplayTextChat,{ffb84d}Saxton Hale{reset}: Hah-hahaha! Brilliant work. Upper security is completely fried! All you need to do now is reboot the elevator to the lower levels and you'll be on your way down!,1.4,-1"

				"OnTrigger" "Player,$DisplayTextHint,OVERRIDE THE ELEVATOR,3,-1"
				"OnTrigger" "HUDHint,$SetKey$message,[OBJECTIVE] OVERRIDE THE ELEVATOR,5,-1"
				"OnTrigger" "ElevatorBreakerButtonTimer,Enable,,8,-1"
			}

			logic_relay
			{
				"targetname" "EMPTankDisruptRelay"

				"OnTrigger" "!activator,SetSpeed,0,0,-1"
				"OnTrigger" "shortcut_bridge_retract_relay,Trigger,,0,-1"

				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_dominationengineer_mvm03.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_dominationengineer_mvm03.mp3`,channel = 6,pitch = 90,special_dsp = 57,filter_type = 5})2-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`vo/mvm/norm/engineer_mvm_dominationengineer_mvm03.mp3`);EmitSoundEx({sound_name = `vo/mvm/norm/engineer_mvm_dominationengineer_mvm03.mp3`,channel = 6,pitch = 90,special_dsp = 57,filter_type = 5})2-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_jeers02.mp3,5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_helpme03.mp3,7,-1"

				"OnTrigger" "FifthObjectiveRelay,Trigger,,10,-1"
			}
			logic_relay
			{
				"targetname" "EMPTankDeployRelay"

				"OnTrigger" "BigNetRunScriptCodeMusicSystemMent.SetMusicTrack(``, 0.5, 0.5)0-1"
				"OnTrigger" "tf_gamerules,PlayVO,tank_emp_deploy.mp3,0,-1"

				"OnTrigger" "EMPTankCharge,Start,,7.6,-1"

				"OnTrigger" "RedLoseRelay,Disable,,12.5,-1"
				"OnTrigger" "EMPTankExplosion,Start,,12.5,-1"
				"OnTrigger" "!activator,RemoveHealth,999999,12.6,-1"
				"OnTrigger" "red_normal_mission_relay,Trigger,,12.6,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 51, 153, 255, 128, 1, 0, 1)12.6-1"
				"OnTrigger" "RobotSpawnBarrier,Kill,,12.6,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave1_Subwave5_Bowmen,12.6,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave1_Subwave5_Bowmen,12.6,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave1_Subwave5_Soldiers,12.6,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave1_Subwave5_Soldiers,12.6,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave1_Subwave6_GRapidSoldiers,12.6,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave1_Subwave6_GRapidSoldiers,12.6,-1"
				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave1_Subwave6_BurstDemos,12.6,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave1_Subwave6_BurstDemos,12.6,-1"
				"OnTrigger" "ElevatorBreakerPT,ForceSpawn,,12.6,-1"
				"OnTrigger" "ElevatorBreakerButtonGlowTimer,Enable,,12.7,-1"
				"OnTrigger" "SixthObjectiveRelay,Trigger,,16,-1"
			}

			prop_dynamic
			{
				"targetname" "SpawnSupplyLocker"
				"origin" "-1361 9264 688"
				"angles" "0 135 0"
				"model" "models/props_gameplay/resupply_locker.mdl"
				"solid" "6"
			}
			func_regenerate
			{
				"targetname" "SpawnSupplyLockerTrigger"
				"origin" "-1361 9264 688"
				"mins" "-60 -60 -96"
                "maxs" "135 60 96"
				"teamnum" "2"
				"associatedmodel" "SpawnSupplyLocker"
				"spawnflags" "1"
			}

			logic_timer
			{
				"targetname"    "HUDHintTimer"
				"RefireTime"    "2.0"
				"startdisabled" "1"

				"OnTimer" "HUDHint,ShowHudHint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "HUDHint"
				"message" ""
				"spawnflags" "1"
			}

			game_round_win
			{
				"targetname" "red_win"
				"TeamNum" "2"
				"switch_teams" "0"
				"force_map_reset" "1"
			}
			logic_relay
			{
				"targetname" "RedWinRelay"
				"OnTrigger" "red_win,RoundWin,,0,-1"
			}
            logic_relay
			{
				"targetname" "RedLoseRelay"
				"OnTrigger" "bots_win,RoundWin,,0,-1"
			}
			logic_relay
			{
				"targetname" "RepairmanDeathRelay"

				"OnTrigger" "pop_interface,$KillWaveSpawn,Wave1_Subwave3_Repairmen,0,-1"
				"OnTrigger" "pop_interface,$FinishWaveSpawn,Wave1_Subwave3_Repairmen,0,-1"
			}
		}

		//// MAP ASSET PTs ////

		SpawnDoorPT
		{
			RemoveIfKilled "SpawnDoorButton"

			OnSpawnOutput
			{
				Target SpawnDoorAlarmLight
				Action TurnOff
			}

			logic_relay
			{
				"targetname" "SpawnDoorBreakdownRelay"

				"OnTrigger" "HUDHintTimer,Disable,,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,weapons/sapper_plant.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,weapons/sapper_timer.wav,0,-1"
				"OnTrigger" "SpawnDoorButtonSapper,Enable,,0,-1"
				"OnTrigger" "SpawnDoorButtonGlowTimer,Disable,,0,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp,SetAnimation,spin,0,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp,Skin,4,0,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp,SetPlaybackRate,-1,0.01,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp2,SetAnimation,spin,0,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp2,Skin,4,0,-1"
				"OnTrigger" "SpawnDoorAlarmLight,Toggle,,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,wee_woo_wee_woo.mp3,2,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave1_Subwave1_Snipers,3,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,4,-1"
				"OnTrigger" "ActIntroCardUpper,Display,,4,-1"
				"OnTrigger" "ActIntroCardLower,Display,,5,-1"
				"OnTrigger" "BigNetRunScriptCodeNetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination - Indium Infiltration`)5-1"
				"OnTrigger" "Player,$DisplayTextChat,{yellow}[ Now Playing: {6383ff} Leadening Winds - GoodBobFR {yellow}],5,-1"
				"OnTrigger" "BigNet,RunScriptCode,MusicSystemMent.SetMusicTrack(`#termination_leadening_winds.wav`),6,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap5.wav,6,-1"
				"OnTrigger" "SpawnDoorSpark1,Start,,6,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,6,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap9.wav,7,-1"
				"OnTrigger" "SpawnDoorSpark2,Start,,7,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap2.wav,8,-1"
				"OnTrigger" "SpawnDoorSpark3,Start,,8,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,8,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap3.wav,8.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap9.wav,9,-1"
				"OnTrigger" "SpawnDoorSpark4,Start,,9,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,10,-1"
				"OnTrigger" "SpawnDoorButtonParticle,Start,,12,-1"
