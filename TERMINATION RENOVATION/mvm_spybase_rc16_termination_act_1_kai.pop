#base robot_giant_vanilla_kai.pop
#base robot_standard_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 1000
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 15

	WaveStartCountdown 3

	MaxRedPlayers 6
	AllowBotExtraSlots 1
	RobotLimit 40

	MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	// Precached Models //

	PrecacheModel "models/spybase/emp_tank.mdl"

	// Precached Sounds //

	// VOX
	PrecacheSound "wee_woo_wee_woo.mp3"

	// Saxton Hale Voicelines
	PrecacheSound "saxton_hale_intro1.mp3"
	PrecacheSound "saxtonhale/saxton_hale_intro2.mp3"
	PrecacheSound "saxtonhale/saxton_hale_engibotintro_variation3.mp3"
	
	// Music
	PrecacheSound "termination_leadening_winds.wav"

	//// DISABLED SOUNDS ////

    DisableSound "Announcer.MVM_Wave_End"
	DisableSound "Announcer.MVM_Get_To_Upgrade"
	DisableSound "Announcer.MVM_Final_Wave_End"	
	DisableSound "music.mvm_end_last_wave"						
	DisableSound "music.mvm_end_mid_wave"						
	DisableSound "music.mvm_end_tank_wave"						
	DisableSound "music.mvm_end_wave"							
	DisableSound "music.mvm_lost_wave"							
	DisableSound "music.mvm_start_last_wave"					
	DisableSound "music.mvm_start_mid_wave"	
	DisableSound "music.mvm_start_tank_wave"					
	DisableSound "music.mvm_start_wave"
	DisableSound "Announcer.MVM_First_Wave_Start"				
	DisableSound "Announcer.MVM_Wave_Start"						
	DisableSound "Announcer.MVM_Wave_End"						
	DisableSound "Announcer.MVM_Wave_Lose"						
	DisableSound "Announcer.MVM_Final_Wave_Start"

	//// LUA SCRIPTS ////

	LuaScriptFile "tank_repair_script.lua"

	//// CUSTOM WEAPONS ////

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CORE PTs ////

		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination`)

						EntFire(`Player`, `$TeleportToEntity`, `spawnbot_right`)

						EntFire(`carrier_lift`, `SetSpeed`, 99999)
						EntFire(`carrier_lift_tab`, `SetSpeed`, 99999)
						EntFire(`carrier_disable_relay`, `Trigger`)

						EntFire(`drydock_open_relay`, `Trigger`)
						EntFire(`shortcut_bridge_retract_relay`, `Trigger`)
						EntFire(`silo_door_close`, `Trigger`)
						EntFire(`01_door_lock_relay`, `Trigger`)
						EntFire(`01_door`, `SetSpeed`, 99999)
						EntFire(`02_door_lock_relay`, `Trigger`)
						EntFire(`02_door_flank_1_lock_relay`, `Trigger`)
						EntFire(`02_door_flank_2_lock_relay`, `Trigger`)
						EntFire(`03_door_lock_relay`, `Trigger`)
						EntFire(`03_door_flank_1_lock_relay`, `Trigger`)
						EntFire(`03_door_flank_2_lock_relay`, `Trigger`)
						EntFire(`04_door_lock_relay`, `Trigger`)
						EntFire(`05_door_lock_relay`, `Trigger`)
						EntFire(`06_door_lock_relay`, `Trigger`)
						EntFire(`08_door_lock_relay`, `Trigger`)

						IncludeScript(`music_system_ment`)
						PrecacheSound(`#termination_leadening_winds.wav`)

						MusicSystemMent.ResetAll()
						MusicSystemMent.HookByName(`bignet`)
					  "
			}

			point_populator_interface
            {
                "targetname" "pop_interface"
            }

			logic_timer // Ragdoll Remover
			{
				"targetname"    "RagdollRemover"
				"RefireTime"    "5"
				"OnTimer"       "tf_ragdoll*,Kill,,0,-1"
			}
			logic_timer // Alarm Timer
			{
				"targetname" "MissionAlarmTimer"
				"RefireTime" "60"

				"OnTimer" "tf_gamerules,PlayVO,ambient/alarms/citadel_alert_loop2.wav,0.1,-1"
				"OnTimer" "tf_gamerules,$StopVO,ambient/alarms/citadel_alert_loop2.wav,6,-1"
			}

			logic_relay
			{
				"targetname" "ActStartRelay"

				"OnTrigger" "SpawnDoorButton,Unlock,,0,-1"
				"OnTrigger" "SpawnDoorButtonGlowTimer,Enable,0.1,-1"
				"OnTrigger" "HUDHint,$setkey$message,MOUSE1: INTERACT,0,-1"
				"OnTrigger" "HUDHintTimer,Enable,0.1,-1"

				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_gunslingertriplepunchfinal01.mp3,0.1,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/norm/engineer_mvm_battlecry04.mp3,4,-1"
			}

			prop_dynamic
			{
				"targetname" "SpawnSupplyLocker"
				"origin" "-1361 9264 688"
				"angles" "0 135 0"
				"model" "models/props_gameplay/resupply_locker.mdl"
				"solid" "6"
			}
			func_regenerate
			{
				"targetname" "SpawnSupplyLockerTrigger"
				"origin" "-1361 9264 688"
				"mins" "-60 -60 -96"
                "maxs" "135 60 96"
				"teamnum" "2"
				"associatedmodel" "SpawnSupplyLocker"
				"spawnflags" "1"
			}

			logic_timer
			{
				"targetname"    "HUDHintTimer"
				"RefireTime"    "2.0"
				"startdisabled" "1"

				"OnTimer" "HUDHint,ShowHudHint,,0,-1"
			}
			env_hudhint
			{
				"targetname" "HUDHint"
				"message" ""
				"spawnflags" "1"
			}
		}

		//// MAP ASSET PTs ////

		SpawnDoorPT
		{
			RemoveIfKilled "SpawnDoorButton"

			OnSpawnOutput
			{
				Target SpawnDoorAlarmLight
				Action TurnOff
			}

			logic_relay
			{
				"targetname" "SpawnDoorBreakdownRelay"

				"OnTrigger" "tf_gamerules,PlayVO,passtime/ball_smack.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,weapons/sapper_plant.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,weapons/sapper_timer.wav,0,-1"
				"OnTrigger" "SpawnDoorButtonSapper,Enable,,0,-1"
				"OnTrigger" "SpawnDoorButtonGlowTimer,Disable,,0,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp,SetAnimation,spin,0,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp,Skin,4,0,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp,SetPlaybackRate,-1,0.01,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp2,SetAnimation,spin,0,-1"
				"OnTrigger" "SpawnDoorAlarmLightProp2,Skin,4,0,-1"
				"OnTrigger" "SpawnDoorAlarmLight,Toggle,,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,0,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,wee_woo_wee_woo.mp3,2,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave1_Subwave1_Snipers,3,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,4,-1"
				"OnTrigger" "ActIntroCardUpper,Display,,4,-1"
				"OnTrigger" "ActIntroCardLower,Display,,5,-1"
				"OnTrigger" "BigNetRunScriptCodeNetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `Termination - Indium Infiltration`)5-1"
				"OnTrigger" "Player,$DisplayTextChat,{yellow}[ Now Playing: {6383ff} Leadening Winds - GoodBobFR {yellow}],5,-1"
				"OnTrigger" "BigNet,RunScriptCode,MusicSystemMent.SetMusicTrack(`#termination_leadening_winds.wav`),6,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap5.wav,6,-1"
				"OnTrigger" "SpawnDoorSpark1,Start,,6,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,6,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap9.wav,7,-1"
				"OnTrigger" "SpawnDoorSpark2,Start,,7,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap2.wav,8,-1"
				"OnTrigger" "SpawnDoorSpark3,Start,,8,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,8,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap3.wav,8.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/energy/zap9.wav,9,-1"
				"OnTrigger" "SpawnDoorSpark4,Start,,9,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/levels/citadel/zapper_warmup1.wav,10,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/klaxon1.wav,10,-1"
				"OnTrigger" "SpawnDoorCharge,Start,,10,-1"
				"OnTrigger" "SpawnDoorCharge,Stop,,12,-1"
				"OnTrigger" "SpawnDoorExplosion,Start,,12,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode.wav,12,-1"
				"OnTrigger" "tf_gamerules,$StopVO,weapons/sapper_timer.wav,12,-1"
				"OnTrigger" "01_door_unlock_relay,Trigger,,12,-1"
				"OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave1_Subwave1_ChiefTechnician,12,-1"
				"OnTrigger" "SpawnBarrierFence,Kill,,12.4,-1"
				"OnTrigger" "SpawnDoorButton,Kill,,12.5,-1"
			}

			prop_dynamic
			{
				"targetname" "SpawnDoorButtonProp"
				"parentname" "01_door"
				"origin" "-2215 7525 1060"
