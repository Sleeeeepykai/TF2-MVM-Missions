	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// PYRO WEAPONS ////

		// Filter PT
		FilterPTs
		{
			filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
			filter_activator_tfteam // Is on RED
			{
				"targetname" "filter_redteam"
				"teamnum" "2"
			}
			filter_activator_tfteam // Is on BLU
			{
				"targetname" "filter_bluteam"
				"teamnum" "3"
			}
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
			filter_multi // Is an Un-Ubered Blu Player
            {
                "targetname" "filter_bluteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_bluteam"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		// Soul of Infernal Hailstorm
		
		InfernalHailstormProjectilePT
		{
			KeepAlive 1

			RemoveIfKilled "MagmaFireTarget"

			OnSpawnOutput
			{
				Target MagmaFireDamage
				Action $InheritOwner
				Param !parent
			}

			OnParentKilledOutput
			{
				Target MagmaFirePT
				Action ForceSpawnAtEntityOrigin
				Param "MagmaFireTarget"
			}
			OnParentKilledOutput
			{
				Target MagmaFireTarget
				Action Kill
				Delay 0.1
			}

			info_target
			{
				"targetname" "MagmaFireTarget"
			}
		}
		MagmaFirePT
		{
			KeepAlive 1

			RemoveIfKilled "MagmaFireDamage"

			OnSpawnOutput
			{
				Target MagmaFireDamage
				Action $InheritOwner
				Param !parent
			}

			OnSpawnOutput
			{
				Target MagmaFireDamage
				Action Kill
				Delay 5
			}

			trigger_hurt
			{
				"targetname" "MagmaFireDamage"
				"filtername" "filter_bluteam_nouber"
				"mins" "-60 -60 -60"
				"maxs" "60 60 60"
				"damage" "40"
				"damagetype" "8"
				"$killicon" "firedeath"
				"spawnflags" "64"

				"disablebonefollowers" "1"
				"disableshadows" "1"

				"OnHurtPlayer" "!activator,$IgnitePlayerDuration,5,0,-1"
			}
			info_particle_system
			{
				"targetname" "MagmaFireParticle"
				"effect_name" "lava_fireball_01"
				"start_active" "1"
			}
		}

		//// HEAVY WEAPONS ////

		// Soul of Dave
		SoulOfDavePT
		{
			OnSpawnOutput
			{
				Target "SoulOfDaveMimic"
				Action "$SetOwner"
				Param  "!activator"
				Delay  0
			}
			OnSpawnOutput
			{
				Target "SoulOfDaveMimic"
				Action "firemultiple"
				Param 1
				Delay 0.1
			}
			OnSpawnOutput
			{
				Target "SoulOfDaveMimic"
				Action Kill
				Delay 0.2
			}
			tf_point_weapon_mimic
			{
				"targetname"       "SoulOfDaveMimic"
				"origin"           "0 20 100"
				"angles"           "0 0 0"
				"teamnum"          "3"
				"$weaponname"    "SoulOfDaveWeapon"
				"$firetime"      "1.0"
			}
		}
	}

	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "FilterPTs"

	PlayerShootTemplate
	{
		Name "SoulOfDavePT"
		ItemName "Soul of Dave"
		Offset "0 0 -100"
		//Bone bip_spine_2
	}

	PlayerShootTemplate
	{
		Name "InfernalHailstormProjectilePT"
		ItemName "Soul of Infernal Hailstorm"
		AttachToProjectile 1
	}

