			"custom item model" "models/weapons/c_models/c_cryo_gun/c_cryo_gun.mdl"
			"custom view model" "models/weapons/c_models/c_pyro_cryo_gun_arms.mdl"
			"custom projectile model" "models/weapons/c_models/c_cryo_gun/c_cryo_gun_fireball.mdl"
			"projectile trail particle" "~spell_fireball_small_trail_red"
			"custom weapon fire sound" "MVM.GiantSoldierRocketShootCrit"
			"custom kill icon" "firedeath"

			"max health additive bonus" 350
			"model scale" 1.5
			"maxammo primary reduced" 0

			"special item description" "Imbue yourself with the soul of Infernal Hailstorm."
			"special item description 2" "You gain a mighty Fireball Cannon, at the cost of your Flamethrower."
		}

