	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		//// SOLDIER WEAPONS ////

		"The Dumpster Fire"
		{
			OriginalItemName "The Beggar's Bazooka"
			"damage penalty" 0.33
			"blast radius increased" 1.5

			"reload time increased" 5
			"clip size penalty" 0.25
			"maxammo primary reduced" 0.5

			"mult projectile count" 50
			"projectile spread angle penalty" 20
			"ignores other projectiles" 1
			"projectile gravity" 750

			"can overload" 0
			"crit mod disabled" 1
			"custom weapon fire sound" "DumpsterFire.Fire"
		}

		//// PYRO WEAPONS ////

		"Soul of Infernal Hailstorm"
		{
			OriginalItemName "TF_WEAPON_SHOTGUN_PYRO"
			
			"damage bonus" 10
			"add damage type" 8
			"remove damage type" 64
			"fire rate penalty" 1.2

			"override projectile type" 2
			"blast radius decreased" 0.5
			"projectile speed decreased" 0.65
			"mult projectile scale" 2
