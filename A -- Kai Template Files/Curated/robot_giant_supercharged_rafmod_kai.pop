		//// SNIPER TEMPLATES ////

		T_TFBot_Giant_Sniper
		{
			Name "Giant Sniper"
			Class Sniper
			ClassIcon sniper_giant
			Skill Expert
			Health 3000
			Attributes MiniBoss
			WeaponRestrictions PrimaryOnly
            Action Sniper

			MaxVisionRange 2500

			AimTrackingInterval 0.01

			UseCustomModel "models/bots/sniper_boss/bot_sniper_boss.mdl"

			CharacterAttributes
			{
				"move speed penalty" 0.5
				"damage force reduction" 0.7
				"airblast vulnerability multiplier" 0.7
				"override footstep sound set" 5
			}

			FireWeapon
			{
				Type "Primary"
				Delay 0
				Cooldown 1.5
				Duration 0.1
				IfSeeTarget 1
				IfLeftSpawn 1
			}

			FireInput
			{
				Target !self
				Action $AddCond
				Param 1
				Delay 0.1
				Cooldown 0.1
				IfSeeTarget 1
			}

			FireInput
			{
				Target !self
				Action $RemoveCond
				Param 1
				Delay 2
				Cooldown 1
				IfNoTarget 1
			}
		}

		T_TFBot_Giant_Sniper_Atomizer
		{
			Name "Giant Atomizer Sniper"
			Class Sniper
			ClassIcon sniper_atomic_hyper
			Skill Expert
			Health 3000
			Attributes MiniBoss
			Attributes AlwaysCrit
			Attributes SuppressFire
			WeaponRestrictions PrimaryOnly
			Action Sniper

			AimAt Body

			UseCustomModel "models/bots/sniper_boss/bot_sniper_boss.mdl"

			Item "Shooting Star"

			CharacterAttributes
			{
				"move speed penalty" 0.5
				"damage force reduction" 0.7
				"airblast vulnerability multiplier" 0.7
				"override footstep sound set" 5
			}

			ItemAttributes
			{
