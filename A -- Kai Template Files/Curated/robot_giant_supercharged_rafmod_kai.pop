WaveSchedule
{
	//// PRECACHES ////

	// Precached Models //
	PrecacheModel "models/weapons/w_models/w_rocketbullet.mdl"

	// Precached Sounds //

	PrecacheSound "bazooks/giant_heavy_gunwindup_brassbeast.wav"
	PrecacheSound "bazooks/giant_heavy_gunwinddown_brassbeast.wav"
	PrecacheSound "bazooks/giant_heavy_gunspin_brassbeast.wav"
	PrecacheSound "bazooks/giant_heavy_gunfire_brassbeast.wav"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		"MasterWeaponsBullet"
		{
			OriginalItemName "The Righteous Bison"
			
			"dmg penalty vs players" 1.25
			"dmg bonus vs buildings" 1.5
			"projectile speed increased" 1.5
			"projectile spread angle penalty" 2
		}
		"MasterWeaponsRocket"
		{
			OriginalItemName "TF_WEAPON_ROCKETLAUNCHER"

			"damage bonus" 1.5
			
			"mod projectile heat seek power" 360
			"mod projectile heat aim error" 360
			"mod projectile heat aim time" 1
			"mod projectile heat no predict target speed" 1
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// CLEANUP PT ////

		CleanupPT
		{
			OnSpawnOutput
			{
				Target Player
				Action RunScriptCode
				Param "EmitSoundEx({sound_name = `bazooks/giant_heavy_gunspin_brassbeast.wav`, channel = 6, filter_type = 5, entity = self, flags = 4})"
				Delay -1
			}
			OnSpawnOutput
			{
				Target Player
				Action RunScriptCode
				Param "EmitSoundEx({sound_name = `bazooks/giant_heavy_gunfire_brassbeast.wav`, channel = 6, filter_type = 5, entity = self, flags = 4})"
				Delay -1
			}
		}

		//// BRASS BEAST HEAVY ////

		BrassBeastPT
		{
			KeepAlive 1
			
			RemoveIfKilled "BrassBeastMimic"
			
			OnSpawnOutput
			{
				Target "BrassBeastCircle"
				Action "SetParentAttachment"
				Param "muzzle"
			}
			OnSpawnOutput
			{
				Target "BrassBeastChargeParticle"
				Action "SetParentAttachment"
				Param "muzzle"
			}
			OnSpawnOutput
			{
				Target "BrassBeastFireParticle"
				Action "SetParentAttachment"
				Param "muzzle"
			}
			OnSpawnOutput
			{
				Target "BrassBeastFireParticle2"
				Action "SetParentAttachment"
				Param "eject_brass"
			}
			OnParentKilledOutput
			{
				Target !activator
				Action RunScriptCode
				Param "EmitSoundEx({sound_name = `bazooks/giant_heavy_gunspin_brassbeast.wav`, channel = 6, filter_type = 5, entity = self, flags = 4})"
				Delay -1
			}
			OnParentKilledOutput
			{
				Target !activator
				Action RunScriptCode
				Param "EmitSoundEx({sound_name = `bazooks/giant_heavy_gunfire_brassbeast.wav`, channel = 6, filter_type = 5, entity = self, flags = 4})"
				Delay -1
			}
			OnParentKilledOutput
			{
				Target BrassBeastMimic
				Action TurnOff
				Delay -1
			}
			OnParentKilledOutput
			{
				Target BrassBeastMimic
				Action Kill
				Delay 0.1
			}

			prop_dynamic_ornament
			{
				"targetname" "BrassBeastMimic"
				"InitialOwner" "!parent"
				"model" "models/weapons/c_models/c_gatling_gun/c_gatling_gun.mdl"

				"disablebonefollowers" "1"
				"disableshadows" "1"
			}
			info_particle_system
			{
				"targetname" "BrassBeastChargeParticle"
				"parentname" "BrassBeastMimic"
				"effect_name" "projectile_fireball_ring_fire"
			}
			info_particle_system
			{
				"targetname" "BrassBeastFireParticle"
				"parentname" "BrassBeastMimic"
				"effect_name" "h2013_corpse_flame"
			}
			info_particle_system
			{
				"targetname" "BrassBeastFireParticle2"
				"parentname" "BrassBeastMimic"
				"effect_name" "h2013_corpse_flame"
			}
		}

		//// ATOMIZER SNIPER ////

		PlasmaSniperBeamPT
		{
			RemoveIfKilled "PlasmaAimBeam"

			OnSpawnOutput
			{
				Target "PlasmaAimStart"
				Action ClearParent
				Delay 0.1
			}
			OnSpawnOutput
			{
				Target "PlasmaAimEnd"
				Action ClearParent
				Delay 0.1
			}
			OnSpawnOutput
			{
				Target "PlasmaAimBeam"
				Action TurnOn
				Delay 0.1
			}
			OnSpawnOutput
			{
				Target "PlasmaAimBeam"
				Action Kill
				Delay 3.5
			}

			env_beam
			{
				"targetname" "PlasmaAimBeam"
				"origin" "0 0 0"
				"LightningStart" "PlasmaAimStart"
				"LightningEnd" "PlasmaAimEnd"
				"life" "0"
				"BoltWidth" "5"
				"TextureScroll" "-20"
				"texture" "sprites/laserbeam.vmt"
				"rendermode" "1"
				"renderamt" "144"
				"rendercolor" "192 0 255"
			}
			prop_dynamic
			{
				"targetname" "PlasmaAimStart"
				"origin" "0 0 0"
				"model" "models/empty.mdl"
				"disableshadows" "1"
			}
			prop_dynamic
			{
				"targetname" "PlasmaAimEnd"
				"origin" "5000 0 0"
				"model" "models/empty.mdl"
				"disableshadows" "1"
			}
		}
	}

