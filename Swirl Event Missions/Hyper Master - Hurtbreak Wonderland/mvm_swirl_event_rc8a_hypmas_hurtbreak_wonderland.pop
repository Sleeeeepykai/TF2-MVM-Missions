#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 1200
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	WaveStartCountdown 7

	//// PRECACHES ////

	// Precached Models

	PrecacheModel "models/bots/scout_boss/bot_scout_gray_boss.mdl"

	PrecacheModel "models/props_mvm/indicator/indicator_circle.mdl"

	// Precached Sounds

	PrecacheSound "music/in_absentia_logos.wav"
	PrecacheSound "music/spiral_out.wav"

	//// DISABLED SOUNDS ////

    DisableSound "Announcer.MVM_Wave_End"
    DisableSound "Announcer.MVM_Final_Wave_End"	
	DisableSound "Announcer.MVM_Bonus"
    DisableSound "Announcer.MVM_Get_To_Upgrade"

    DisableSound "music.mvm_start_wave"
    DisableSound "music.mvm_start_last_wave"					   
	DisableSound "music.mvm_start_mid_wave"						   
	DisableSound "music.mvm_start_tank_wave"
    DisableSound "music.mvm_end_wave"
    DisableSound "music.mvm_end_last_wave"						   
	DisableSound "music.mvm_end_mid_wave"						   
	DisableSound "music.mvm_end_tank_wave"

	//// CUSTOM WEAPONS ////

	//// POINT TEMPLATES ////

	PointTemplates
	{
		Core_PT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`music_system_ment`, getroottable())

						PrecacheSound(`#music/in_absentia_logos.wav`)
						PrecacheSound(`#music/spiral_out.wav`)
						MusicSystemMent.ResetAll();
						MusicSystemMent.HookByName(`bignet`);
					  "
			}

			logic_relay
			{
				"targetname" "BombSetupRelay"

				"OnTrigger" "item_teamflag*,SetReturnTime,60,5,-1"
			}
		}

		Masquerade_Boss_Intro_PT
		{
			OnSpawnOutput
			{
				Target MasqueradeManBot
				Action TurnOff
			}
			OnSpawnOutput
			{
				Target MasqueradeFit
				Action TurnOff
			}

			// Masquerade Evil Portal OOOOOO SHIVER ME TIMBERS

			logic_relay
			{
				"targetname" "MasqueradePortalRelay"

				"OnTrigger" "MasqueradePortalParticle,Start,,0,-1"
				"OnTrigger" "MasqueradePortalParticleTimer,Enable,,0,-1"
			}

			info_particle_system
			{
				"targetname" "MasqueradePortalParticle"
				"origin" "208 -336 1088"
				"effect_name" "dxhr_lightningball_parent_blue"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "MasqueradePortalParticle"
				"origin" "208 -336 1088"
				"effect_name" "eyeboss_team_blue"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "MasqueradePortalParticle"
				"origin" "208 -336 1088"
				"effect_name" "eb_doorway_vortex04"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "MasqueradePortalParticle2"
				"origin" "208 -336 1088"
				"effect_name" "eb_tp_vortex02"
				"start_active" "0"
			}

			logic_timer
			{
				"targetname" "MasqueradePortalParticleTimer"
                "refiretime" "1.5"
				"startdisabled" "1"

                "OnTimer" "MasqueradePortalParticle2,Start,,0,-1"
				"OnTimer" "MasqueradePortalParticle2,Stop,,1,-1"
			}

			// Masquerade Intro

			logic_relay
			{
				"targetname" "MasqueradeIntroRelay"

				"OnTrigger" "PlayerRunScriptCodeself.SetHudHideFlags(~132)0-1"
				"OnTrigger" "playerrunscriptcodeScreenFade(null, 0, 0, 0, 255, 2, 0.4, 2)0-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 0, 0, 0, 255, 2, 0.4, 1)2-1"
				"OnTrigger" "MasqueradeIntroCamera1,CallScriptFunction,EnableAll,2,-1"
				
				"OnTrigger" "MasqueradeIntroParticle,Start,,10,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/fire/ignite.wav,10,-1"
				"OnTrigger" "tf_gamerules,PlayVO,ambient/fire/fire_small_loop1.wav,10,-1"

				"OnTrigger" "MasqueradeIntroParticle2,Start,,13,-1"
				"OnTrigger" "tf_gamerules,$StopVO,ambient/fire/fire_small_loop1.wav,13,-1"
				"OnTrigger" "tf_gamerules,$StopVO,ambient/fire/fire_small_loop1.wav,13.1,-1"
