			Param "
					EntFire(`wave_start_boss_relay`, `Trigger`)
					EntFire(`MasqueradeIntroRelay`, `Trigger`)
					EntFire(`BombSetupRelay`, `Trigger`)
				  "
		}

		Explanation  
		{
			Line ""
			Line "{12E8EE}This mission will feature music potentially protected by copyright."
			Line "{12E8EE}Those tracks include: Ultrakill OST by Arsi Hakita Patala."
			Line "{12E8EE}Opt in/out with the Music Volume Slider in the settings."
			Line ""
		}

		// Subwave 1
		WaveSpawn
		{
			Name "Wave1_Subwave1_Necromancer"
			Where spawnbot_chief
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 68
			WaitBetweenSpawns 0
			TotalCurrency 100


		}
	}
	// Wave 2 Notes
	Wave
	{
		InitWaveOutput
		{
			Target BigNet
