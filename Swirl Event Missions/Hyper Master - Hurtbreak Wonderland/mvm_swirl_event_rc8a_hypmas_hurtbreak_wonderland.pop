				"OnTrigger" "BigNet,RunScriptCode,MusicSystemMent.SetMusicTrack(`#music/in_absentia_logos.wav`),25,-1"
				"OnTrigger" "Player,$DisplayTextChat,{00FFFF}Now Playing: {FFFFFF}In Absentia Logos - Heaven Pierce Her,25,-1"
