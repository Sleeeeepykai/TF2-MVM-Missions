				"OnTrigger" "MasqueradeIntroParticle2,Stop,,16,-1"
				"OnTrigger" "MasqueradeIntroParticle3,Start,,16,-1"

				"OnTrigger" "tf_gamerules,$StopVO,ambient/fire/fire_big_loop1.wav,16,-1"
				"OnTrigger" "tf_gamerules,$StopVO,ambient/fire/fire_big_loop1.wav,16.1,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode.wav,16,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 110, 0.7, 1.5, 1)16-1"
				"OnTrigger" "MasqueradeIdleRelay,Trigger,,16,-1"

				"OnTrigger" "MasqueradeTextCard,$setkey$message,Oh what's up?,23.9,-1"
				"OnTrigger" "MasqueradeTextCard,Display,,24,-1"
				"OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/scout_mvm_m_beingshotinvincible06.mp3,24,-1"
