#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

// Gameplay:
// Players are trapped in an arena
// Their spawns have changed
// They have jump-pads to go to spawn
// They have control points to defend instead of a bomb
// Robots will try to capture the control points

WaveSchedule
{
	StartingCurrency 400
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10
	
	//// PRECACHES ////

	// Precached Models

	PrecacheModel "models/effects/mvm_holograms/mvm_cappoint_hologram.mdl"
	PrecacheModel "models/effects/mvm_holograms/mvm_cappoint_hologram_onlyblue.mdl"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		"PunchieCapHat"
		{
			OriginalItemName "Potato of Labor"

			"set item tint rgb" 15787660
			"custom item model" "models/player/items/heavy/pugilist_protector.mdl"
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// Core PTs ////

		CorePTs
		{
			logic_auto
			{
				"targetname" "MissionSetup"

				"OnMapSpawn" "arena_mode_enable_relay,Trigger,,0,-1"
			}

			logic_timer
			{
				"targetname" "MissionAlarmTimer"
				"RefireTime" "12"

				"OnTimer" "arena_mode_lockdown_alarm,PlaySound,,0.1,-1"
				"OnTimer" "arena_mode_lockdown_alarm,StopSound,,6,-1"
			}

			func_respawnroom
			{
				"targetname" "ArenaBotRespawnRoom"
				"origin" "480 4856 416"
				"mins" "-1216 -856 -800"
				"maxs" "1216 856 800"

				"teamnum" "3"
			}

			logic_relay
			{
				"targetname" "MissionIntroRelay"

				"OnTrigger" "arena_mode_transition_text1,Show,,0,-1"
				"OnTrigger" "arena_mode_controlpointtext1,Show,,5,-1"
				"OnTrigger" "arena_mode_controlpointtext2,Show,,10,-1"
			}
			logic_relay
			{
				"targetname" "ArenaWaveStartRelay"

				"OnTrigger" "MissionAlarmTimer,Disable,,0,-1"
				"OnTrigger" "bombpath_left_avoid,Disable,,0,-1"
				"OnTrigger" "bombpath_right_avoid,Disable,,0,-1"
				"OnTrigger" "arena_mode_maingate_open,Trigger,,0,-1"
				"OnTrigger" "arena_mode_maingate_spawnbot_enable,Trigger,,0,-1"
				"OnTrigger" "arena_mode_spawnbotleft_enable,Trigger,,0,-1"
				"OnTrigger" "arena_mode_spawnbotright_enable,Trigger,,0,-1"
			}

			training_annotation
			{
				"targetname" "arena_mode_controlpointtext1"

				"origin" "632 2620 712"
				"display_text" "We now must control key areas to keep our foothold."
				"lifetime" "5"
			}
			training_annotation
			{
				"targetname" "arena_mode_controlpointtext2"

				"origin" "632 2620 712"
				"display_text" "Do not let the robots capture them!"
				"lifetime" "5"
			}
		}

		ControlPointPTs
		{
			logic_auto
			{
				"targetname" "ControlPointSetup"
				
				"OnMapSpawn" "ControlPointACaptureArea,SetControlPoint,ControlPointA,0,-1"
				"OnMapSpawn" "ControlPointBCaptureArea,SetControlPoint,ControlPointB,0,-1"
				"OnMapSpawn" "ControlPointCCaptureArea,SetControlPoint,ControlPointC,0,-1"
			}
			team_control_point_master // Control Point Display
			{
				"targetname" "ControlPointMaster"
				"cpm_restrict_team_cap_win" "2"
				"custom_position_x" "0.435"
				"custom_position_y" "0.75"
			}
			filter_tf_bot_has_tag // Control Point Bot Filter
			{
				"targetname" "ControlPointFilter"
				"tags" "ArenaCaptureBot"
			}

			// Control Point A
			prop_dynamic // Control Point A Prop
			{
				"targetname" "ControlPointABase"
				"origin" "-820 2756 -87"
				"model" "models/props_gameplay/cap_point_base.mdl"
				"solid" "0"
				"skin" "1"
				"disableshadows" "1"
			}
			team_control_point // Control Point A Entity
			{
				"targetname" "ControlPointA"
				"origin" "-820 2756 -83"

				"point_printname" "Alpha"
				"point_index" "0"
				"point_group" "0"
				"point_default_owner" "2"
				"point_start_locked" "0"
				"team_previouspoint_2_0" "ControlPointA"
				"team_previouspoint_3_0" "ControlPointA"

				"team_model_0" "models/effects/mvm_holograms/mvm_cappoint_hologram.mdl"
				"team_icon_0" "sprites/obj_icons/icon_obj_neutral"
				"team_overlay_0" "sprites/obj_icons/icon_obj_a"

				"team_model_2" "models/effects/mvm_holograms/mvm_cappoint_hologram.mdl"
				"team_icon_2" "sprites/obj_icons/icon_obj_red"
				"team_overlay_2" "sprites/obj_icons/icon_obj_a"

				"team_model_3" "models/effects/mvm_holograms/mvm_cappoint_hologram_onlyblue.mdl"
				"team_icon_3" "sprites/obj_icons/icon_obj_blu"
				"team_overlay_3" "sprites/obj_icons/icon_obj_a"

				"disableshadows" "1"
			}
			trigger_capture_area // Control Point A Capture Area
			{
				"targetname" "ControlPointACaptureArea"
				"filtername" "ControlPointFilter"
				"origin" "-820 2756 40"
				"mins" "-112 -112 -128"
				"maxs" "112 112 128"
				"solid" "0"

				"area_cap_point" "ControlPointA"
				"area_time_to_cap" "10"
				"team_cancap_2" "1"
				"team_cancap_3" "1"

				"disableshadows" "1"

				"OnCapTeam1" "ControlPointABase,Skin,1,0,-1"
				"OnCapTeam2" "ControlPointABase,Skin,2,0,-1"
			}

			// Control Point B
			prop_dynamic // Control Point B Prop
			{
				"targetname" "ControlPointBBase"
				"origin" "750 2672 160"
				"model" "models/props_gameplay/cap_point_base.mdl"
				"solid" "0"
				"skin" "1"
				"disableshadows" "1"
			}
			team_control_point // Control Point B Entity
			{
				"targetname" "ControlPointB"
