	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePTs"
	SpawnTemplate "ControlPointPTs"

	//// EXTRA TANK PATHS ////

	//// EXTRA SPAWN POINTS ////

	ExtraSpawnPoint
	{
		Name "spawnbot_arena_mainleft"
		X 224 Y 4376 Z -192
		TeamNum 3
	}
	ExtraSpawnPoint
	{
		Name "spawnbot_arena_mainright"
		X 736 Y 4384 Z -192
		TeamNum 3
	}

	//// ROBOT TEMPLATES ////

	Templates
	{
		//// GIANTS ////
		T_TFBot_Giant_Soldier_PointB
		{
			Template T_TFBot_Giant_Soldier
			Action Mobber

			Tag ArenaCaptureBot

			Item "MvM GateBot Light Soldier"

			InterruptAction
			{
				Target "ControlPointB"
				Delay 0.1
				Repeats 0
				Cooldown 5
				Duration 5
				Distance 100
			}
		}

		//// MINIGIANTS ////
		T_TFBot_Demoman_Spammer_PointA
		{
			Template T_TFBot_Demoman_Spammer
			Action Mobber

			Tag ArenaCaptureBot

			Item "MvM GateBot Light Demoman"

			InterruptAction
			{
				Target "ControlPointA"
				Delay 0.1
				Repeats 0
				Cooldown 5
				Duration 5
				Distance 100
			}
		}
		T_TFBot_Demoman_Spammer_PointC
		{
			Template T_TFBot_Demoman_Spammer
			Action Mobber

			Tag ArenaCaptureBot

			Item "MvM GateBot Light Demoman"

			InterruptAction
			{
				Target "ControlPointA"
				Delay 0.1
				Repeats 0
				Cooldown 5
				Duration 5
				Distance 100
			}
		}

		//// COMMONS ////
		T_TFBot_Heavy_Lightweight_Champ_PointC
		{
			Name "Lightweight Champ"
			Class Heavy
			ClassIcon heavy_gru
			Skill Easy
			WeaponRestrictions MeleeOnly
			Action Mobber

			Tag ArenaCaptureBot

			Item "Gloves of Running Urgently MvM"

			Item "PunchieCapHat" [$SIGSEGV]
			Item "MvM GateBot Light Heavy"

			InterruptAction
			{
				Target "ControlPointC"
				Delay 0.1
				Repeats 0
				Cooldown 5
				Duration 5
				Distance 100
			}
		}
	}

	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_arena_mainleft [$SIGSEGV]
		Where spawnbot_arena_mainright [$SIGSEGV]
		BeginAtWave 1
		RunForThisManyWaves 7
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 1
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	//// WAVES ////
	Wave
	{
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
					EntFire(`MissionIntroRelay`, `Trigger`)
					EntFire(`ArenaWaveStartRelay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
		}

		// Subwave 1
		WaveSpawn // 1 GSoldier and 1 Full-Uber Medic
		{
			Name "Wave1_Subwave1_GSoldier"
			Where spawnbot_arena_mainleft [$SIGSEGV]
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 15
			WaitBetweenSpawns 0
			TotalCurrency 100

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_PointB
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
			}
		}
		WaveSpawn // 2 Rapid Fire Demos
		{
			Name "Wave1_Subwave1_RapidDemo"
			Where spawnbot_arena_mainright [$SIGSEGV]
			TotalCount 2
			MaxActive 2
			SpawnCount 1
			WaitBeforeStarting 15
			WaitBetweenSpawns 10
			TotalCurrency 40

			TFBot
			{
				Template T_TFBot_Demoman_Spammer
				Action Mobber
			}
		}
		WaveSpawn // 10 KGB Heavies
