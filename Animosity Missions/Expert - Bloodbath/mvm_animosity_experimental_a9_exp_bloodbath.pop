	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"
	SpawnTemplate "ControlPointPT"

	//// EXTRA TANK PATHS ////

	//// EXTRA SPAWN POINTS ////

	ExtraSpawnPoint
	{
		Name "spawnbot_arena_mainleft"
		X 224 Y 4376 Z -192
		TeamNum 3
	}
	ExtraSpawnPoint
	{
		Name "spawnbot_arena_mainright"
		X 736 Y 4384 Z -192
		TeamNum 3
	}

	//// ROBOT TEMPLATES ////

	Templates
	{
		//// GIANTS ////
		T_TFBot_Giant_Soldier_CaptureBot
		{
			Template T_TFBot_Giant_Soldier
			Action Mobber

			Tag ArenaCaptureBot

			Item "MvM GateBot Light Soldier"

			InterruptAction
			{
				Target "ControlPointB"
				Delay 0.1
				Repeats 0
				Cooldown 5
				Duration 5
				Distance 100
			}
		}

		//// MINIGIANTS ////
		T_TFBot_Demoman_Spammer_CaptureBot
		{
			Template T_TFBot_Demoman_Spammer
			Action Mobber

			Tag ArenaCaptureBot

			Item "MvM GateBot Light Demoman"

		}

		//// COMMONS ////
		T_TFBot_Heavy_Lightweight_Champ_CaptureBot
		{
			Name "Lightweight Champ"
			Class Heavy
			ClassIcon heavy_gru
			Skill Easy
			WeaponRestrictions MeleeOnly
			Action Mobber

			Tag ArenaCaptureBot

			Item "Gloves of Running Urgently MvM"

			Item "PunchieCapHat" [$SIGSEGV]
			Item "MvM GateBot Light Heavy"

			InterruptAction
			{
				Target "ControlPointC"
				Delay 0.1
				Repeats 0
				Cooldown 5
				Duration 5
				Distance 100
			}
		}
	}

	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_arena_mainleft [$SIGSEGV]
		Where spawnbot_arena_mainright [$SIGSEGV]
		BeginAtWave 1
		RunForThisManyWaves 7
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 1
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

	//// WAVES ////

	// General Notes
	
	// Wave 1 Notes
	Wave
	{
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
					EntFire(`MissionIntroRelay`, `Trigger`)
					EntFire(`ArenaWaveStartRelay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
					EntFire(`ArenaWaveFinishRelay`, `Trigger`)
                  "
		}

		// Subwave 1
		WaveSpawn // 15 Punchies
		{
			Name "Wave1_Subwave1_Punchies"
			Where spawnbot_arena_mainleft [$SIGSEGV]
			Where spawnbot_arena_mainright [$SIGSEGV]
			RandomSpawn 1
			TotalCount 15
			MaxActive 15
			SpawnCount 15
			WaitBeforeStarting 0
			WaitBetweenSpawns 10
			TotalCurrency 100

			TFBot
			{
				Template T_TFBot_Heavy_Heavyweight_Champ
				Action Mobber
			}
		}

		WaveSpawn // 1 GSoldier and 3 Big-Heal Medics
		{
			Name "Wave1_Subwave1_GSoldier"
			WaitForAllSpawned "Wave1_Subwave1_Punchies"
			Where spawnbot_arena_mainleft [$SIGSEGV]
			TotalCount 4
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 5
			WaitBetweenSpawns 0
			TotalCurrency 100

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_PointB
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
			}
		}
		WaveSpawn // 2 Rapid Demos
		{
			Name "Wave1_Subwave1_RapidDemos"
			WaitForAllSpawned "Wave1_Subwave1_GSoldier"
			Where spawnbot_arena_mainright [$SIGSEGV]
			TotalCount 2
			MaxActive 2
			SpawnCount 1
			WaitBeforeStarting 5
			WaitBetweenSpawns 10
			TotalCurrency 60

			TFBot
			{
				Template T_TFBot_Demoman_Spammer
				Action Mobber
			}
		}
		WaveSpawn // 10 Punchies
		{
			Name "Wave1_Subwave1_Punchies2"
			WaitForAllSpawned "Wave1_Subwave1_GSoldier"
			Where spawnbot_arena_mainleft [$SIGSEGV]
			Where spawnbot_arena_mainright [$SIGSEGV]
			RandomSpawn 1
			TotalCount 10
			MaxActive 6
			SpawnCount 2
			WaitBeforeStarting 10
			WaitBetweenSpawns 2
			TotalCurrency 100

			TFBot
			{
				Template T_TFBot_Heavy_Heavyweight_Champ
				Action Mobber
			}
		}

		WaveSpawn // 1 GSoldier and 3 Big-Heal Medics
		{
			Name "Wave1_Subwave1_GSoldier2"
			WaitForAllSpawned "Wave1_Subwave1_GSoldier"
			Where spawnbot_arena_mainleft [$SIGSEGV]
			TotalCount 4
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 25
			WaitBetweenSpawns 0
			TotalCurrency 100

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Soldier_PointB
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
				TFBot
				{
					Template T_TFBot_Medic_BigHeal
				}
			}
		}
	}
	Wave
	{
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
					EntFire(`ArenaWaveStartRelay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
		}
	}
}