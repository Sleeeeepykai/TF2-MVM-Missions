#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 400
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	//// PRECACHES ////

	// Precached Models

	PrecacheModel "models/effects/mvm_holograms/mvm_cappoint_hologram.mdl"
	PrecacheModel "models/effects/mvm_holograms/mvm_cappoint_hologram_onlyblue.mdl"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		"PunchieCapHat"
		{
			OriginalItemName "Potato of Labor"

			"set item tint rgb" "15787660"
			"custom item model" "models/player/items/heavy/pugilist_protector.mdl"
		}

		"SoldierDefenderCapHat"
		{
			OriginalItemName "MvM GateBot Light Soldier"

			"attach particle effect" "3043"
			"item color rgb" "7799039"
		}
		"PyroDefenderCapHat"
		{
			OriginalItemName "MvM GateBot Light Pyro"

			"attach particle effect" "3043"
			"item color rgb" "7799039"
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// Core PTs ////

		CorePT
		{
			logic_auto
			{
				"targetname" "MissionSetup"

				"OnMapSpawn" "arena_mode_enable_relay,Trigger,,0,-1"
			}

			// Global Filters
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
		}

		MissionPT
		{
			logic_timer
			{
				"targetname" "MissionAlarmTimer"
				"RefireTime" "30"

				"OnTimer" "arena_mode_lockdown_alarm,PlaySound,,0.1,-1"
				"OnTimer" "arena_mode_lockdown_alarm,StopSound,,6,-1"
			}

			func_respawnroom
			{
				"targetname" "ArenaBotRespawnRoom"
				"origin" "480 4856 416"
				"mins" "-1216 -856 -800"
				"maxs" "1216 856 800"

				"teamnum" "3"
			}

			logic_relay
			{
				"targetname" "MissionIntroRelay"

				"OnTrigger" "arena_mode_transition_text1,Show,,0,-1"
				"OnTrigger" "arena_mode_controlpointtext1,Show,,5,-1"
				"OnTrigger" "arena_mode_controlpointtext2,Show,,10,-1"
			}
			logic_relay
			{
				"targetname" "MissionDefenderIntroRelay"

				"OnTrigger" "arena_mode_defendertext1,Show,,0,-1"
			}
			logic_relay
			{
				"targetname" "ArenaWaveStartRelay"

				"OnTrigger" "MissionAlarmTimer,Disable,,0,-1"
				"OnTrigger" "bombpath_left_avoid,Disable,,0,-1"
				"OnTrigger" "bombpath_right_avoid,Disable,,0,-1"
				"OnTrigger" "arena_mode_maingate_open,Trigger,,0,-1"
				"OnTrigger" "arena_mode_maingate_spawnbot_enable,Trigger,,0,-1"
				"OnTrigger" "arena_mode_spawnbotleft_enable,Trigger,,0,-1"
				"OnTrigger" "arena_mode_spawnbotright_enable,Trigger,,0,-1"
			}
			logic_relay
			{
				"targetname" "ArenaWaveFinishRelay"

				"OnTrigger" "arena_mode_maingate_close,Trigger,,0,-1"
				"OnTrigger" "arena_mode_maingate_spawnbot_disable,Trigger,,0,-1"
			}

			training_annotation
			{
				"targetname" "arena_mode_controlpointtext1"

				"origin" "632 2620 712"
				"display_text" "We now must control key areas to keep our foothold."
				"lifetime" "5"
			}
			training_annotation
			{
				"targetname" "arena_mode_controlpointtext2"

				"origin" "632 2620 712"
				"display_text" "Do not let the robots capture them!"
				"lifetime" "5"
			}

			training_annotation
			{
				"targetname" "arena_mode_defendertext1"

				"origin" "480 4000 192"
				"display_text" "Robots with glowing purple hats will defend the points."
				"lifetime" "5"
			}
		}

		ControlPointPT
		{
			logic_auto
			{
				"targetname" "ControlPointSetup"

				"OnMapSpawn" "ControlPointACaptureArea,SetControlPoint,ControlPointA,0,-1"
