	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_arena_mainleft [$SIGSEGV]
		Where spawnbot_arena_mainright [$SIGSEGV]
		BeginAtWave 1
		RunForThisManyWaves 7
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	Mission // Spy (Wave 3)
	{
		Objective Spy
		Where spawnbot_arena_mainleft [$SIGSEGV]
		Where spawnbot_arena_mainright [$SIGSEGV]
		BeginAtWave 3
		RunForThisManyWaves 1
		InitialCooldown 10
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Spy
		}
	}

