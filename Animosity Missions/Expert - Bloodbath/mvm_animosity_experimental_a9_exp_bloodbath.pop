#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 400
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10
	
	//// PRECACHES ////

	// Precached Models

	PrecacheModel "models/effects/mvm_holograms/mvm_cappoint_hologram.mdl"
	PrecacheModel "models/effects/mvm_holograms/mvm_cappoint_hologram_onlyblue.mdl"

	//// CUSTOM WEAPONS ////

	CustomWeapon
	{
		"PunchieCapHat"
		{
			OriginalItemName "Potato of Labor"

			"set item tint rgb" 15787660
			"custom item model" "models/player/items/heavy/pugilist_protector.mdl"
		}
	}

	//// POINT TEMPLATES ////

	PointTemplates
	{
		//// Core PTs ////

		CorePT
		{
			logic_auto
			{
				"targetname" "MissionSetup"

				"OnMapSpawn" "arena_mode_enable_relay,Trigger,,0,-1"
			}

			logic_timer
			{
				"targetname" "MissionAlarmTimer"
				"RefireTime" "12"

				"OnTimer" "arena_mode_lockdown_alarm,PlaySound,,0.1,-1"
				"OnTimer" "arena_mode_lockdown_alarm,StopSound,,6,-1"
			}

			func_respawnroom
			{
				"targetname" "ArenaBotRespawnRoom"
				"origin" "480 4856 416"
				"mins" "-1216 -856 -800"
				"maxs" "1216 856 800"

				"teamnum" "3"
			}

			logic_relay
			{
				"targetname" "MissionIntroRelay"

				"OnTrigger" "arena_mode_transition_text1,Show,,0,-1"
				"OnTrigger" "arena_mode_controlpointtext1,Show,,5,-1"
				"OnTrigger" "arena_mode_controlpointtext2,Show,,10,-1"
			}
			logic_relay
			{
				"targetname" "ArenaWaveStartRelay"

				"OnTrigger" "MissionAlarmTimer,Disable,,0,-1"
				"OnTrigger" "bombpath_left_avoid,Disable,,0,-1"
				"OnTrigger" "bombpath_right_avoid,Disable,,0,-1"
				"OnTrigger" "arena_mode_maingate_open,Trigger,,0,-1"
				"OnTrigger" "arena_mode_maingate_spawnbot_enable,Trigger,,0,-1"
				"OnTrigger" "arena_mode_spawnbotleft_enable,Trigger,,0,-1"
				"OnTrigger" "arena_mode_spawnbotright_enable,Trigger,,0,-1"
			}
			logic_relay
			{
				"targetname" "ArenaWaveFinishRelay"

				"OnTrigger" "arena_mode_maingate_close,Trigger,,0,-1"
				"OnTrigger" "arena_mode_maingate_spawnbot_disable,Trigger,,0,-1"
			}

			training_annotation
			{
				"targetname" "arena_mode_controlpointtext1"

				"origin" "632 2620 712"
				"display_text" "We now must control key areas to keep our foothold."
				"lifetime" "5"
			}
			training_annotation
			{
				"targetname" "arena_mode_controlpointtext2"

				"origin" "632 2620 712"
				"display_text" "Do not let the robots capture them!"
				"lifetime" "5"
			}

			// Global Filters
			filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		ControlPointPT
		{
			logic_auto
			{
				"targetname" "ControlPointSetup"
				
				"OnMapSpawn" "ControlPointACaptureArea,SetControlPoint,ControlPointA,0,-1"
				"OnMapSpawn" "ControlPointBCaptureArea,SetControlPoint,ControlPointB,0,-1"
				"OnMapSpawn" "ControlPointCCaptureArea,SetControlPoint,ControlPointC,0,-1"
			}
			team_control_point_master // Control Point Display
			{
				"targetname" "ControlPointMaster"
				"cpm_restrict_team_cap_win" "2"
				"custom_position_x" "0.435"
				"custom_position_y" "0.75"
			}
			filter_multi // Control Point Filter
			{
				"targetname" "ControlPointFilter"
				"Negated" "0"
				"FilterType" "1"
				"Filter01"   "ControlPointPlayerFilter"
                "Filter02"   "ControlPointBotFilter"
			}
			filter_multi // Control Point Player Filter
			{
				"targetname" "ControlPointPlayerFilter"
				"Negated" "0"
				"FilterType" "0"
				"Filter01"   "filter_is_player"
				"Filter02"   "filter_redteam"
                "Filter03"   "filter_is_not_ubered"
                "Filter04"   "filter_is_not_ubered2"
                "Filter05"   "filter_is_not_ubered3"
                "Filter06"   "filter_is_not_ubered4"
			}
			filter_multi // Control Point Bot Filter
			{
				"targetname" "ControlPointBotFilter"
				"Filter01"   "filter_is_player"
				"Filter02"   "ControlPointBotTagFilter"
                "Filter03"   "filter_is_not_ubered"
                "Filter04"   "filter_is_not_ubered2"
                "Filter05"   "filter_is_not_ubered3"
                "Filter06"   "filter_is_not_ubered4"
			}
			filter_tf_bot_has_tag // Control Point Bot Tag Filter
			{
				"targetname" "ControlPointBotTagFilter"
				"tags" "ArenaCaptureBot"
			}

			// Control Point A
			prop_dynamic // Control Point A Prop
			{
				"targetname" "ControlPointABase"
				"origin" "-820 2756 -87"
				"model" "models/props_gameplay/cap_point_base.mdl"
				"solid" "0"
				"skin" "1"
				"disableshadows" "1"
			}
			team_control_point // Control Point A Entity
			{
				"targetname" "ControlPointA"
				"origin" "-820 2756 -83"

				"point_printname" "Alpha"
				"point_index" "0"
