#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 400
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 3000
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

    BodyPartScaleSpeed 10

    MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

	//// PRECACHES ////

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(???) Majesty's Madness`)
						
                        Convars.SetValue(`tf_playergib`, 0)

						IncludeScript(`tankextensions_main`)
					  "
			}

			// Universal Filters
            filter_activator_class // Is a Player
            {
                "targetname" "filter_is_player"
                "Negated" "0"
                "filterclass" "player"
            }
            filter_multi // Is a Red Player
            {
                "targetname" "filter_is_red_player"
                "Negated"	"0"
                "FilterType" "0"			
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_player"
            }
            filter_tf_condition // Medigun Uber Filter
            {
                "targetname" "filter_is_not_ubered"
                "Negated"	"1"
                "condition"  "5" //medigun uber
            }
            filter_tf_condition // Canteen Uber Filter
            {
                "targetname" "filter_is_not_ubered2"
                "Negated"	"1"
                "condition"  "52" //canteen uber
            }
            filter_tf_condition // MVM Spawn Uber Filter
            {
                "targetname" "filter_is_not_ubered3"
                "Negated"	"1"
                "condition"  "51" //hidden uber
            }
            filter_tf_condition // Wheel of Fate Uber ilter
            {
                "targetname" "filter_is_not_ubered4"
                "Negated"	"1"
                "condition"  "57" //WoF uber
            }
            filter_multi // Is an Un-Ubered Red Player
            {
                "targetname" "filter_redteam_nouber"
                "Negated"	"0"
                "FilterType" "0" //and				
                "Filter01"   "filter_redteam"
                "Filter02"   "filter_is_not_ubered"
                "Filter03"   "filter_is_not_ubered2"
                "Filter04"   "filter_is_not_ubered3"
                "Filter05"   "filter_is_not_ubered4"
                "Filter06"   "filter_is_player"
            }
            filter_multi // Is an Un-Ubered Player
            {
                "targetname" "filter_nouber"
                "Negated"	"0"
                "FilterType" "0"
                "Filter01"   "filter_is_not_ubered"
                "Filter02"   "filter_is_not_ubered2"
                "Filter03"   "filter_is_not_ubered3"
                "Filter04"   "filter_is_not_ubered4"
                "Filter05"   "filter_is_player"
            }
		}

		MissionPT
		{
			logic_relay
			{
				"targetname" "TankStopRelay"
				"OnTrigger" "tank_boss*,SetSpeed,0,0,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`doors/heavy_metal_stop1.wav`);EmitSoundEx({sound_name=`doors/heavy_metal_stop1.wav`,pitch = 90,filter_type=5})0-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`hl1/ambience/steamburst1.wav`);EmitSoundEx({sound_name=`hl1/ambience/steamburst1.wav`,pitch = 100,filter_type=5})0-1"
			}
			logic_relay
			{
				"targetname" "TankMoveRelay"

				"OnTrigger" "tank_boss*,SetSpeed,15,0,-1"
				"OnTrigger" "tank_boss*,SetSpeed,35,1.5,-1"
				"OnTrigger" "tank_boss*,SetSpeed,50,3,-1"
				"OnTrigger" "BigNetRunScriptCodePrecacheSound(`mvm/mvm_tank_horn.wav`);EmitSoundEx({sound_name=`mvm/mvm_tank_horn.wav`,pitch = 85,filter_type=5})0-1"
			}
			logic_relay
			{
				"targetname" "TankCleanupRelay"

				"OnTrigger" "tank_boss*,RemoveHealth,100000,0,-1"
			}
		}
	}

	//// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"
	SpawnTemplate "MissionPT"

	//// ROBOT TEMPLATES ////

	//// MISSION BOTS ////

	Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_mission_sentry_buster
		BeginAtWave 1
		RunForThisManyWaves 6
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 1
		
		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}

    Mission // Spy (Wave 1)
	{
		Objective Spy  
		Where spawnbot_mission_spy
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 15
		CooldownTime 45
		DesiredCount 3

		TFBot
		{
			Template T_TFBot_Spy
		}
	}
    Mission // Engineer (Wave 1)
	{
		Objective Engineer
		Where spawnbot
		BeginAtWave 1
		RunForThisManyWaves 1
		InitialCooldown 60
		CooldownTime 60
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter_TeleIn
            TeleportWhere spawnbot
            TeleportWhere flankers
		}
	}

    Mission // Sniper (Wave 2)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 2
		RunForThisManyWaves 2
		InitialCooldown 45
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
    Mission // Engineer (Wave 2)
	{
		Objective Engineer
		Where spawnbot
		BeginAtWave 2
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 45
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_Engineer_Sentry_Teleporter_TeleIn
            TeleportWhere spawnbot
            TeleportWhere flankers
		}
	}

	//// WAVES ////

	Wave
	{
		InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_a_init`, `Trigger`)
                    EntFire(`radio_music_stop`, `Trigger`)
                "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
        WaveSpawn // 1 GScout
        {
            Name "Wave1_Subwave1_GScout"
            Where spawnbot
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 0
            WaitBetweenSpawns 0
            TotalCurrency 40

            TFBot
            {
                Template T_TFBot_Giant_Scout
                Skill Normal
                Attributes HoldFireUntilFullReload
            }
        }
        WaveSpawn // 14 Soldiers
        {
            Name "Wave1_Subwave1_Soldiers"
            WaitForAllSpawned "Wave1_Subwave1_GScout"
            Where spawnbot
            TotalCount 14
            MaxActive 14
            SpawnCount 14
            WaitBeforeStarting 0
            WaitBetweenSpawns 0
            TotalCurrency 100

            TFBot
            {
                Class Soldier
                Skill Easy
            }
        }

        WaveSpawn // Support Demoknights
        {
            Name "Wave1_Subwave1_Demoknights"
            WaitForAllSpawned "Wave1_Subwave1_GScout"
            Where flankers
            Support 1
            TotalCount 50
            MaxActive 6
			SpawnCount 3
			WaitBeforeStarting 5
			WaitBetweenSpawns 15
            TotalCurrency 100

            TFBot
            {
                Template T_TFBot_Demoman_Knight
            }
        }

        WaveSpawn // 1 GBurst Soldier and 1 Quick-Uber Medic
        {
            Name "Wave1_Subwave1_GBurstSoldier"
            WaitForAllSpawned "Wave1_Subwave1_GScout"
            Where spawnbot
            TotalCount 2
            MaxActive 2
            SpawnCount 2
            WaitBeforeStarting 10
            WaitBetweenSpawns 0
            TotalCurrency 40

            Squad
            {
                TFBot
                {
                    Template T_TFBot_Giant_Soldier_Burst
                }
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
            }
        }
        WaveSpawn // 14 Bat Scouts
        {
            Name "Wave1_Subwave1_Scouts"
            WaitForAllSpawned "Wave1_Subwave1_GBurstSoldier"
            Where spawnbot_invasion
            TotalCount 14
            MaxActive 6
            SpawnCount 2
            WaitBeforeStarting 2
            WaitBetweenSpawns 2
            TotalCurrency 20

            TFBot
            {
                Template T_TFBot_Scout_Melee
            }
        }
        WaveSpawn // 3 Heavies and 3 Quick-Uber Medics
        {
            Name "Wave1_Subwave1_Heavies"
            WaitForAllSpawned "Wave1_Subwave1_GBurstSoldier"
            Where spawnbot
            TotalCount 6
            MaxActive 6
            SpawnCount 2
            WaitBeforeStarting 8
            WaitBetweenSpawns 2
            TotalCurrency 40

            Squad
            {
                TFBot
                {
                    Class Heavy
                    Skill Easy
                }
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
            }
        }

        WaveSpawn // 1 GBurst Soldier and 1 Quick-Uber Medic
        {
            Name "Wave1_Subwave1_GBurstSoldier2"
            WaitForAllSpawned "Wave1_Subwave1_GScout"
            Where spawnbot
            TotalCount 2
            MaxActive 2
            SpawnCount 2
            WaitBeforeStarting 18
            WaitBetweenSpawns 0
            TotalCurrency 40

            Squad
            {
                TFBot
                {
                    Template T_TFBot_Giant_Soldier_Burst
                }
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
            }
        }
        WaveSpawn // 14 Bat Scouts
        {
            Name "Wave1_Subwave1_Scouts2"
            WaitForAllSpawned "Wave1_Subwave1_GBurstSoldier2"
            Where spawnbot_invasion
            TotalCount 14
            MaxActive 6
            SpawnCount 2
            WaitBeforeStarting 2
            WaitBetweenSpawns 2
            TotalCurrency 20

            TFBot
            {
                Template T_TFBot_Scout_Melee
            }
        }
        WaveSpawn // 12 Soldiers
        {
            Name "Wave1_Subwave1_Soldiers2"
            WaitForAllSpawned "Wave1_Subwave1_GBurstSoldier2"
            Where spawnbot
            TotalCount 12
            MaxActive 8
            SpawnCount 4
            WaitBeforeStarting 2
            WaitBetweenSpawns 5
            TotalCurrency 40

            TFBot
            {
                Class Soldier
                Skill Easy
            }
        }

        // Subwave 2
        WaveSpawn // 1 GScout
        {
            Name "Wave1_Subwave2_GScout"
            WaitForAllSpawned "Wave1_Subwave1_GBurstSoldier2"
            Where spawnbot
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 18
            WaitBetweenSpawns 0
            TotalCurrency 40

            TFBot
            {
                Template T_TFBot_Giant_Scout
                Skill Normal
                Attributes HoldFireUntilFullReload
            }
        }
        WaveSpawn // 6 Demomen and 6 Quick-Uber Medics
        {
            Name "Wave1_Subwave2_Demomen"
            WaitForAllSpawned "Wave1_Subwave2_GScout"
            Where spawnbot
            TotalCount 12
            MaxActive 6
            SpawnCount 2
            WaitBeforeStarting 2
            WaitBetweenSpawns 3
            TotalCurrency 60

            Squad
            {
                TFBot
                {
                    Class Demoman
                    Skill Hard
                }
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
            }
        }
        WaveSpawn // 6 Steel Gauntlets
        {
            Name "Wave1_Subwave2_SteelGauntlets"
            WaitForAllSpawned "Wave1_Subwave2_GScout"
            Where spawnbot
            TotalCount 6
            MaxActive 4
            SpawnCount 2
            WaitBeforeStarting 2
            WaitBetweenSpawns 6
            TotalCurrency 60

            TFBot
            {
                Template T_TFBot_Heavy_SteelFist
            }
        }
        WaveSpawn // 12 Heavies
        {
            Name "Wave1_Subwave2_Heavies"
            WaitForAllSpawned "Wave1_Subwave2_GScout"
            Where flankers
            TotalCount 12
            MaxActive 6
            SpawnCount 1
            WaitBeforeStarting 2
            WaitBetweenSpawns 1
            TotalCurrency 60

            TFBot
            {
                Class Heavy
                Skill Easy
            }
        }

        WaveSpawn // 6 Demomen and 6 Quick-Uber Medics
        {
            Name "Wave1_Subwave2_Demomen2"
            WaitForAllSpawned "Wave1_Subwave2_Demomen"
            Where spawnbot
            TotalCount 12
            MaxActive 6
            SpawnCount 2
            WaitBeforeStarting 3
            WaitBetweenSpawns 3
            TotalCurrency 60

            Squad
            {
                TFBot
                {
                    Class Demoman
                    Skill Hard
                }
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
            }
        }
        WaveSpawn // 6 Steel Gauntlets
        {
            Name "Wave1_Subwave2_SteelGauntlets2"
            WaitForAllSpawned "Wave1_Subwave2_Demomen"
            Where spawnbot
            TotalCount 6
            MaxActive 4
            SpawnCount 2
            WaitBeforeStarting 6
            WaitBetweenSpawns 6
            TotalCurrency 60

            TFBot
            {
                Template T_TFBot_Heavy_SteelFist
            }
        }
        WaveSpawn // 12 Heavies
        {
            Name "Wave1_Subwave2_Heavies2"
            WaitForAllSpawned "Wave1_Subwave2_Demomen"
            Where flankers
            TotalCount 12
            MaxActive 9
            SpawnCount 6
            WaitBeforeStarting 4
            WaitBetweenSpawns 8
            TotalCurrency 60

            TFBot
            {
                Class Heavy
                Skill Easy
            }
        }

        // Subwave 3
        WaveSpawn // 1 GBurst Soldier and 3 Quick-Uber Medics
        {
            Name "Wave1_Subwave3_GBurstSoldier"
            WaitForAllSpawned "Wave1_Subwave2_Demomen2"
            Where spawnbot
            TotalCount 4
            MaxActive 4
            SpawnCount 4
            WaitBeforeStarting 12
            TotalCurrency 100

            Squad
            {
                TFBot
                {
                    Template T_TFBot_Giant_Soldier_Burst
                }
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
                TFBot
                {
                    Template T_TFBot_Medic_QuickUber
                }
            }
        }
        WaveSpawn // 14 Demomen
        {
            Name "Wave1_Subwave3_Demomen"
            WaitForAllSpawned "Wave1_Subwave3_GBurstSoldier"
            Where spawnbot_invasion
            TotalCount 14
            MaxActive 14
            SpawnCount 1
            WaitBeforeStarting 6
            WaitBetweenSpawns 0.1
            TotalCurrency 60

            TFBot
            {
                Class Demoman
                Skill Easy
            }
        }
	}
    Wave
    {
        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_a_init`, `Trigger`)
                    EntFire(`radio_music_stop`, `Trigger`)
                "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

        // Subwave 1
        WaveSpawn // 1 Tank
        {
            Name "Wave2_Subwave1_Tank"
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 0
            WaitBetweenSpawns 0
            TotalCurrency 100

            Tank
            {
                Name "tankboss"
                Health 25000
                Speed 75
                StartingPathTrackNode "tank_path_a1"

                OnBombDroppedOutput
                {
                    Target boss_deploy_relay
                    Action Trigger
                }
            }
        }

        WaveSpawn // 1 GHeavy
        {
            Name "Wave2_Subwave1_GHeavy"
            Where spawnbot
            TotalCount 1
            MaxActive 1
            SpawnCount 1
            WaitBeforeStarting 0
            WaitBetweenSpawns 0
            TotalCurrency 40

            TFBot
            {
                Template T_TFBot_Giant_Heavy
            }
        }
        WaveSpawn // Support Scouts
		{
			Name "Wave2_Subwave1_Scouts"
            WaitForAllSpawned "Wave2_Subwave1_GHeavy"
			Where spawnbot
			Support 1
			TotalCount 100
			MaxActive 8
			SpawnCount 4
			WaitBeforeStarting 0
			WaitBetweenSpawns 8
			TotalCurrency 100
		
			TFBot
			{
				Class Scout
				Skill Easy
			}
		}
        

    }
