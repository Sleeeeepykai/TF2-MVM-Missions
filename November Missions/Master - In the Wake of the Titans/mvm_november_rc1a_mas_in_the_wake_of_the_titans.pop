#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop
WaveSchedule
{
    StartingCurrency 0
    RespawnWaveTime 1
    CanBotsAttackWhileInSpawnRoom No
    AddSentryBusterWhenDamageDealtExceeds 2500
    AddSentryBusterWhenKillCountExceeds 10

    WaveStartCountdown 5

    MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
                if(`NovemberMasterScript` in getroottable())
                {
				    NovemberMasterScript.Cleanup()
                }

                Convars.SetValue(`mp_capdeteriorate_time`, 90)
			  "
		Delay -1
	}

    //// DISABLED SOUNDS ////

    DisableSound "Announcer.MVM_Wave_End"
    DisableSound "Announcer.MVM_Final_Wave_End"
	DisableSound "Announcer.MVM_Bonus"
	DisableSound "Announcer.MVM_Get_To_Upgrade"

	DisableSound "Announcer.MVM_Bomb_Alert_Near_Hatch"
	DisableSound "Announcer.MVM_Robots_Planted"
	DisableSound "Announcer.MVM_Wave_Lose"
	DisableSound "Announcer.MVM_Game_Over_Loss"
	DisableSound "Announcer.MVM_Bomb_Reset"

	DisableSound "Announcer.MVM_Sentry_Buster_Alert"
	DisableSound "Announcer.MVM_Sentry_Buster_Alert_Another"
	DisableSound "Announcer.MVM_Spy_Alert"
	DisableSound "Announcer.mvm_spybot_death"
	DisableSound "Announcer.mvm_spybot_death_all"
	DisableSound "Announcer.MVM_First_Engineer_Teleport_Spawned"
	DisableSound "Announcer.MVM_Another_Engineer_Teleport_Spawned"
	DisableSound "Announcer.MVM_An_Engineer_Bot_Is_Dead_But_Not_Teleporter"
	DisableSound "Announcer.MVM_An_Engineer_Bot_Is_Dead"

	DisableSound "Announcer.MVM_Tank_Alert_Spawn"
	DisableSound "Announcer.MVM_Tank_Alert_Another"
	DisableSound "Announcer.MVM_Tank_Alert_Multiple"
	DisableSound "Announcer.MVM_Tank_Alert_Halfway"
	DisableSound "Announcer.MVM_Tank_Alert_Halfway_Multiple"
	DisableSound "Announcer.MVM_Tank_Alert_Near_Hatch"
	DisableSound "Announcer.MVM_Tank_Alert_Deploying"
	DisableSound "Announcer.MVM_Tank_Planted"
	DisableSound "Announcer.MVM_General_Destruction"

	DisableSound "Announcer.RoundBegins5Seconds"
	DisableSound "Announcer.RoundBegins4Seconds"
	DisableSound "Announcer.RoundBegins3Seconds"
	DisableSound "Announcer.RoundBegins2Seconds"
	DisableSound "Announcer.RoundBegins1Seconds"

    DisableSound "music.mvm_start_wave"
    DisableSound "music.mvm_start_mid_wave"
    DisableSound "music.mvm_start_tank_wave"
    DisableSound "music.mvm_start_last_wave"
    DisableSound "music.mvm_end_wave"
    DisableSound "music.mvm_end_tank_wave"
    DisableSound "music.mvm_end_mid_wave"
    DisableSound "music.mvm_end_last_wave"
    DisableSound "music.mvm_lost_wave"

    //// PRECACHES ////

    // Precached Music //

    PrecacheSound "november_master_finale_setup.mp3"

	PrecacheSound "november_master_finale_intro.mp3"
	PrecacheSound "november_master_finale_loop.mp3"

    // Precached Skybox //

    PrecacheGeneric "materials/skybox/sky_void_01bk.vmt"
    PrecacheGeneric "materials/skybox/sky_void_01bk.vtf"
    PrecacheGeneric "materials/skybox/sky_void_01dn.vmt"
    PrecacheGeneric "materials/skybox/sky_void_01dn.vtf"
    PrecacheGeneric "materials/skybox/sky_void_01ft.vmt"
    PrecacheGeneric "materials/skybox/sky_void_01ft.vtf"
    PrecacheGeneric "materials/skybox/sky_void_01lf.vmt"
    PrecacheGeneric "materials/skybox/sky_void_01lf.vtf"
    PrecacheGeneric "materials/skybox/sky_void_01rt.vmt"
    PrecacheGeneric "materials/skybox/sky_void_01rt.vtf"
    PrecacheGeneric "materials/skybox/sky_void_01up.vmt"
    PrecacheGeneric "materials/skybox/sky_void_01up.vtf"

    // Precached Soundscape //

    PrecacheGeneric "scripts/soundscapes_mvm_november_rc1a.txt"

    // Precached Colour Correction

    PrecacheGeneric "materials/colorcorrection/november_master_void.raw"
    PrecacheGeneric "materials/colorcorrection/november_master_finale.raw"
    PrecacheGeneric "materials/colorcorrection/november_master_void_finale.raw"

    //// POINT TEMPLATES ////

    PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						IncludeScript(`mvm_november_master_script`)

						if(`NovemberMasterScript` in getroottable())
						{
							NovemberMasterScript.SetAmbienceNormal()
						}

						EntFire(`control_point_area`, `Kill`)

						Convars.SetValue(`mp_capdeteriorate_time`, 0)

						PrecacheSound(`ambient/levels/citadel/strange_talk9.wav`)
						PrecacheSound(`weapons/bottle_broken_hit_world1.wav`)
						PrecacheSound(`weapons/bottle_broken_hit_world2.wav`)
						PrecacheSound(`weapons/bottle_broken_hit_world3.wav`)
						PrecacheSound(`physics/glass/glass_sheet_break2.wav`)

						PrecacheSound(`vo/mvm/mght/heavy_mvm_m_domination08.mp3`)
						PrecacheSound(`vo/mvm/mght/soldier_mvm_m_laughshort02.mp3`)
						PrecacheSound(`vo/mvm/norm/medic_mvm_negativevocalization07.mp3`)
						PrecacheSound(`vo/mvm/mght/pyro_mvm_m_laughhappy01.mp3`)
						PrecacheSound(`vo/mvm/mght/demoman_mvm_m_gibberish07.mp3`)
						PrecacheSound(`vo/mvm/mght/heavy_mvm_m_laughshort03.mp3`)
						PrecacheSound(`vo/mvm/mght/taunts/heavy_mvm_m_taunts01.mp3`)

						PrecacheSound(`mvm/giant_heavy/giant_heavy_entrance.wav`)

						PrecacheSound(`vo/mvm/mght/demoman_mvm_m_painsharp04.mp3`)
						PrecacheSound(`vo/mvm/mght/demoman_mvm_m_painsharp07.mp3`)
						PrecacheSound(`vo/mvm/mght/demoman_mvm_m_painsevere02.mp3`)

						PrecacheSound(`vo/mvm/mght/soldier_mvm_m_painsharp05.mp3`)
						PrecacheSound(`vo/mvm/mght/soldier_mvm_m_painsharp01.mp3`)
						PrecacheSound(`vo/mvm/mght/soldier_mvm_m_painsevere01.mp3`)

						PrecacheSound(`vo/mvm/norm/medic_mvm_painsharp02.mp3`)
						PrecacheSound(`vo/mvm/norm/medic_mvm_painsharp08.mp3`)
						PrecacheSound(`vo/mvm/norm/medic_mvm_painsevere03.mp3`)

						PrecacheSound(`vo/mvm/mght/pyro_mvm_m_painsharp07.mp3`)
						PrecacheSound(`vo/mvm/mght/pyro_mvm_m_painsharp05.mp3`)
						PrecacheSound(`vo/mvm/mght/pyro_mvm_m_painsevere06.mp3`)

						PrecacheSound(`vo/mvm/mght/heavy_mvm_m_painsharp01.mp3`)
						PrecacheSound(`vo/mvm/mght/heavy_mvm_m_painsharp04.mp3`)
						PrecacheSound(`vo/mvm/mght/heavy_mvm_m_painsevere02.mp3`)

						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankextensions/teletank`)
						IncludeScript(`tankextensions/ubertank`)

						::DispatchParticleEffectOn <- function(hEntity, sName)
						{
							if(!sName) { hEntity.AcceptInput(`DispatchEffect`, `ParticleEffectStop`, null, null); return }
							local hParticle = Entities.CreateByClassname(`trigger_particle`)
							NetProps.SetPropBool(hParticle, `m_bForcePurgeFixedupStrings`, true)
							hParticle.KeyValueFromString(`particle_name`, sName)
							hParticle.KeyValueFromInt(`attachment_type`, 1)
							hParticle.KeyValueFromInt(`spawnflags`, 64)
							hParticle.DispatchSpawn()
							hParticle.AcceptInput(`StartTouch`, null, hEntity, hEntity)
							hParticle.Kill()
						}

						::DispatchParticleAttached <- function(entity, name, attachment)
						{
							if(entity == null) return
							if(name == null) { entity.AcceptInput(`DispatchEffect`, `ParticleEffectStop`, null, null); return }
							local hParticle = CreateByClassname(`trigger_particle`)
							SetPropBool(hParticle, `m_bForcePurgeFixedupStrings`, true)
							hParticle.KeyValueFromInt(`attachment_type`, 4)
							hParticle.KeyValueFromInt(`spawnflags`, 64)
							hParticle.KeyValueFromString(`particle_name`, name)
							hParticle.KeyValueFromString(`attachment_name`, attachment)
							hParticle.DispatchSpawn()
							hParticle.AcceptInput(`StartTouch`, ``, entity, entity)
							hParticle.Kill()
						}
					  "
			}
		}

		MissionPT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "local hRelay = Entities.CreateByClassname(`logic_relay`), hGameRules = Entities.FindByClassname(null, `tf_gamerules`), iCountdownLast = -1; NetProps.SetPropBool(hRelay, `m_bForcePurgeFixedupStrings`, true); hRelay.ValidateScriptScope(); hRelay.GetScriptScope().Think <- function() { local flRestartRoundTime = NetProps.GetPropFloat(hGameRules, `m_flRestartRoundTime`); if(flRestartRoundTime != -1) { local iCountdown = ceil(flRestartRoundTime - Time()).tointeger(); if(iCountdown != iCountdownLast && iCountdown == 5) EntFire(`Wave7SetupEndRelay`, `Trigger`, null, -1, null); iCountdownLast = iCountdown } else iCountdownLast = -1; return -1 } AddThinkToEnt(hRelay, `Think`)"
			}

            logic_relay
            {
                "targetname" "ChampionGiantTutorial"

                "OnTrigger" "BigNetRunScriptCodeSendGlobalGameEvent(`show_annotation`, { text = `Champion Giants will instantly capture the point! Don't let them reach it!`, lifetime = 5, play_sound = `misc/null.wav`, worldPosX = -2394, worldPosY = -350, worldPosZ = 288})0,-1"
            }

            // Control Point Logic //

            trigger_timer_door
            {
                "targetname" "NovemberMasterControlPoint"
                "filtername" "filter_capbot"
                "origin" "24.62 -448 352"
                "mins" "-160 -160 -176"
                "maxs" "160 160 176"

                "area_cap_point" "control_point"
                "door_name" "capture_door"
                "area_time_to_cap" "5"

                "team_cancap_2" "0"
                "team_cancap_3" "1"

                "spawnflags" "1"
            }

            // Champion Giant Logic //

            trigger_multiple
            {
                "targetname" "ChampionGiantFlagZone"
                "origin" "-160 -448 212"
                "mins" "-120 -120 -176"
                "maxs" "120 120 176"
                "wait" "0.5"
                "spawnflags" "1"

                "OnStartTouch" "ChampionGiantFilter,TestActivator,,0,-1"
            }

            filter_tf_bot_has_tag
            {
                "targetname" "ChampionGiantFilter"
                "tags" "ChampionGiant"

                "OnPass" "control_point,SetOwner,3,0,-1"
            }

			// W3 Logic //

			logic_relay
            {
                "targetname" "VoidTransitionSequence"

                "OnTrigger" "BigNetRunScriptCodeSendGlobalGameEvent(`show_annotation`, { text = `Reality is tearing at the seams...`, lifetime = 3, play_sound = `misc/null.wav`, worldPosX = 0, worldPosY = -256, worldPosZ = 1280})0,-1"
                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `ambient/levels/citadel/strange_talk9.wav`,pitch = 85,special_dsp = 10,filter_type = 5})0-1"

                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `weapons/bottle_broken_hit_world1.wav`,pitch = 100,special_dsp = 10,filter_type = 5})4-1"
                "OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 12, 40, 1, 50000, 0, true)4-1"

                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `weapons/bottle_broken_hit_world2.wav`,pitch = 75,special_dsp = 10,filter_type = 5})5.5-1"
                "OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 12, 40, 1, 50000, 0, true)5.5-1"

                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `weapons/bottle_broken_hit_world3.wav`,pitch = 50,special_dsp = 10,filter_type = 5})7-1"
                "OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 12, 40, 1, 50000, 0, true)7-1"

                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `physics/glass/glass_sheet_break2.wav`,pitch = 60,special_dsp = 10,filter_type = 5})8.5-1"
                "OnTrigger" "PlayerRunScriptCodeScreenFade(null, 143, 99, 181, 255, 3, 0, 1)8.5-1"
                "OnTrigger" "VoidPT,ForceSpawn,,8.5,-1"
            }

			// W6 Logic //

			logic_relay
			{
				"targetname" "FinaleTransitionSequence"

				"OnTrigger" "BigNetRunScriptCodeScreenFade(null, 0, 0, 0, 0, 0, 5, 0)0-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/halloween/clock_tick.wav,0,-1"

				"OnTrigger" "VoidCC,Disable,,0,-1"
				"OnTrigger" "VoidFinaleCC,Enable,,0,-1"

				"OnTrigger" "DemomanTitanPT,ForceSpawn,,0,-1"
                "OnTrigger" "SoldierTitanPT,ForceSpawn,,0,-1"
                "OnTrigger" "MedicTitanPT,ForceSpawn,,0,-1"
                "OnTrigger" "PyroTitanPT,ForceSpawn,,0,-1"
                "OnTrigger" "HeavyTitanPT,ForceSpawn,,0,-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/heavy_mvm_m_domination08.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})2-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/heavy_mvm_m_domination08.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})2-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/halloween/clock_tick.wav,5,-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/soldier_mvm_m_laughshort02.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})6-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/soldier_mvm_m_laughshort02.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})6-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/norm/medic_mvm_negativevocalization07.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})6.5-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/norm/medic_mvm_negativevocalization07.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})6.5-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/pyro_mvm_m_laughhappy01.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})7-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/pyro_mvm_m_laughhappy01.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})7-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/demoman_mvm_m_gibberish07.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})7.5-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/demoman_mvm_m_gibberish07.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})7.5-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/heavy_mvm_m_laughshort03.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})13-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/heavy_mvm_m_laughshort03.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})13-1"

				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/taunts/heavy_mvm_m_taunts01.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})15-1"
				"OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/taunts/heavy_mvm_m_taunts01.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})15-1"

				"OnTrigger" "TankATeleBeam,Start,,17,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_activate.wav,17,-1"

				"OnTrigger" "TankBTeleBeam,Start,,17.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_activate.wav,17.5,-1"

				"OnTrigger" "TankCTeleBeam,Start,,18,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_activate.wav,18,-1"

				"OnTrigger" "TankDTeleBeam,Start,,18.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_activate.wav,18.5,-1"

				"OnTrigger" "TankETeleBeam,Start,,19,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_activate.wav,19,-1"

				"OnTrigger" "tf_gamerules,$FinishWave,,19.5,-1"
			}

			info_particle_system
            {
				"targetname" "TankATeleBeam"
				"origin" "280 1680 -3"
                "effect_name" "teleporter_mvm_bot_persist"
            }
			info_particle_system
            {
				"targetname" "TankBTeleBeam"
				"origin" "1168 96 79"
                "effect_name" "teleporter_mvm_bot_persist"
            }
			info_particle_system
            {
				"targetname" "TankCTeleBeam"
				"origin" "1144 -1328 126"
                "effect_name" "teleporter_mvm_bot_persist"
            }
			info_particle_system
            {
				"targetname" "TankDTeleBeam"
				"origin" "128 -2336 128"
                "effect_name" "teleporter_mvm_bot_persist"
            }
			info_particle_system
            {
				"targetname" "TankETeleBeam"
				"origin" "-1920 -448 -69"
                "effect_name" "teleporter_mvm_bot_persist"
            }

            // Wave7 Logic //

			logic_relay
			{
				"targetname" "Wave7SetupRelay"

				"OnTrigger" "Wave7SetupMusic,PlaySound,,0,-1"
				"OnTrigger" "BigNetRunScriptCodeClientPrint(null,3, `/x07800080Now Playing: /x07FFFFFFSuffering Leaves, Suffering Leaves - Heaven Pierce Her`)0-1"
				"OnTrigger" "tf_gamerules,$StopVO,#november_master_finale_intro.mp3,0,-1"

				"OnTrigger" "VoidFinaleCC,Enable,,0,-1"

				"OnTrigger" "DemomanTitanPT,ForceSpawn,,0,-1"
                "OnTrigger" "SoldierTitanPT,ForceSpawn,,0,-1"
                "OnTrigger" "MedicTitanPT,ForceSpawn,,0,-1"
                "OnTrigger" "PyroTitanPT,ForceSpawn,,0,-1"
                "OnTrigger" "HeavyTitanPT,ForceSpawn,,0,-1"

				"OnTrigger" "TankATeleBeam,Start,,0,-1"
				"OnTrigger" "TankBTeleBeam,Start,,0,-1"
				"OnTrigger" "TankCTeleBeam,Start,,0,-1"
				"OnTrigger" "TankDTeleBeam,Start,,0,-1"
				"OnTrigger" "TankETeleBeam,Start,,0,-1"

				"OnTrigger" "tank_path_a_67,AddOutput,OnPass TankACheck:SetValue:1:0:-1,0,-1"
				"OnTrigger" "tank_path_a_67,AddOutput,OnPass !activator:SetSpeed:0:0:-1,0,-1"

				"OnTrigger" "tank_path_b_67,AddOutput,OnPass TankBCheck:SetValue:1:0:-1,0,-1"
				"OnTrigger" "tank_path_b_67,AddOutput,OnPass !activator:SetSpeed:0:0:-1,0,-1"

				"OnTrigger" "tank_path_c_68,AddOutput,OnPass TankCCheck:SetValue:1:0:-1,0,-1"
				"OnTrigger" "tank_path_c_68,AddOutput,OnPass !activator:SetSpeed:0:0:-1,0,-1"

				"OnTrigger" "tank_path_d_66,AddOutput,OnPass TankDCheck:SetValue:1:0:-1,0,-1"
				"OnTrigger" "tank_path_d_66,AddOutput,OnPass !activator:SetSpeed:0:0:-1,0,-1"

				"OnTrigger" "tank_path_e_72,AddOutput,OnPass TankECheck:SetValue:1:0:-1,0,-1"
				"OnTrigger" "tank_path_e_72,AddOutput,OnPass !activator:SetSpeed:0:0:-1,0,-1"
			}

			ambient_generic
            {
                "targetname" "Wave7SetupMusic"
                "message" "#november_master_finale_setup.mp3"
				"health" "10"

                "spawnflags" "17"
            }

			logic_relay
			{
				"targetname" "Wave7SetupEndRelay"
				"StartDisabled" "1"
				"OnTrigger" "Wave7SetupMusic,FadeOut,4,0,-1"
			}

			logic_relay
			{
				"targetname" "Wave7StartRelay"

				"OnTrigger" "Wave7MusicIntro,PlaySound,,2,-1"

				"OnTrigger" "TankATeleBeam,Stop,,14.684,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,14.684,-1"

				"OnTrigger" "TankBTeleBeam,Stop,,15.184,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,15.184,-1"

				"OnTrigger" "TankCTeleBeam,Stop,,15.684,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,15.684,-1"

				"OnTrigger" "TankDTeleBeam,Stop,,16.184,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,16.184,-1"

				"OnTrigger" "TankETeleBeam,Stop,,16.684,-1"
				"OnTrigger" "tf_gamerules,PlayVO,mvm/mvm_tele_deliver.wav,16.684,-1"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,22,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,22,-1"

				"OnTrigger" "tank_a,SetSpeed,110,23.554,-1"
				"OnTrigger" "tank_b,SetSpeed,110,23.554,-1"
				"OnTrigger" "tank_c,SetSpeed,110,23.554,-1"
				"OnTrigger" "tank_d,SetSpeed,110,23.554,-1"
				"OnTrigger" "tank_e,SetSpeed,110,23.554,-1"

				"OnTrigger" "Wave7MusicLoop1,PlaySound,,24.054,-1"
				"OnTrigger" "BigNetRunScriptCodeClientPrint(null,3, `/x07800080Now Playing: /x07FFFFFFDanse Macabre - Heaven Pierce Her`)24.054-1"

				"OnTrigger" "Wave7MusicFadeout1,Disable,,109.926,-1"
				"OnTrigger" "Wave7MusicFadeout2,Enable,,109.926,-1"

				"OnTrigger" "Wave7MusicLoop2,PlaySound,,109.926,-1"
				"OnTrigger" "Wave7MusicFadeout2,Disable,,195.798,-1"
				"OnTrigger" "Wave7MusicFadeout3,Enable,,195.798,-1"

				"OnTrigger" "Wave7MusicLoop3,PlaySound,,195.798,-1"
			}

			logic_branch_listener
			{
				"targetname" "TankArrivalChecker"

				"Branch01" "TankACheck"
				"Branch02" "TankBCheck"
				"Branch03" "TankCCheck"
				"Branch04" "TankDCheck"
				"Branch05" "TankECheck"

				"OnAllTrue" "TankDeploySequence,Trigger,,0,-1"
			}

			logic_branch
			{
				"targetname" "TankACheck"

				"InitialValue" "0"
			}
			logic_branch
			{
				"targetname" "TankBCheck"

				"InitialValue" "0"
			}
			logic_branch
			{
				"targetname" "TankCCheck"

				"InitialValue" "0"
			}
			logic_branch
			{
				"targetname" "TankDCheck"

				"InitialValue" "0"
			}
			logic_branch
			{
				"targetname" "TankECheck"

				"InitialValue" "0"
			}

			logic_relay
			{
				"targetname" "TankDeploySequence"

				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,4,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_lift_warning.wav,4,-1"

				"OnTrigger" "tank_a,SetSpeed,115,6,-1"
				"OnTrigger" "tank_b,SetSpeed,65,6,-1"
				"OnTrigger" "tank_c,SetSpeed,70,6,-1"
				"OnTrigger" "tank_d,SetSpeed,80,6,-1"
				"OnTrigger" "tank_e,SetSpeed,155,6,-1"
			}

			ambient_generic
            {
                "targetname" "Wave7MusicIntro"
                "message" "#november_master_finale_intro.mp3"
				"health" "10"

                "spawnflags" "17"
            }
			ambient_generic
            {
                "targetname" "Wave7MusicLoop1"
                "message" "#november_master_finale_loop.mp3"
				"health" "10"

                "spawnflags" "17"
            }
			logic_relay
			{
				"targetname" "Wave7MusicFadeout1"

				"OnTrigger" "Wave7MusicLoop1,FadeOut,4,0,-1"
			}

			ambient_generic
            {
                "targetname" "Wave7MusicLoop2"
                "message" "#november_master_finale_loop.mp3"
				"health" "10"

                "spawnflags" "17"
            }
			logic_relay
			{
				"targetname" "Wave7MusicFadeout2"
				"StartDisabled" "1"

				"OnTrigger" "Wave7MusicLoop2,FadeOut,4,0,-1"
