        HeavyTitanPT
        {
            OnSpawnOutput
            {
                Target "HeavyTitanSetupRelay"
                Action Trigger
            }

            logic_relay
            {
                "targetname" "HeavyTitanSetupRelay"

                "OnTrigger" "HeavyTitan,SetAnimation,taunt_flag_heavy,0,-1"
                "OnTrigger" "HeavyTitan,SetPlaybackRate,0.0001,4,-1"
            }
            prop_dynamic
            {
                "targetname" "HeavyTitan"
                "origin" "-4598 -192 167"

                "model" "models/player/heavy.mdl"
                "modelscale" "20"

                "rendermode" "10"

                "disablebonefollowers" "1"
				"disableshadows" "1"
            }
            prop_dynamic_ornament
            {
                "targetname" "HeavyTitanBot"
				"initialowner" "HeavyTitan"

                "model" "models/bots/heavy_boss/bot_heavy_boss.mdl"
                "skin" "1"

                "disablebonefollowers" "1"
				"disableshadows" "1"
            }

            $trigger_detector
			{
				"targetname" "HeavyTitanDetector"
				"filtername" "filter_red"
				"origin" "-1792 -448 480"
				"mins" "-448 -960 -672"
				"maxs" "448 960 672"

				"$fov" "360"

				"spawnflags" "1"

				"$TargetTestPass" "HeavyTitanAttackPT,ForceSpawnAtEntityOrigin,!activator,0,-1"
			}

            logic_relay
            {
                "targetname" "HeavyTitanStunRelay"

                "OnTrigger" "HeavyTitanDetector,Disable,,0,-1"

                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/heavy_mvm_m_painsharp01.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})0-1"
                "OnTrigger" "tf_gamerules,PlayVO,ambient/explosions/explode_4.wav,0,-1"
