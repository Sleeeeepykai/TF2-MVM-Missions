        //// ROBOT PTs ////

        ChampionGiantPT
        {
            OnSpawnOutput
            {
                Target !activator
                Action RunScriptCode
                Param "SendGlobalGameEvent(`show_annotation`, {
                    text = `Champion Giant Active!`
                    lifetime = 5
                    play_sound = `mvm/mvm_warning.wav`
                    follow_entindex = self
                })"
            }
        }
	}

