                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/heavy_mvm_m_painsharp04.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})2-1"
                "OnTrigger" "tf_gamerules,PlayVO,ambient/explosions/explode_4.wav,2,-1"
                "OnTrigger" "HeavyTitanStunParticle3,Start,,2,-1"

                "OnTrigger" "tf_gamerules,PlayVO,ambient/explosions/explode_3.wav,3,-1"
                "OnTrigger" "HeavyTitanStunParticle4,Start,,3,-1"

                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/heavy_mvm_m_painsevere02.mp3`,channel = 6,pitch = 85,special_dsp = 22,filter_type = 5})4-1"
                "OnTrigger" "tf_gamerules,PlayVO,ambient/explosions/explode_1.wav,4,-1"
