        VoidPT
        {
            OnSpawnOutput
            {
                Target BigNet
                Action RunScriptCode
                Param "
                        EntFire(`VoidSkybox`, `ActivateSkybox`)
                        EntFire(`VoidCC`, `Enable`)

                        if(`NovemberMasterScript` in getroottable())
                        {
                            NovemberMasterScript.SetAmbienceVoid()
                        }
                      "
                Delay 0.1
            }

            sky_camera
            {
                "targetname" "VoidSkybox"
                "origin" "4895 -354 604"
                "angles" "0 0 0"
                "scale" "16"

                "fogenable" "1"
                "fogstart" "100"
                "fogend" "4000"
                "fogmaxdensity" "1"
                "fogcolor" "0 0 0"
                "fogblend" "0"
                "fogdir" "1 0 0"
                "fogRadial" "1"
            }

            color_correction
            {
                "targetname" "VoidCC"

				"filename" "materials/colorcorrection/november_master_void.raw"
                "maxweight" "1"

                "minfalloff" "-1"
                "maxfalloff" "-1"
                "fadeInDuration" "0"
                "fadeOutDuration" "0"
            }
            color_correction
            {
                "targetname" "VoidFinaleCC"

				"filename" "materials/colorcorrection/november_master_void_finale.raw"
                "maxweight" "1"

                "minfalloff" "-1"
                "maxfalloff" "-1"
                "fadeInDuration" "0"
                "fadeOutDuration" "0"
                "startdisabled" "1"
            }
        }

