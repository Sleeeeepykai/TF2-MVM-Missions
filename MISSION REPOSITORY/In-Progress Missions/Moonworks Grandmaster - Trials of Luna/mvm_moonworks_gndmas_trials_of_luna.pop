#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 400
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 2500
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

    NoCritPumpkin 1

    BodyPartScaleSpeed 10

    MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

    //// PRECACHES ////

    // Precached Models

	PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun.mdl"
	PrecacheModel "models/weapons/c_models/c_cryo_gun/c_cryo_gun_fireball.mdl"

    PrecacheModel "models/bots/demo_boss/bot_demo_boss_nolod.mdl"
	PrecacheModel "models/bots/heavy_boss/bot_heavy_boss_nolod.mdl"

	// Precached Particles

	PrecacheParticle "spell_fireball_small_trail_red"

    // Precached Sounds

    PrecacheSound "planned_obsolescence_death.mp3"

    PrecacheSound "2int_final.mp3"

    //// CUSTOM WEAPONS ////

    CustomWeapon
    {
        //// WEAPONS ////

        "RocketAttack"
		{
			OriginalItemName "TF_WEAPON_ROCKETLAUNCHER"
			"damage bonus" 1.5
			"projectile speed decreased" 0.65
			"mod projectile heat seek power" 360
			"mod projectile heat aim error" 360
			"mod projectile heat aim time" 0.75
			"mod projectile heat no predict target speed" 1
			"projectile trail particle" "eyeboss_projectile"
		}
        "FlareBarrageAttack"
        {
            OriginalItemName "The Flare Gun"
            "damage bonus" 2
            "projectile speed decreased" 0.1
            "projectile spread angle penalty" 5

            "mod projectile heat seek power" 360
			"mod projectile heat aim error" 360
			"mod projectile heat aim time" 0.5
			"mod projectile heat no predict target speed" 1
        }

        //// COSMETICS ////

        "BackpackRocket1"
        {
            OriginalItemName "Highland High Heels"
            "custom item model" "models/weapons/c_models/c_rocketlauncher/c_rocketlauncher.mdl"
            "attachment name" "flag"
            "attachment angles" "0 270 0"
            "attachment offset" "25 0 0"
        }
        "BackpackRocket2"
        {
            OriginalItemName "Potato of Labor"
            "custom item model" "models/weapons/c_models/c_rocketlauncher/c_rocketlauncher.mdl"
            "attachment name" "flag"
            "attachment angles" "0 270 0"
            "attachment offset" "-25 0 0"
        }

        "GoldenJuggernautHelm"
		{
			OriginalItemName "The Bunsen Brave"

			"set item tint RGB" "15185211"
		}
		"GoldenJuggernautBeard"
		{
			OriginalItemName "The All-Father"

			"set item tint RGB" "15185211"
		}
    }

    //// POINT TEMPLATES ////

    PointTemplates
    {
        CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Grandmaster) Trials of Luna`)

                        Convars.SetValue(`tf_playergib`, 0)

                        PrecacheSound(`vo/mvm/mght/demoman_mvm_m_laughlong01.mp3`)
                        PrecacheSound(`vo/mvm/mght/heavy_mvm_m_laughlong01.mp3`)
                        PrecacheSound(`mvm/mvm_warning.wav`)
                        PrecacheSound(`mvm/mvm_tele_activate.wav`)

                        IncludeScript(`tankhealthbars`)
						IncludeScript(`tankextensions_main`)
                        IncludeScript(`tankextensions/combattank`)
                        IncludeScript(`tankextensions/combattank_weapons/rocketpod`)
                        IncludeScript(`tankextensions/combattank_weapons/minigun`)
                        IncludeScript(`tankextensions/combattank_weapons/railgun`)
                        IncludeScript(`tankextensions/sentrytank`)

                        TANKHEALTHBARS_TEXT_HEIGHT_OFFSET = 72

                        ::RemoveTeleTag <- function (Target)
                        {
                            if(Target.HasBotTag(`telebot`))
                            {
                                Target.RemoveBotTag(`telebot`)
                            }
                        }
					  "
			}

            point_populator_interface
            {
                "targetname" "pop_interface"
            }
		}
        MissionPT
        {
            logic_relay
            {
                "targetname" "TitanSpawnRelay"

                "OnTrigger" "tf_gamerules,PlayVO,ambient/halloween/thunder_08.wav,0,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 25, 0.6, 0.1, 1)0-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 5, 5, 2, 50000, 0, true)0-1"

                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/demoman_mvm_m_laughlong01.mp3`,channel = 6,pitch = 80,special_dsp = 22})2-1"
                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `vo/mvm/mght/heavy_mvm_m_laughlong01.mp3`,channel = 6,pitch = 80,special_dsp = 22})2-1"
            }
            logic_relay
            {
                "targetname" "TitanEndRelay"

                "OnTrigger" "pop_interface,ChangeBotAttributes,Dormant,0,-1"

                "OnTrigger" "tf_gamerules,PlayVO,ambient/halloween/thunder_08.wav,5,-1"
				"OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 25, 0.6, 0.1, 1)5-1"
				"OnTrigger" "PlayerRunScriptCodeScreenShake(self.GetOrigin(), 5, 5, 2, 50000, 0, true)5-1"
            }
        }

        //// MINIBOSS PTs ////

        BlastMasterPT
        {
            KeepAlive 1

            RemoveIfKilled "BlastMaster"

            OnParentKilledOutput
            {
                Target BlastMasterDeathRelay
                Action Trigger
            }

            logic_relay
            {
                "targetname" "BlastMasterDeathRelay"

                "OnTrigger" "BlastMaster,Enable,,0,-1"
                "OnTrigger" "BlastMaster,SetAnimation,primary_death_backstab,0,-1"
                "OnTrigger" "BlastMaster,SetPlaybackRate,0.5,0.015,-1"

                "OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/scout_mvm_m_paincrticialdeath03.mp3,0,-1"
                
                "OnTrigger" "tf_gamerules,$StopVO,vo/mvm/mght/scout_mvm_m_paincrticialdeath03.mp3,2.46,-1"
                "OnTrigger" "BlastMaster,Disable,,2.46,-1"
                "OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 110, 0.7, 0.1, 1)2.46-1"
                "OnTrigger" "BlastMasterDeathParticle,Start,,2.46,-1"
				"OnTrigger" "tf_gamerules,PlayVO,planned_obsolescence_death.mp3,2.46,-1"

                "OnTrigger" "BlastMaster,Kill,,3.46,-1"
            }

            prop_dynamic
            {
                "targetname" "BlastMaster"

                "model" "models/bots/scout_boss/bot_scout_boss.mdl"
                "skin" "1"
                "modelscale" "2"

                "disablebonefollowers" "1"
				"disableshadows" "1"
                "startdisabled" "1"
            }
            info_particle_system
			{
				"targetname" "BlastMasterDeathParticle"
				"origin" "0 0 70"
				"effect_name" "mvm_tank_destroy"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "BlastMasterDeathParticle"
				"origin" "0 0 120"
				"effect_name" "hammer_bell_ring_shockwave"
				"start_active" "0"
			}
        }

        ForgebornPT
        {
            KeepAlive 1

            RemoveIfKilled "Forgeborn"

            OnParentKilledOutput
            {
                Target ForgebornDeathRelay
                Action Trigger
            }

            logic_relay
            {
                "targetname" "ForgebornDeathRelay"

                "OnTrigger" "Forgeborn,Enable,,0,-1"
                "OnTrigger" "Forgeborn,SetAnimation,primary_death_headshot,0,-1"
                "OnTrigger" "Forgeborn,SetPlaybackRate,0.5,0.015,-1"

                "OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/pyro_mvm_m_paincrticialdeath03.mp3,0,-1"
                
                "OnTrigger" "tf_gamerules,$StopVO,vo/mvm/mght/pyro_mvm_m_paincrticialdeath03.mp3,3.4,-1"
                "OnTrigger" "Forgeborn,Disable,,3.4,-1"
                "OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 110, 0.7, 0.1, 1)3.4-1"
                "OnTrigger" "ForgebornDeathParticle,Start,,3.4,-1"
				"OnTrigger" "tf_gamerules,PlayVO,planned_obsolescence_death.mp3,3.4,-1"

                "OnTrigger" "Forgeborn,Kill,,4.4,-1"
            }


            prop_dynamic
            {
                "targetname" "Forgeborn"

                "model" "models/bots/pyro_boss/bot_pyro_boss.mdl"
                "skin" "1"
                "modelscale" "2"

                "disablebonefollowers" "1"
				"disableshadows" "1"
                "startdisabled" "1"
            }
            info_particle_system
			{
				"targetname" "ForgebornDeathParticle"
				"origin" "0 0 70"
				"effect_name" "mvm_tank_destroy"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "ForgebornDeathParticle"
				"origin" "0 0 120"
				"effect_name" "hammer_bell_ring_shockwave"
				"start_active" "0"
			}
        }

        HyperionPT
        {
            KeepAlive 1

            RemoveIfKilled "Hyperion"

            // Rocket Attack //

            OnSpawnOutput
			{
				Target "RocketAttackLeft"
				Action "$SetOwner"
				Param "!activator"
				Delay 0.02
			}
			OnSpawnOutput
			{
				Target "RocketAttackRight"
				Action "$SetOwner"
				Param "!activator"
				Delay 0.02
			}

            logic_relay
			{
				"targetname" "RocketBarrageRelay"

				"OnTrigger" "RocketAttack*,FireOnce,,0,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,0.2,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,0.4,-1"

				"OnTrigger" "RocketAttack*,FireOnce,,1.4,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,1.6,-1"
				"OnTrigger" "RocketAttack*,FireOnce,,1.8,-1"
			}

			tf_point_weapon_mimic
			{
				"targetname" "RocketAttackLeft"
				"origin" "25 25 150"
				"angles" "315 0 0"

				"$weaponname" "RocketAttack"
				"teamnum" "3"
				"crits" "false"
				"$preventshootparent" "1"

				"spawnflags" "1"
			}
			tf_point_weapon_mimic
			{
				"targetname" "RocketAttackRight"
				"origin" "25 -25 150"
				"angles" "315 0 0"

				"$weaponname" "RocketAttack"
				"teamnum" "3"
				"crits" "false"
				"$preventshootparent" "1"

				"spawnflags" "1"
			}

            // Phase Transition //

            logic_relay
            {
                "targetname" "HyperionAngryRelay"

                "OnTrigger" "!activator,$Addcond,51 2.5,0,-1"
                "OnTrigger" "!activator,$Addcond,87 2.5,0,-1"

                "OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/heavy_mvm_m_battlecry03.mp3,0,-1"
                "OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/heavy_mvm_m_battlecry03.mp3,0,-1"
                "OnTrigger" "!activator,$PlaySequence,taunt_unleashed_rage_heavy,0.1,-1"
                "OnTrigger" "tf_gamerules,PlayVO,ambient/alarms/razortrain_horn1.wav,1,-1"
                "OnTrigger" "!activator,$PlaySequence,run_primary,2.5,-1"
            }

            // Flare Barrage Attack //

            OnSpawnOutput
			{
				Target "FlareBarrageAttackLeft"
				Action "$SetOwner"
				Param "!activator"
				Delay 0.02
			}
			OnSpawnOutput
			{
				Target "FlareBarrageAttackRight"
				Action "$SetOwner"
				Param "!activator"
				Delay 0.02
			}

            tf_point_weapon_mimic
			{
				"targetname" "FlareBarrageAttackLeft"
				"origin" "25 50 150"
				"angles" "315 0 0"

				"$weaponname" "FlareBarrageAttack"
                "$firetime" "0.2"
				"teamnum" "3"
				"crits" "false"
				"$preventshootparent" "1"

				"spawnflags" "1"
			}
			tf_point_weapon_mimic
			{
				"targetname" "FlareBarrageAttackRight"
				"origin" "25 -50 150"
				"angles" "315 0 0"

				"$weaponname" "FlareBarrageAttack"
                "$firetime" "0.2"
				"teamnum" "3"
				"crits" "false"
				"$preventshootparent" "1"

				"spawnflags" "1"
			}

            // Death Animation //

            OnParentKilledOutput
            {
                Target HyperionDeathRelay
                Action Trigger
            }

            logic_relay
            {
                "targetname" "HyperionDeathRelay"

                "OnTrigger" "FlareBarrageAttack*,$StopFiring,,0,-1"
                "OnTrigger" "Hyperion,Enable,,0,-1"
                "OnTrigger" "Hyperion,SetAnimation,primary_death_headshot,0,-1"

                "OnTrigger" "tf_gamerules,PlayVO,vo/mvm/mght/heavy_mvm_m_paincrticialdeath01.mp3,0,-1"
                
                "OnTrigger" "tf_gamerules,$StopVO,vo/mvm/mght/heavy_mvm_m_paincrticialdeath01.mp3,3.5,-1"
                "OnTrigger" "Hyperion,Disable,,3.5,-1"
                "OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 110, 0.7, 0.1, 1)3.5-1"
                "OnTrigger" "HyperionDeathParticle,Start,,3.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,planned_obsolescence_death.mp3,3.5,-1"

                "OnTrigger" "Hyperion,Kill,,4,-1"
            }

            prop_dynamic
            {
                "targetname" "Hyperion"

                "model" "models/bots/heavy_boss/bot_heavy_boss.mdl"
                "skin" "1"
                "modelscale" "2"

                "disablebonefollowers" "1"
				"disableshadows" "1"
                "startdisabled" "1"
            }
            info_particle_system
			{
				"targetname" "HyperionDeathParticle"
				"origin" "0 0 70"
				"effect_name" "mvm_tank_destroy"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "HyperionDeathParticle"
				"origin" "0 0 120"
				"effect_name" "hammer_bell_ring_shockwave"
				"start_active" "0"
			}
        }

        MastermindPT
        {
            KeepAlive 1

            RemoveIfKilled "Mastermind"

            OnParentKilledOutput
            {
                Target MastermindDeathRelay
                Action Trigger
            }

            logic_relay
            {
                "targetname" "MastermindDeathRelay"

                "OnTrigger" "Mastermind,Enable,,0,-1"
                "OnTrigger" "Mastermind,SetAnimation,primary_death_headshot,0,-1"
                "OnTrigger" "Mastermind,SetPlaybackRate,0.33,0.015,-1"

                "OnTrigger" "pop_interface,ChangeBotAttributes,Disappear,0.5,-1"

                "OnTrigger" "Mastermind,Disable,,2,-1"
                "OnTrigger" "PlayerRunScriptCodeScreenFade(null, 255, 255, 255, 110, 0.7, 0.1, 1)2-1"
                "OnTrigger" "MastermindDeathParticle,Start,,2,-1"
				"OnTrigger" "tf_gamerules,PlayVO,planned_obsolescence_death.mp3,2,-1"

                "OnTrigger" "Mastermind,Kill,,3,-1"
            }


            prop_dynamic
            {
                "targetname" "Mastermind"

                "model" "models/bots/spy/bot_spy.mdl"
                "skin" "1"
                "modelscale" "2"

                "disablebonefollowers" "1"
				"disableshadows" "1"
                "startdisabled" "1"
            }
            info_particle_system
			{
				"targetname" "MastermindDeathParticle"
				"origin" "0 0 70"
				"effect_name" "mvm_tank_destroy"
				"start_active" "0"
			}
			info_particle_system
			{
				"targetname" "MastermindDeathParticle"
				"origin" "0 0 120"
				"effect_name" "hammer_bell_ring_shockwave"
				"start_active" "0"
			}
        }

        StickyNukePT
		{
			RemoveIfKilled "StickyNukeHitbox"

			OnSpawnOutput
			{
				Target "StickyNukeRelay"
				Action "Trigger"
			}
			OnSpawnOutput
			{
				Target "StickyNukeIndicator"
				Action "ClearParent"
			}
			OnSpawnOutput
			{
				Target "StickyNukeIndicator"
				Action "$SetFakeParent"
				Param "StickyNukeTarget"
			}
			OnSpawnOutput
			{
				Target "StickyNukeIndicator"
				Action "$SetLocalAngles"
				Param "0 0 0"
			}
			OnSpawnOutput
			{
				Target "StickyNukeHitbox"
				Action "SetHealth"
				Param 2500
			}

			logic_relay
			{
				"targetname" "StickyNukeRelay"

				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode_trigger.wav,0.5,-1"
				"OnTrigger" "StickyNukeCharge,Start,,1,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode_trigger.wav,1.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode_trigger.wav,2.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/cart_explode_trigger.wav,3.5,-1"
				"OnTrigger" "tf_gamerules,PlayVO,items/bomb_warning.wav,5.3,-1"
				"OnTrigger" "tf_gamerules,$StopVO,items/bomb_warning.wav,6,-1"
				"OnTrigger" "tf_gamerules,PlayVO,misc/doomsday_missile_explosion.wav,6,-1"
			}

			info_target
			{
				"targetname" "StickyNukeTarget"
			}

			obj_sentrygun
			{
				"targetname" "StickyNukeHitbox"
				"TeamNum" "3"
				"defaultupgrade" "2"
				"health" "3500"
				"SolidToPlayer" "0"
				"rendermode" "10"
				"$sentrymodelprefix" "models/empty.mdl"
				"$rangemult" "0.001"

				"damagefilter" "filter_redteam"

				"OnDamaged" "Player,$DisplayTextCenter,$$=test(!caller.m_iHealth>1,'Nuke HP: '..string(max(!caller.m_iHealth, 0)),''),0,-1"
                "OnDamaged" "!parentRunScriptCodetry{if(caller.GetHealth()<1){self.Kill()}}catch(e){}0-1"
			}
			prop_dynamic
			{
				"targetname" "StickyNukeIndicator"
				"model" "models/props_gameplay/cap_circle_768.mdl"
				"skin" "2"
				"modelscale" "2"

				"$modules" "fakeparent"
				"$positiononly" "1"

				"disablebonefollowers" "1"
				"disableshadows" "1"
			}
			info_particle_system
			{
				"targetname" "StickyNukeCharge"
				"effect_name" "charge_up"
			}
		}

        //// TANK PTs ////

        RocketSentryTankPT
        {
            OnSpawnOutput
            {
                Target SentryTankSetupRelay
                Action Trigger
            }
            logic_relay
            {
                "targetname" "SentryTankSetupRelay"

                "OnTrigger" "@c@!activator,AddOutput,$bulletweapon TF_WEAPON_ROCKETLAUNCHER,0,-1"
                "OnTrigger" "@c@!activator,AddOutput,$fireratemult 3,0,-1"
            }
        }
        HuntsmanSentryTankPT
        {
            OnSpawnOutput
            {
                Target SentryTankSetupRelay
                Action Trigger
            }
            logic_relay
            {
                "targetname" "SentryTankSetupRelay"

                "OnTrigger" "@c@!activator,AddOutput,$bulletweapon The Huntsman,0,-1"
                "OnTrigger" "@c@!activator,AddOutput,$fireratemult 3,0,-1"
            }
        }

        CombatTankTeleporterPT
        {
            KeepAlive 1

            RemoveIfKilled "CombatTankTarget"

            OnParentKilledOutput
            {
                Target CombatTankDeathRelay
                Action Trigger
            }
            OnParentKilledOutput
            {
                Target CombatTankBackTeleporter
                Action Disable
            }
            OnParentKilledOutput
            {
                Target CombatTankTarget
                Action Kill
                Delay 1
            }

            info_target
            {
                "targetname" "CombatTankTarget"

                "OnUser4" "CombatTankDeathRelay,Disable,,0,-1"
            }

            prop_dynamic
            {
                "targetname" "CombatTankBackTeleporter"
                "origin" "-88 0 80"
                "angles" "-45 0 0"

                "model" "models/buildables/teleporter_light.mdl"
                "modelscale" "1.5"
                "skin" "1"

                "disablebonefollowers" "1"
                "disableshadows" "1"
            }
            tf_glow
            {
                "parentname" "CombatTankBackTeleporter"
                "target" "CombatTankBackTeleporter"
                "GlowColor" "255 255 255 255"
            }

            logic_relay
            {
                "targetname" "CombatTankDeathRelay"

                "OnTrigger" "CombatTankTeleporterRemnantPT,ForceSpawnAtEntityOrigin,CombatTankTarget,0,-1"
            }
        }
        CombatTankTeleporterRemnantPT
        {
            KeepAlive 1

            OnSpawnOutput
            {
                Target TeleporterActivateRelay
                Action Trigger
            }

            logic_relay
            {
                "targetname" "TeleporterActivateRelay"

                "OnTrigger" "pop_interface,$KillWaveSpawn,Wave10_Subwave1_GRapidBurstSoldier,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,Wave10_Subwave1_GRapidBurstSoldier,0,-1"
                "OnTrigger" "pop_interface,$KillWaveSpawn,Wave10_Subwave1_DeflectorHeavies,0,-1"
                "OnTrigger" "pop_interface,$PauseWaveSpawn,Wave10_Subwave1_DeflectorHeavies,0,-1"

                "OnTrigger" "BigNetRunScriptCodeSendGlobalGameEvent(`teamplay_broadcast_audio`, {sound = `2int_final.mp3`, team = 255})2,-1"

                "OnTrigger" "TeleporterPropRunScriptCodeSendGlobalGameEvent(`show_annotation`, {text = `The teleporter remains intact!`, lifetime = 3.0, follow_entindex = self.entindex(), play_sound = `mvm/mvm_warning.wav`})2,-1"

                "OnTrigger" "TeleporterProp,SetAnimation,running,5,-1"
                "OnTrigger" "TeleporterParticle,Start,,5,-1"
                "OnTrigger" "TeleporterDamage,Enable,,5,-1"

                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `mvm/mvm_tele_activate.wav`, channel = 6, pitch = 80, special_dsp = 26})5-1"
                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `mvm/mvm_tele_activate.wav`, channel = 6, pitch = 85, special_dsp = 26})5.1-1"
                "OnTrigger" "BigNetRunScriptCodeEmitSoundEx({sound_name = `mvm/mvm_tele_activate.wav`, channel = 6, pitch = 90, special_dsp = 26})5.2-1"

                "OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave10_Subwave1_GRapidBurstSoldier,5,-1"
                "OnTrigger" "pop_interface,$ResumeWaveSpawn,Wave10_Subwave1_DeflectorHeavies,5,-1"
            }

            trigger_multiple
            {
                "targetname" "TeleporterTrigger"
                "filtername" "filter_telebot"
                "origin" "0 0 32"
                "mins" "-32 -32 -32"
                "maxs" "32 32 32"

                "spawnflags" "1"

                "OnStartTouch" "!selfRunScriptCodeEmitSoundEx({sound_name = `mvm/mvm_tele_deliver.wav`, channel = 6, sound_level = 95, volume = 1, origin = self.GetOrigin(), flags = 1})0-1"

                "OnStartTouch" "!activator,$AddCond,51 1,0,-1"
                "OnStartTouch" "!activatorRunScriptCodeRemoveTeleTag(self),0,-1"
            }
            

            // TELEPORTER //

            info_target
            {
                "targetname" "TeleporterTarget"
                "origin" "0 0 128"
            }

