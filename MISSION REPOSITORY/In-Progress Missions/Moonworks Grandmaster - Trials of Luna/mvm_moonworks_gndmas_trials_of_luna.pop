    //// WAVES ////

    Wave
    {
        InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`bombpath_force_right`, `Trigger`)
                  "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`bombpath_arrows_clear_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`bombpath_wavefinished`, `Trigger`)
                  "
        }

        // Subwave 1
        WaveSpawn // 4 GRapid Burst Soldiers (Arlecchino)
        {
            Name "Wave1_Subwave1_GRapidBurstSoldier"
            Where spawnbot
            TotalCount 4
            MaxActive 2
            SpawnCount 1
            WaitBeforeStarting 0
            WaitBetweenSpawns 15
            TotalCurrency 100

            TFBot
            {
                Template T_TFBot_Giant_Soldier_Burst_Spammer
            }
        }
        WaveSpawn // 16 Pyros and 16 Kritz Medics (Mike & Package)
        {
            Name "Wave1_Subwave1_Pyros"
            Where spawnbot
            TotalCount 32
            MaxActive 18
            SpawnCount 6
            WaitBeforeStarting 2
            WaitBetweenSpawns 8
            TotalCurrency 60

            Squad
            {
                TFBot
                {
                    Class Pyro
                    Skill Normal

                    ItemAttributes
                    {
                        ItemName "TF_WEAPON_FLAMETHROWER"

                        "airblast disabled" 1
                    }
                }
                TFBot
                {
                    Template T_TFBot_Medic_Kritzkrieg
                }
            }
        }

        // Subwave 2
