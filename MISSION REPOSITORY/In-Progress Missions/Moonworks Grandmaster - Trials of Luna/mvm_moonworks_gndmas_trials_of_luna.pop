            WaitBetweenSpawns 0
            TotalCurrency 100

            Tank
            {
                Name "tankboss"
                Health 32000
                Speed 75
                StartingPathTrackNode "boss_path_same"

                OnBombDroppedOutput
                {
                    Target boss_deploy_relay
                    Action Trigger
