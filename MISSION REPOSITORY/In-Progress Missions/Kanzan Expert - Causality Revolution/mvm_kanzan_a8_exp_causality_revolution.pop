		{
			Name "Wave2_Subwave1_Tank"
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 60

			Tank
			{
				Template Tank_Default
				Health 25000
				StartingPathTrackNode "tank_path_B"
			}
		}
		WaveSpawn // 4 Rapid Fire Soldiers and 8 Pyros
