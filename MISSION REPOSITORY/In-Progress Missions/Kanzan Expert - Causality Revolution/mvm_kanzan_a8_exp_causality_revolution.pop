#base robot_standard_vanilla_kai.pop
#base robot_standard_custom_kai.pop
#base robot_standard_custom_rafmod_kai.pop
#base robot_standard_supercharged_kai.pop
#base robot_standard_supercharged_rafmod_kai.pop
#base robot_giant_vanilla_kai.pop
#base robot_giant_custom_kai.pop
#base robot_giant_custom_rafmod_kai.pop
#base robot_giant_supercharged_kai.pop
#base robot_giant_supercharged_rafmod_kai.pop
#base robot_tank_custom_rafmod_kai.pop

WaveSchedule
{
	StartingCurrency 1500
	RespawnWaveTime 1
	CanBotsAttackWhileInSpawnRoom No

	AddSentryBusterWhenDamageDealtExceeds 2500
    AddSentryBusterWhenKillCountExceeds 10

	AllowBotExtraSlots 1
	RobotLimit 25

    BodyPartScaleSpeed 10

    MissionUnloadOutput
	{
		Target BigNet
		Action RunScriptCode
		Param "
				Convars.SetValue(`tf_playergib`, 1)
			  "
		Delay -1
	}

    //// PRECACHES ////

	//// POINT TEMPLATES ////

	PointTemplates
	{
		CorePT
		{
			OnSpawnOutput
			{
				Target BigNet
				Action RunScriptCode
				Param "
						NetProps.SetPropString(Entities.FindByClassname(null, `tf_objective_resource`), `m_iszMvMPopfileName`, `(Expert) Causality Revolution`)

                        Convars.SetValue(`tf_playergib`, 0)

						IncludeScript(`tankextensions_main`)
						IncludeScript(`tankhealthbars`)

						TANKHEALTHBARS_BAR_SIZE = 0
					  "
			}
		}
    }

    //// SPAWNED POINT TEMPLATES ////

	SpawnTemplate "CorePT"

    //// ROBOT TEMPLATES ////

    Templates
    {
        T_TFBot_Giant_Heavy_Laser_Rocket
        {
            Name "Giant Blast-Laser Heavy"
            Class Heavy
            ClassIcon heavy_atomic_rocket_final_giant
            Skill Expert
            Health 5000
            Attributes MiniBoss
            WeaponRestrictions SecondaryOnly

            MaxVisionRange 1200

			AimOffset "0 0 40"

            Item "Corona Australis"

            CharacterAttributes
			{
                "move speed penalty" 0.5
                "damage force reduction" 0.3
                "airblast vulnerability multiplier" 0.3
                "override footstep sound set" 2
                "gesture speed increase" 1000
                "voice pitch scale" 0
			}

            ItemAttributes
            {
                ItemName "TF_WEAPON_SHOTGUN_HWG"

                "fire rate bonus" 0.3
                "mod max primary clip override" -1

                "proj attribute pattern" "override projectile type|13|energy weapon penetration|1&override projectile type|13|energy weapon penetration|1&override projectile type|13|energy weapon penetration|1&override projectile type|13|energy weapon penetration|1&damage bonus|12|override projectile type|2|mini rockets|1|projectile speed decreased|0.5"

                "particle color rgb" 57855
                "custom item model" "models/empty.mdl"
                "custom weapon fire sound" "=75|weapons/bison_main_shot_02.wav"
            }

            ItemAttributes
			{
                ItemName "TF_WEAPON_FISTS"
                "is_passive_weapon" 1
                "damage penalty" 0
			}

            ItemAttributes
            {
                ItemName "Corona Australis"
                "set item tint rgb" 57855
            }
        }
    }
    
    //// MISSION BOTS ////

    Mission // Sentry Buster
	{
		Objective DestroySentries
		Where spawnbot_mission_sentrybuster
		BeginAtWave 1
		RunForThisManyWaves 8
		InitialCooldown 25
		CooldownTime 25
		DesiredCount 1

		TFBot
		{
			Template T_TFBot_SentryBuster
		}
	}
	Mission // Sniper (Wave 2)
	{
		Objective Sniper
		Where spawnbot_mission_sniper
		BeginAtWave 2
		RunForThisManyWaves 1
		InitialCooldown 30
		CooldownTime 30
		DesiredCount 2

		TFBot
		{
			Template T_TFBot_Sniper
		}
	}
	Mission // Spy (Wave 3)
	{
		Objective Spy
		Where spawnbot_mission_spy
		BeginAtWave 3
		RunForThisManyWaves 1
		InitialCooldown 15
		CooldownTime 45
		DesiredCount 3

		TFBot
		{
			Template T_TFBot_Spy
		}
	}

    //// WAVES ////

    Wave
	{
		InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`robotpath_b_relay`, `Trigger`, null, 5.1)
                "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

        // Subwave 1
        WaveSpawn // 1 GBarrage Demo and 1 GBig-Heal Medic
        {
            Name "Wave1_Subwave1_GBarrageDemo"
			Where spawnbot_left
			TotalCount 2
			MaxActive 2
			SpawnCount 2
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 100

			Squad
			{
				TFBot
