			WaitBetweenSpawns 4
			TotalCurrency 20

			TFBot
			{
				Class Soldier
				Skill Easy
			}
		}
		WaveSpawn // 4 Heavies
		{
			Name "Wave1_Subwave2_Heavies2"
			WaitForAllSpawned "Wave1_Subwave2_GPyro2"
			Where spawnbot_random
			TotalCount 4
			MaxActive 2
			SpawnCount 1
			WaitBeforeStarting 2
			WaitBetweenSpawns 5
			TotalCurrency 30

			TFBot
			{
				Class Heavy
				Skill Expert
			}
		}

		WaveSpawn // 1 GPyro and 2 Charged Soldiers
		{
			Name "Wave1_Subwave2_GPyro3"
			WaitForAllSpawned "Wave1_Subwave2_GPyro2"
			Where spawnbot_right
			TotalCount 3
			MaxActive 3
			SpawnCount 3
			WaitBeforeStarting 18
			WaitBetweenSpawns 0
			TotalCurrency 40
			
			Squad
			{
				NoWaitForFormation 1 [$SIGSEGV]

				TFBot
				{
					Template T_TFBot_Giant_Pyro
				}
				TFBot
				{
					Template T_TFBot_Soldier_Crit
				}
				TFBot
				{
					Template T_TFBot_Soldier_Crit
				}
			}
		}
		WaveSpawn // 12 Soldiers
		{
			Name "Wave1_Subwave2_Soldiers3"
			WaitForAllSpawned "Wave1_Subwave2_GPyro3"
			Where spawnbot_random
			TotalCount 12
			MaxActive 7
			SpawnCount 4
			WaitBeforeStarting 2
			WaitBetweenSpawns 6
			TotalCurrency 20

			TFBot
			{
				Class Soldier
				Skill Easy
			}
		}
		WaveSpawn // 4 Heavies and 4 Full-Uber Medics
		{
			Name "Wave1_Subwave2_Heavies3"
			WaitForAllSpawned "Wave1_Subwave2_GPyro3"
			Where spawnbot_random
			TotalCount 8
			MaxActive 4
			SpawnCount 2
			WaitBeforeStarting 2
			WaitBetweenSpawns 5
			TotalCurrency 40

			Squad
			{
				TFBot
				{
					Class Heavy
					Skill Expert
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
			}
		}

		// Subwave 3
		WaveSpawn // 1 GBarrage Demo and 3 Full-Uber Medics
		{
			Name "Wave1_Subwave3_GBarrageDemo"
			WaitForAllSpawned "Wave1_Subwave2_GPyro3"
			Where spawnbot_right
			TotalCount 4
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 20
			WaitBetweenSpawns 0
			TotalCurrency 80

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Demoman_Barrage
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
			}
		}
		WaveSpawn // 12 Scouts
		{
			Name "Wave1_Subwave3_Scouts"
			WaitForAllSpawned "Wave1_Subwave1_GBarrageDemo"
			Where spawnbot_random
			TotalCount 12
			MaxActive 8
			SpawnCount 4
			WaitBeforeStarting 2
			WaitBetweenSpawns 4
			TotalCurrency 20

			TFBot
			{
				Class Scout
				Skill Easy
			}
		}
		WaveSpawn // 9 Charged Soldiers
		{
			Name "Wave1_Subwave3_Soldiers"
			WaitForAllSpawned "Wave1_Subwave3_GBarrageDemo"
			Where spawnbot_random
			TotalCount 9
			MaxActive 6
			SpawnCount 3
			WaitBeforeStarting 2
			WaitBetweenSpawns 5
			TotalCurrency 40

			TFBot
			{
				Template T_TFBot_Soldier_Crit
				Skill Expert
			}
		}

		WaveSpawn // 1 GBarrage Demo and 3 Full-Uber Medics
		{
			Name "Wave1_Subwave3_GBarrageDemo2"
			WaitForAllSpawned "Wave1_Subwave3_GBarrageDemo"
			Where spawnbot_right
			TotalCount 4
			MaxActive 4
			SpawnCount 4
			WaitBeforeStarting 20
			WaitBetweenSpawns 0
			TotalCurrency 80

			Squad
			{
				TFBot
				{
					Template T_TFBot_Giant_Demoman_Barrage
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
				TFBot
				{
					Template T_TFBot_Medic_Uber
				}
			}
		}
		WaveSpawn // 8 Scouts
		{
			Name "Wave1_Subwave3_Scouts2"
			WaitForAllSpawned "Wave1_Subwave1_GBarrageDemo2"
			Where spawnbot_random
			TotalCount 8
			MaxActive 8
			SpawnCount 4
			WaitBeforeStarting 2
			WaitBetweenSpawns 4
			TotalCurrency 20

			TFBot
			{
				Class Scout
				Skill Easy
			}
		}
		WaveSpawn // 6 Charged Soldiers
		{
			Name "Wave1_Subwave3_Soldiers"
			WaitForAllSpawned "Wave1_Subwave3_GBarrageDemo"
			Where spawnbot_random
			TotalCount 6
			MaxActive 6
			SpawnCount 3
			WaitBeforeStarting 2
