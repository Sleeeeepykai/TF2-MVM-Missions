    }
	Wave
	{
		InitWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`robotpath_d_relay`, `Trigger`, null, 5.1)
                "
        }
		StartWaveOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_start_relay`, `Trigger`)
                  "
        }
        DoneOutput
        {
            Target BigNet
            Action RunScriptCode
            Param "
                    EntFire(`wave_finished_relay`, `Trigger`)
                  "
        }

		// Subwave 1
		WaveSpawn // 1 Tank
		{
			Name "Wave2_Subwave1_Tank"
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 0
			WaitBetweenSpawns 0
			TotalCurrency 60

			Tank
			{
				Template Tank_Default
				Health 25000
				StartingPathTrackNode "tank_path_B"
			}
		}
		WaveSpawn
		{
			Name "Wave2_Subwave1_GDeflectorHeavy"
			WaitForAllSpawned "Wave2_Subwave1_Tank"
			Where spawnbot_random
			TotalCount 1
			MaxActive 1
			SpawnCount 1
			WaitBeforeStarting 5
			WaitBetweenSpawns 0
			TotalCurrency 40

			TF
		}
	}
}